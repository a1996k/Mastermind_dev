        <ComplexType Name="Billing_EventClientTimeAndMaterialCostsByItem_Result">
          <Property Type="Int32" Name="ClientId" Nullable="false" />
          <Property Type="String" Name="Client" Nullable="true" MaxLength="100" />
          <Property Type="Int32" Name="JobId" Nullable="false" />
          <Property Type="String" Name="JobNumber" Nullable="true" />
          <Property Type="Int32" Name="JobItemId" Nullable="false" />
          <Property Type="Int32" Name="ItemNumber" Nullable="true" />
          <Property Type="String" Name="ItemDescription" Nullable="true" MaxLength="250" />
          <Property Type="Decimal" Name="QuotedTimeHours" Nullable="true" Precision="19" Scale="2" />
          <Property Type="Decimal" Name="QuotedLaborCost" Nullable="true" Precision="19" Scale="2" />
          <Property Type="Decimal" Name="QuotedMaterialCost" Nullable="true" Precision="19" Scale="2" />
          <Property Type="Decimal" Name="ActualTimeHours" Nullable="true" Precision="19" Scale="2" />
          <Property Type="Decimal" Name="ActualLaborCost" Nullable="true" Precision="19" Scale="2" />
          <Property Type="Decimal" Name="ActualMaterialCost" Nullable="true" Precision="19" Scale="2" />
          <Property Type="Decimal" Name="TotalPrice" Nullable="true" Precision="19" Scale="2" />
        </ComplexType>
        <ComplexType Name="Billing_FreightCost_Result">
          <Property Type="Decimal" Name="TotalFreightCost" Nullable="true" Precision="19" Scale="4" />
          <Property Type="Decimal" Name="TotalFreightPrice" Nullable="true" Precision="19" Scale="4" />
          <Property Type="String" Name="Client" Nullable="true" MaxLength="100" />
          <Property Type="Int32" Name="ClientId" Nullable="false" />
        </ComplexType>
        <ComplexType Name="Billing_FreightCostByItem_Result">
