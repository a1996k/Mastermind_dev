@model FifthPress.ClientLogin

@{
    ViewBag.Title = "Edit Client Login";
}

<link href="https://cdn.jsdelivr.net/npm/select2@4.0.13/dist/css/select2.min.css" rel="stylesheet" />

<div class="container mt-4">
    <div class="row">
        <div class="col-md-8 offset-md-2">
            <div class="card">
                <div class="card-header">
                    <h3>Edit Client Login</h3>
                </div>
                <div class="card-body">
                    <form id="clientLoginForm" data-mode="edit" data-id="@Model.Id">
                        @Html.AntiForgeryToken()

                        <div class="mb-3">
                            <label for="login-name" class="form-label">Name (Optional)</label>
                            <input type="text" class="form-control" id="login-name" name="name" placeholder="Friendly name for this login account" value="@Model.Name">
                            <small class="form-text text-muted">Optional: A descriptive name for this login (e.g., "Smith Family Account")</small>
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Email Addresses</label>
                            <div id="emails-container">
                                @foreach (var email in Model.ClientLoginEmails.Where(e => e.Deleted == null))
                                {
                                    <script>
                                        // Use jQuery to add email entries after page loads
                                        $(document).ready(function() {
                                            ClientLoginForm.addEmailEntry('@email.Email', @email.IsPrimary.ToString().ToLower());
                                        });
                                    </script>
                                }
                            </div>
                            <button type="button" class="btn btn-sm btn-secondary mt-2" id="add-email-btn">
                                + Add Email
                            </button>
                            <small class="form-text text-muted">Add one or more email addresses for this login</small>
                        </div>

                        <div class="mb-3">
                            <label for="client-select" class="form-label">Select Clients (Events)</label>
                            <select class="form-control" id="client-select" name="clientIds" multiple="multiple" style="width: 100%;">
                                @foreach (var pivot in Model.ClientLoginPivots.Where(p => p.Deleted == null))
                                {
                                    <option value="@pivot.ClientId" selected>@pivot.Client.Title</option>
                                }
                            </select>
                            <small class="form-text text-muted">Select one or more clients/events to associate with this login. Start typing to search (minimum 3 characters)</small>
                        </div>

                        <div class="alert alert-danger" id="error-message" style="display: none;"></div>
                        <div class="alert alert-success" id="success-message" style="display: none;"></div>

                        <div class="d-flex justify-content-between">
                            <a href="@Url.Action("Index", "ClientLogin")" class="btn btn-secondary">Cancel</a>
                            <button type="submit" class="btn btn-primary" id="submit-btn">Update Client Login</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/select2@4.0.13/dist/js/select2.min.js"></script>
@Scripts.Render("~/bundles/clientlogin")
