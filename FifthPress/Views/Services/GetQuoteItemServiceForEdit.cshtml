@using FifthPress.Models.ViewModels;
@model VM_QuoteItemService

<form method="post" action="quote-service-item/save" enctype="multipart/form-data" data-item-type="Service" id="qis_configure_form">
    @Html.HiddenFor(model => model.QuoteItemService.Id)
    @Html.LabelFor(model => model.QuoteItemService.Service.Title)
    @Html.HiddenFor(model => model.QuoteItemService.QuoteItemId)
    @Html.HiddenFor(model => model.QuoteItemService.OriginalService)
    @Html.HiddenFor(model => model.QuoteItemService.Ordinal)
    @Html.HiddenFor(model => model.QuoteItemService.Operator)
    @Html.HiddenFor(model => model.QuoteItemService.Deleted)
    @Html.HiddenFor(model => model.QuoteItemService.ApexOrdinal)
    @Html.HiddenFor(model => model.QuoteItemService.IsCuttingService)
    @Html.HiddenFor(model => model.QuoteItemService.UserTimeOverride)
    <script type="text/javascript">
        var timingParamsJson = @Html.Raw(string.IsNullOrEmpty(Model.TimingParametersJson) ? "null" : Model.TimingParametersJson);
    </script>

    <div class="d-flex flex-row flex-wrap justify-content-between">
        <div class="field-binder-flexxy justify-content-lg-start">
            @Html.LabelFor(model => model.QuoteItemService.Notes)
            @Html.TextAreaFor(model => model.QuoteItemService.Notes)
        </div>
        <div class="field-binder-flexxy justify-content-lg-start">
            @Html.LabelFor(model => model.QuoteItemService.Caliper)
            @Html.EditorFor(model => model.QuoteItemService.Caliper, new { htmlAttributes = new { @data_changed = false } })
        </div>
        <div class="field-binder-flexxy justify-content-lg-start">
            @Html.LabelFor(model => model.QuoteItemService.MakeReady)
            @Html.EditorFor(model => model.QuoteItemService.MakeReady, new { htmlAttributes = new { @data_changed = false } })
        </div>
        <div class="field-binder-flexxy justify-content-lg-start">
            @Html.LabelFor(model => model.QuoteItemService.WashUp)
            @Html.EditorFor(model => model.QuoteItemService.WashUp, new { htmlAttributes = new { @data_changed = false } })
        </div>
        <div class="field-binder-flexxy justify-content-lg-start">
            @Html.LabelFor(model => model.QuoteItemService.HourlyRate)
            @Html.EditorFor(model => model.QuoteItemService.HourlyRate, new { htmlAttributes = new { @data_changed = false } })
        </div>
        <div class="field-binder-flexxy justify-content-lg-start">
            @Html.LabelFor(model => model.QuoteItemService.MaterialCost)
            @Html.EditorFor(model => model.QuoteItemService.MaterialCost)
        </div>
        <div class="field-binder-flexxy justify-content-lg-start">
            @Html.EditorFor(model => model.ServiceTimeEditor)
        </div>
        <div class="field-binder-flexxy justify-content-lg-start">
            @Html.LabelFor(model => model.QuoteItemService.ScrapAmount)
            @Html.EditorFor(model => model.QuoteItemService.ScrapAmount)
        </div>
        <div class="field-binder-flexxy justify-content-lg-start">
            @Html.LabelFor(model => model.QuoteItemService.ScrapPercent)
            @Html.EditorFor(model => model.QuoteItemService.ScrapPercent)
        </div>
    </div>

    @if (!string.IsNullOrEmpty(Model.TimingParametersJson))
    {
        <div class="timing-parameters-section mt-3">
            <div class="fs-5 mb-2">
                <i class="fa-light fa-bomb view-parameters" id="vp"></i>
                <label>Timing Parameters</label>
            </div>
            <div class="d-flex flex-row flex-wrap justify-content-between" id="inline_timing_params">
            </div>
        </div>
    }

    <input type="submit" value="Save" data-modal-to-close="#edit_service_modal" />
    <button type="button" data-modal-to-close="#edit_service_modal">Cancel</button>
</form>