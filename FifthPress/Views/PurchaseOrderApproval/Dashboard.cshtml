@model IEnumerable<PO_Orders25>

<h2>Pending Purchase Orders</h2>
<table class="table">
    <thead>
        <tr>
            <th>PO #</th>
            <th>Client</th>
            <th>Department</th>
            <th>Date Submitted</th>
            <th>Status</th>
            <th>Amount</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var po in Model)
        {
            <tr>
                <td>@po.PO_OrderId</td>
                <td>@po.ClientId</td>
                <td>@po.DepartmentId</td>
                <td>@po.DateSubmitted.ToShortDateString()</td>
                <td>@po.Status</td>
                <td>
                    @po.PO_LineItems.Sum(li => li.Cost * li.Quantity).ToString("C")
                </td>
                <td>
                    @Html.ActionLink("Review", "Review", new { id = po.PO_OrderId }, new { @class = "btn btn-primary btn-sm" })
                </td>
            </tr>
        }
    </tbody>
</table>