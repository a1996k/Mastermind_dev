@using FifthPress.Models.ViewModels;
@model VM_TimeSheetReport

@Styles.Render("~/Content/css")
@Styles.Render("~/Content/globalcss")
@Scripts.Render("~/bundles/modernizr")
@Scripts.Render("~/bundles/jquery")
@Scripts.Render("~/bundles/jqueryuijs")
@Scripts.Render("~/bundles/bootstrap")
@Styles.Render("~/Content/jqueryuicss")
@Scripts.Render("~/bundles/validator")

<table id="result_table" class="table table-striped table-bordered">
    <thead class="fs-4">
        <tr>
            <th>Employee</th>
            <th>Time In</th>
            <th>Time Out</th>
            <th>Day Span</th>
            <th>Break Time</th>
            <th>Worked Time</th>
        </tr>
    </thead>
    <tbody class="fs-4">
        @foreach (var employeeTimeSheet in Model.EmployeeTimeSheets)
        {
            <!-- Employee header row -->
            <tr>
                <th>@Html.DisplayFor(modelItem => employeeTimeSheet.Employee)</th>
                <!-- Empty cells to align columns -->
                <td></td>
                <td></td>
                <td></td>
                <td></td>
                <td></td>
            </tr>

            <!-- Employee records -->
            foreach (var record in employeeTimeSheet.Records)
            {
                <tr>
                    <td>@record.TimeIn.ToString("MM/d/yyyy")</td>
                    <td>@record.TimeIn.ToLocalTime().ToString("HH:mm")</td>
                    <td>@(record.TimeOut.HasValue ? record.TimeOut.Value.ToLocalTime().ToString("HH:mm") : "")</td>
                    <td>@Html.DisplayFor(modelItem => record.DaySpanFormatted)</td>
                    <td>@Html.DisplayFor(modelItem => record.BreakTimeFormatted)</td>
                    <td>@Html.DisplayFor(modelItem => record.WorkTimeFormatted)</td>
                </tr>
            }

            <!-- Totals for the employee -->
            <tr>
                <th>Totals:</th>
                <td></td>
                <td></td>
                <td><strong>@employeeTimeSheet.TotalHoursWorkedFormatted</strong></td>
                <td><strong>@employeeTimeSheet.TotalBreakTimeFormatted</strong></td>
                <td><strong>@employeeTimeSheet.TotalNetWorkTimeFormatted</strong></td>
            </tr>

            <!-- Spacing row (optional; can be omitted if not desired) -->
            <tr><td colspan="6" class="py-3"></td></tr>
        }
    </tbody>
    <tfoot class="fs-4">
        <tr>
            <th>Report Totals:</th>
            <td><strong>Total Hours Worked:</strong> @Model.ReportTotalHoursWorked</td>
            <td><strong>Total Net Work Time:</strong> @Model.ReportTotalNetWorkTime</td>
            <td><strong>Total Break Time:</strong> @Model.ReportTotalBreakTime</td>
            <td></td>
            <td></td>
        </tr>
    </tfoot>
</table>

<script>
    $(function () {
        let resultsTable = $('#result_table').DataTable();
    });
</script>