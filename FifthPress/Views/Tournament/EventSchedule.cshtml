@model FifthPress.Models.ViewModels.Tournament.VM_EventSchedule
@{
    ViewBag.Title = "Event Scheduler";
}

@Styles.Render("~/Content/eventschedule")
<link href="https://cdn.jsdelivr.net/npm/select2@4.0.13/dist/css/select2.min.css" rel="stylesheet" />

<div class="toolbar">
    <h1>&#128202; Event Scheduler (<span id="current-year-display">@Model.CurrentYear</span>)</h1>

    <div class="toolbar-group">
        <button id="clear-btn" class="btn btn-outline-secondary btn-sm" title="Clear Selection">
            <i class="bi bi-eraser"></i> Clear
        </button>
    </div>

    <div class="toolbar-group">
        @if (Model.IsAdmin)
        {
            <button id="manage-tournaments" class="btn btn-primary btn-sm" title="Manage Tournaments">
                &#127942; Manage Tournaments
            </button>
            <button id="add-user-btn" class="btn btn-success btn-sm" title="Add User">
                &#128100; Add User
            </button>
            <button id="check-availability-btn" class="btn btn-info btn-sm" title="Check Availability">
                &#128197; Check Availability
            </button>
        }
        <button id="tournament-filter-btn" class="btn btn-outline-info btn-sm btn-filter" title="Filter Tournaments">
            &#128269; Filter: All Tournaments
        </button>
        <button id="assigned-users-toggle" class="btn btn-outline-secondary btn-sm btn-filter" title="Show only assigned users">
            &#128101; Assigned Only
        </button>
        <button id="report-btn" class="btn btn-outline-warning btn-sm" title="Generate Report">
            &#128202; Report
        </button>
        @*<button id="export-excel-btn" class="btn btn-outline-success btn-sm" title="Export to Excel">
            &#128196; Export Excel
        </button>*@
    </div>

    <div class="toolbar-group">
        <select id="year-selector" class="form-select form-select-sm" title="Select Year" style="width: auto;"></select>
        <button id="today-btn" class="btn btn-outline-success btn-sm" title="Go to Today">&#128205; Today</button>
    </div>

    <span id="selected-cell-count" class="toolbar-cell-count"></span>
</div>

<div class="spreadsheet-container">
    <div class="spreadsheet" id="spreadsheet"></div>
</div>

@*<div class="status-bar">
    <div class="status-bar-left"></div>
    <div class="status-bar-right">
        <span id="selected-cell-count"></span>
    </div>
</div>*@

<div class="context-menu" id="context-menu">
    <div class="context-menu-item" data-action="assign">
        <i class="bi bi-person-plus"></i> Assign to Tournament
    </div>
    <div class="context-menu-item" data-action="clear">
        <i class="bi bi-x-circle"></i> Clear Assignment
    </div>
    <div class="context-menu-separator"></div>
    <div class="context-menu-item" data-action="travel">
        <i class="bi bi-airplane"></i> Mark as Travel Day
    </div>
    <div class="context-menu-item" data-action="not-working">
        <i class="bi bi-dash-circle"></i> Mark Not Working
    </div>
    <div class="context-menu-separator" id="role-separator"></div>
    <div id="dynamic-roles-container">
        <!-- Tournament roles will be loaded dynamically here -->
    </div>
    <div class="context-menu-item" data-action="role-unassigned">
        <i class="bi bi-person-x"></i> Unassigned
    </div>
    <div class="context-menu-separator"></div>
    <div class="context-menu-item" data-action="change-rate-type">
        <i class="bi bi-currency-dollar"></i> Change Rate Type
    </div>
    <div class="context-menu-separator"></div>
    <div class="context-menu-item" data-action="set-clock-times">
        <i class="bi bi-clock"></i> Set Clock-In/Clock-Out Times
    </div>
    <div class="context-menu-separator"></div>
    <div class="context-menu-item" data-action="copy">
        <i class="bi bi-clipboard"></i> Copy
    </div>
    <div class="context-menu-item" data-action="paste">
        <i class="bi bi-clipboard-check"></i> Paste
    </div>
</div>

<div class="loading" id="loading" style="display: none;">
    <div class="d-flex justify-content-center align-items-center" style="height: 200px;">
        <div class="text-center">
            <div class="spinner-border text-primary mb-3" role="status">
                <span class="visually-hidden">Loading...</span>
            </div>
            <div class="text-muted">Loading schedule data...</div>
        </div>
    </div>
</div>

<!-- Error Alert Container -->
<div id="error-container" style="display: none;">
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <i class="bi bi-exclamation-triangle-fill"></i>
        <strong>Error:</strong> <span id="error-message"></span>
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
</div>

<!-- Success Alert Container -->
<div id="success-container" style="display: none;">
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <i class="bi bi-check-circle-fill"></i>
        <span id="success-message"></span>
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
</div>
<!-- Bootstrap Tournaments Management Modal -->
<div class="modal fade"
     id="tournamentsModal"
     tabindex="-1"
     aria-labelledby="tournamentsModalLabel"
     aria-hidden="true">
    <div class="modal-dialog modal-xl">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="tournamentsModalLabel">
                    Tournaments for <span id="tournaments-year"></span>
                </h5>
                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="modal"
                        aria-label="Close"></button>
            </div>
            <div class="modal-body" style="max-height: 70vh; overflow-y: auto;">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h6 class="mb-0">Current Tournaments</h6>
                    <button type="button"
                            class="btn btn-primary btn-sm"
                            id="add-new-tournament">
                        <i class="bi bi-plus"></i> Add New Tournament
                    </button>
                </div>

                <div id="tournaments-list">
                    <div class="text-center text-muted py-4" id="no-tournaments">
                        <div class="mb-2">&#127942;</div>
                        <div>No tournaments added yet</div>
                        <small>Click "Add New Tournament" to get started</small>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Bootstrap Tournament Add/Edit Modal -->
<div class="modal fade"
     id="tournamentFormModal"
     tabindex="-1"
     aria-labelledby="tournamentFormModalLabel"
     aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="tournamentFormModalLabel">
                    Add Tournament
                </h5>
                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="modal"
                        aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <form id="tournament-form">
                    <div class="mb-3">
                        <label for="tournament-name" class="form-label">Tournament Name:</label>
                        <input type="text"
                               class="form-control"
                               id="tournament-name"
                               required />
                    </div>
                    <div class="mb-3">
                        <label for="tournament-location" class="form-label">Location:</label>
                        <input type="text"
                               class="form-control"
                               id="tournament-location"
                               required />
                    </div>

                    <div class="mb-3">
                        <label for="tournament-client" class="form-label">
                            Client <span class="text-danger">*</span>
                        </label>
                        <select id="tournament-client" class="form-select" required>
                            <option value="">-- Select Client --</option>
                        </select>
                    </div>

                    <div class="mb-3">
                        <label for="minimum-wage" class="form-label">Minimum Wage:</label>
                        <input type="number"
                               class="form-control"
                               id="minimum-wage"
                               step="0.01"
                               min="0"
                               placeholder="Enter minimum wage amount" />
                    </div>
                    <div class="mb-3">
                        <label for="per-diem" class="form-label">Per Diem:</label>
                        <input type="number"
                               class="form-control"
                               id="per-diem"
                               step="0.01"
                               min="0"
                               placeholder="Enter per diem amount" />
                    </div>
                    <div class="mb-3">
                        <label for="travel-per-diem" class="form-label">Travel Per Diem:</label>
                        <input type="number"
                               class="form-control"
                               id="travel-per-diem"
                               step="0.01"
                               min="0"
                               placeholder="Enter travel per diem amount" />
                    </div>
                    <div class="mb-3">
                        <label for="bill-rate" class="form-label">Bill Rate (General):</label>
                        <input type="number"
                               class="form-control"
                               id="bill-rate"
                               step="0.01"
                               min="0"
                               placeholder="Enter general bill rate" />
                    </div>
                    <div class="mb-3">
                        <label for="manager-bill-rate" class="form-label">Manager Bill Rate:</label>
                        <input type="number"
                               class="form-control"
                               id="manager-bill-rate"
                               step="0.01"
                               min="0"
                               placeholder="Enter manager bill rate" />
                    </div>
                    <div class="mb-3">
                        <label for="print-bill-rate" class="form-label">Print Bill Rate:</label>
                        <input type="number"
                               class="form-control"
                               id="print-bill-rate"
                               step="0.01"
                               min="0"
                               placeholder="Enter print bill rate" />
                    </div>
                    <div class="mb-3">
                        <label for="ot-calculation" class="form-label">OT Calculation Basis:</label>
                        <select class="form-select" id="ot-calculation">
                            <option value="">Select calculation basis</option>
                            <option value="daily">Daily</option>
                            <option value="weekly">Weekly</option>
                        </select>
                    </div>

                    <div class="mb-3">
                        <label for="tournament-start" class="form-label">Tournament Start Date:</label>
                        <input type="date"
                               class="form-control"
                               id="tournament-start"
                               required />
                    </div>
                    <div class="mb-3">
                        <label for="tournament-end" class="form-label">Tournament End Date:</label>
                        <input type="date"
                               class="form-control"
                               id="tournament-end"
                               required />
                    </div>

                    <hr class="my-4">
                    <h6 class="mb-3">Phase Dates <small class="text-muted">(Auto-calculated, but editable)</small></h6>

                    <div class="row">
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label for="setup-start" class="form-label">Setup Start:</label>
                                <input type="date" class="form-control" id="setup-start">
                                <div class="form-text">21 days before tournament</div>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label for="setup-end" class="form-label">Setup End:</label>
                                <input type="date" class="form-control" id="setup-end">
                                <div class="form-text">Day before Advanced Week</div>
                            </div>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label for="advanced-start" class="form-label">Advanced Week Start:</label>
                                <input type="date" class="form-control" id="advanced-start">
                                <div class="form-text">7 days before tournament</div>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label for="advanced-end" class="form-label">Advanced Week End:</label>
                                <input type="date" class="form-control" id="advanced-end">
                                <div class="form-text">Day before tournament</div>
                            </div>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label for="teardown-start" class="form-label">Teardown Start:</label>
                                <input type="date" class="form-control" id="teardown-start">
                                <div class="form-text">Day after tournament</div>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label for="teardown-end" class="form-label">Teardown End:</label>
                                <input type="date" class="form-control" id="teardown-end">
                                <div class="form-text">6 days after tournament</div>
                            </div>
                        </div>
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button"
                        class="btn btn-secondary"
                        data-bs-dismiss="modal">
                    Cancel
                </button>
                <button type="submit"
                        class="btn btn-primary"
                        id="save-tournament"
                        form="tournament-form">
                    Save Tournament
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Tournament Selection Modal for Overlapping Tournaments -->
<div class="modal fade"
     id="tournamentSelectionModal"
     tabindex="-1"
     aria-labelledby="tournamentSelectionModalLabel"
     aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="tournamentSelectionModalLabel">
                    <i class="bi bi-trophy"></i> Select Tournament
                </h5>
                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="modal"
                        aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <p class="text-muted small mb-3">
                    <i class="bi bi-info-circle"></i>
                    Multiple tournaments are available on this date. Please select which tournament to assign to:
                </p>
                <div id="tournament-selection-list">
                    <!-- Tournament options will be populated here -->
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Tournament and Role Selection Modals are created dynamically by JavaScript -->
<!-- Tournament Filter Modal -->
<div class="modal fade"
     id="tournamentFilterModal"
     tabindex="-1"
     aria-labelledby="tournamentFilterModalLabel"
     aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="tournamentFilterModalLabel">
                    <i class="bi bi-funnel"></i> Filter Tournaments
                </h5>
                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="modal"
                        aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <p class="text-muted small mb-3">
                    <i class="bi bi-info-circle"></i>
                    Select which tournaments to display in the schedule. Only dates for selected tournaments will be shown.
                </p>
                <div class="mb-3">
                    <button type="button" class="btn btn-sm btn-outline-primary me-2" id="select-all-tournaments">
                        <i class="bi bi-check-all"></i> Select All
                    </button>
                    <button type="button" class="btn btn-sm btn-outline-secondary" id="deselect-all-tournaments">
                        <i class="bi bi-x"></i> Deselect All
                    </button>
                </div>
                <div id="tournament-filter-list" class="max-height-300 overflow-auto">
                    <!-- Tournament checkboxes will be populated here -->
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                    <i class="bi bi-x-lg"></i> Cancel
                </button>
                <button type="button" class="btn btn-primary" id="apply-tournament-filter">
                    <i class="bi bi-check-lg"></i> Apply Filter
                </button>
            </div>
        </div>
    </div>
</div>


<!-- Clock Times Entry Modal -->
<div class="modal fade" id="clock-times-modal" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Set Clock-In/Clock-Out Times</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div class="mb-3">
                    <h6 id="selected-tournament-info"></h6>
                    <small class="text-muted" id="affected-dates-info"></small>
                </div>

                <!-- Bulk Time Setting -->
                <div class="row mb-3">
                    <div class="col-md-6">
                        <label class="form-label">Bulk Clock-In Time:</label>
                        <input type="time" class="form-control" id="bulk-clock-in">
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Bulk Clock-Out Time:</label>
                        <input type="time" class="form-control" id="bulk-clock-out">
                    </div>
                </div>
                <div class="mb-3">
                    <button type="button" class="btn btn-outline-primary btn-sm" id="apply-bulk-times">
                        Apply to All Selected
                    </button>
                </div>

                <hr>

                <!-- Individual Staff Time Entries -->
                <div class="mb-3">
                    <div class="form-check">
                        <input class="form-check-input" type="checkbox" id="select-all-staff">
                        <label class="form-check-label" for="select-all-staff">
                            <strong>Select All Staff</strong>
                        </label>
                    </div>
                </div>

                <div id="staff-time-entries" style="max-height: 400px; overflow-y: auto;">
                    <!-- Staff time entries will be populated here -->
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-primary" id="save-clock-times">Save Times</button>
            </div>
        </div>
    </div>
</div>

<!-- Daily/Salary Rate Modal -->
<div class="modal fade" id="rate-type-modal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Assignment Rate Type</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <p class="mb-3">How should this assignment be paid?</p>

                <div class="mb-3">
                    <div class="form-check mb-3 p-3 border rounded" style="cursor: pointer; transition: background-color 0.2s;">
                        <label class="form-check-label w-100" for="salary-rate" style="cursor: pointer;">
                            <div class="d-flex align-items-center">
                                <input class="form-check-input me-3" type="radio" name="rateType" id="salary-rate" value="salary" checked>
                                <div class="me-3">
                                    <i class="bi bi-building text-primary" style="font-size: 1.2em;"></i>
                                </div>
                                <div>
                                    <div class="fw-bold text-dark">Salary</div>
                                    <small class="text-muted">Fixed salary payment</small>
                                </div>
                            </div>
                        </label>
                    </div>
                    <div class="form-check mb-3 p-3 border rounded" style="cursor: pointer; transition: background-color 0.2s;">
                        <label class="form-check-label w-100" for="daily-rate" style="cursor: pointer;">
                            <div class="d-flex align-items-center">
                                <input class="form-check-input me-3" type="radio" name="rateType" id="daily-rate" value="daily">
                                <div class="me-3">
                                    <i class="bi bi-calendar-day text-success" style="font-size: 1.2em;"></i>
                                </div>
                                <div>
                                    <div class="fw-bold text-dark">Daily Rate</div>
                                    <small class="text-muted">Per day payment</small>
                                </div>
                            </div>
                        </label>
                    </div>
                </div>

                <div id="daily-rate-input" class="mb-3" style="display: none;">
                    <label for="daily-rate-amount" class="form-label">Daily Rate Amount:</label>
                    <div class="input-group">
                        <span class="input-group-text">$</span>
                        <input type="number" class="form-control" id="daily-rate-amount" step="0.01" min="0" placeholder="0.00">
                    </div>
                </div>

                <div class="mb-3">
                    <label for="assignment-role" class="form-label">Role:</label>
                    <select class="form-select" id="assignment-role">
                        <option value="Unassigned">Unassigned</option>
                    </select>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-primary" id="confirm-rate-type">Confirm Assignment</button>
            </div>
        </div>
    </div>
</div>

<!-- Absence Type Selection Modal -->
<div class="modal fade" id="absence-type-modal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Select Absence Type</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <p class="mb-3">Why is this person not working?</p>

                <!-- Tournament Selection (shown when multiple tournaments available) -->
                <div id="absence-tournament-selection" class="mb-3" style="display: none;">
                    <label for="absence-tournament" class="form-label">Tournament:</label>
                    <select class="form-select" id="absence-tournament">
                        <option value="">Select Tournament</option>
                    </select>
                </div>

                <!-- Absence Type Radio Buttons -->
                <div class="mb-3">
                    <div class="form-check mb-3 p-3 border rounded" style="cursor: pointer;">
                        <label class="form-check-label w-100" for="absence-sick" style="cursor: pointer;">
                            <div class="d-flex align-items-center">
                                <input class="form-check-input me-3" type="radio" name="absenceType" id="absence-sick" value="3" checked>
                                <div class="me-3">
                                    <i class="bi bi-thermometer-half text-danger" style="font-size: 1.2em;"></i>
                                </div>
                                <div>
                                    <div class="fw-bold text-dark">Sick</div>
                                    <small class="text-muted">Client pays labor per diem only</small>
                                </div>
                            </div>
                        </label>
                    </div>

                    <div class="form-check mb-3 p-3 border rounded" style="cursor: pointer;">
                        <label class="form-check-label w-100" for="absence-timeoff-offsite" style="cursor: pointer;">
                            <div class="d-flex align-items-center">
                                <input class="form-check-input me-3" type="radio" name="absenceType" id="absence-timeoff-offsite" value="4">
                                <div class="me-3">
                                    <i class="bi bi-airplane text-primary" style="font-size: 1.2em;"></i>
                                </div>
                                <div>
                                    <div class="fw-bold text-dark">Time Off - Offsite</div>
                                    <small class="text-muted">No client billing, no per diem</small>
                                </div>
                            </div>
                        </label>
                    </div>

                    <div class="form-check mb-3 p-3 border rounded" style="cursor: pointer;">
                        <label class="form-check-label w-100" for="absence-timeoff-onsite" style="cursor: pointer;">
                            <div class="d-flex align-items-center">
                                <input class="form-check-input me-3" type="radio" name="absenceType" id="absence-timeoff-onsite" value="5">
                                <div class="me-3">
                                    <i class="bi bi-house text-success" style="font-size: 1.2em;"></i>
                                </div>
                                <div>
                                    <div class="fw-bold text-dark">Time Off - Onsite</div>
                                    <small class="text-muted">No client billing, no per diem</small>
                                </div>
                            </div>
                        </label>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-primary" id="confirm-absence-type">Confirm</button>
            </div>
        </div>
    </div>
</div>

<!-- Travel Day Selection Modal -->
<div class="modal fade" id="travel-modal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Configure Travel Day</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <p class="mb-3">Select your travel route:</p>

                <div class="mb-3">
                    <label for="travel-from" class="form-label">Traveling From:</label>
                    <select class="form-select" id="travel-from">
                        <option value="">Select starting location</option>
