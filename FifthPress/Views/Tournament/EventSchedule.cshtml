<script src="https://cdn.jsdelivr.net/npm/select2@4.0.13/dist/js/select2.min.js"></script>
@Scripts.Render("~/bundles/eventschedule")

<script type="text/javascript">
    // Pass server-side data to JavaScript
    window.EventStaffData = @Html.Raw(Json.Encode(Model.EventStaff));
    window.TournamentsData = @Html.Raw(Json.Encode(Model.Tournaments));
    window.CurrentYear = @Model.CurrentYear;
    window.IsAdmin = @Json.Encode(Model.IsAdmin);

    // Global variable to store tournament roles
    window.TournamentRoles = [];

    // Utility functions for UI feedback
    window.showSuccess = function(message) {
        $('#success-message').text(message);
        $('#success-container').show();
        setTimeout(() => $('#success-container').fadeOut(), 3000);
    };

    window.showError = function(message) {
        $('#error-message').text(message);
        $('#error-container').show();
    };

    window.showLoading = function() {
        $('#loading').show();
    };

    window.hideLoading = function() {
        $('#loading').hide();
    };

    // Function to load tournament roles from the backend
    window.loadTournamentRoles = async function() {
        try {
            const response = await fetch(ProcessUrl('Tournament/GetAvailableTournamentRoles'));
            if (response.ok) {
                const data = await response.json();

                // Check if this is an error response
                if (data.success === false) {
                    window.TournamentRoles = [];
                    return;
                }

                // If data is an array, use it directly; otherwise it might be wrapped
                window.TournamentRoles = Array.isArray(data) ? data : (data.roles || []);
                updateRoleContextMenu();
            } else {
                window.TournamentRoles = [];
            }
        } catch (error) {
            window.TournamentRoles = [];
        }
    };

    // Function to update the context menu with dynamic roles
    window.updateRoleContextMenu = function() {
        const container = $('#dynamic-roles-container');
        container.empty();

        window.TournamentRoles.forEach(role => {
            const roleItem = $(`
                <div class="context-menu-item" data-action="role-${role.Id}" data-role-id="${role.Id}" data-role-name="${role.Title}" data-role-rate="${role.DailyRate}">
                    <i class="bi bi-person-badge"></i> ${role.Title} ($${role.DailyRate}/day)
                </div>
            `);

            // Add click handler for the dynamic role
            roleItem.on('click', function() {
                const roleId = $(this).data('role-id');
                const roleName = $(this).data('role-name');
                const roleRate = $(this).data('role-rate');

                // Hide context menu
                $('#context-menu').hide();

                // Trigger role assignment with the selected role
                if (window.spreadsheetApp && window.spreadsheetApp.selectedCell) {
                    window.spreadsheetApp.assignRoleToSelectedCell(roleId, roleName, roleRate);
                }
            });

            container.append(roleItem);
        });
    };

    // Function to show/hide role options based on cell content
    window.updateContextMenuForCell = function(cellElement) {
        const $cell = $(cellElement);
        const cellId = $cell.data('cell');
        const hasAssignment = $cell.hasClass('assigned') || $cell.text().trim() !== '';

        // Show/hide role options based on whether cell has an assignment
        $('#dynamic-roles-container .context-menu-item').toggle(hasAssignment);
        $('.context-menu-item[data-action="role-unassigned"]').toggle(hasAssignment);

        // Also show/hide the separator before role options if needed
        $('#role-separator').toggle(hasAssignment);
    };

    // Check Staff Availability Functions
    window.openCheckAvailabilityModal = function() {
        // Set default date range (current year start to end)
        const today = new Date();
        const startOfYear = new Date(today.getFullYear(), 0, 1);
        const endOfYear = new Date(today.getFullYear(), 11, 31);

        $('#availability-start-date').val(startOfYear.toISOString().split('T')[0]);
        $('#availability-end-date').val(endOfYear.toISOString().split('T')[0]);

        // Reset results
        $('#availability-results').hide();
        $('#availability-no-results').hide();
        $('#availability-error').hide();

        // Show modal
        const modal = new bootstrap.Modal(document.getElementById('checkAvailabilityModal'));
        modal.show();
    };

    window.checkStaffAvailability = async function() {
        const startDate = $('#availability-start-date').val();
        const endDate = $('#availability-end-date').val();

        if (!startDate || !endDate) {
            $('#availability-error-message').text('Please select both start and end dates.');
            $('#availability-error').show();
            return;
        }

        // Hide previous results/errors
        $('#availability-results').hide();
        $('#availability-no-results').hide();
        $('#availability-error').hide();
        $('#availability-loading').show();

        try {
            const url = ProcessUrl(`Tournament/CheckStaffAvailability?startDate=${startDate}&endDate=${endDate}`);
            const response = await fetch(url);
            const data = await response.json();

            $('#availability-loading').hide();

            if (!data.success) {
                $('#availability-error-message').text(data.message || 'An error occurred while checking availability.');
                $('#availability-error').show();
                return;
            }

            // Check if we have results
            if (!data.tournamentDates || data.tournamentDates.length === 0) {
                $('#availability-no-results').show();
                return;
            }

            // Display results
            $('#active-tournaments-list').text(data.activeTournaments.join(', ') || 'None');
            $('#total-tournament-dates').text(data.totalDatesWithTournaments || 0);

            // Build day-by-day results
            const container = $('#availability-dates-container');
            container.empty();

            data.tournamentDates.forEach(dateInfo => {
                const dateCard = $(`
                    <div class="availability-date-card">
                        <div class="availability-date-header">
                            <div class="availability-date-title">
                                <i class="bi bi-calendar-date"></i> ${formatDate(dateInfo.Date)}
                            </div>
                            <div class="availability-count-badge">
                                ${dateInfo.AvailableCount} Available
                            </div>
                        </div>
                        <div class="availability-staff-list">
                            ${dateInfo.AvailableCount > 0 ?
                                `<ul class="staff-list-items">
                                    ${dateInfo.AvailableStaff.map(staff => `
                                        <li class="staff-list-item">
                                            <span class="staff-item-content">
                                                <i class="bi bi-person-check-fill"></i>
                                                <span class="staff-name">${staff.FullName}</span>
                                            </span>
                                            <button class="btn btn-sm btn-success assign-staff-btn"
                                                    data-user-id="${staff.UserId}"
                                                    data-staff-name="${staff.FullName}"
                                                    data-date="${dateInfo.Date}">
                                                <i class="bi bi-plus-circle"></i> Assign
                                            </button>
                                        </li>
                                    `).join('')}
                                </ul>` :
                                '<p class="no-staff-message"><i class="bi bi-x-circle"></i> No staff available on this date</p>'
                            }
                        </div>
                    </div>
                `);
                container.append(dateCard);
            });

            $('#availability-results').show();
        } catch (error) {
            $('#availability-loading').hide();
            $('#availability-error-message').text('An unexpected error occurred: ' + error.message);
            $('#availability-error').show();
        }
    };

    // Helper function to format date nicely
    window.formatDate = function(dateString) {
        const date = new Date(dateString + 'T00:00:00');
        const options = { weekday: 'short', year: 'numeric', month: 'short', day: 'numeric' };
        return date.toLocaleDateString('en-US', options);
    };

    // Initialize page
    $(document).ready(async function() {
        // Show loading initially
        showLoading();

        // Load tournament roles for dynamic context menu
        await loadTournamentRoles();

        // Hide loading after spreadsheet is initialized (will be handled by EventScheduleAPI.js)
        setTimeout(() => {
            if ($('.spreadsheet .cell').length > 0) {
                hideLoading();
            }
        }, 2000);

        // Wire up Check Availability button
        $('#check-availability-btn').on('click', function() {
            openCheckAvailabilityModal();
        });

        // Wire up Search button in modal
        $('#check-availability-search').on('click', function() {
            checkStaffAvailability();
        });

        // Event delegation for dynamically created Assign buttons
        $(document).on('click', '.assign-staff-btn', function() {
            const userId = $(this).data('user-id');
            const staffName = $(this).data('staff-name');
            const date = $(this).data('date');
            if (window.spreadsheetApp) {
                window.spreadsheetApp.assignStaffFromAvailability(userId, staffName, date);
            }
        });
    });
</script>

