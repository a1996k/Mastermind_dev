<div class="modal" tabindex="-1" id="service_note_modal">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Service Notes</h5>
                <button type="button" data-bs-dismiss="modal" data-modal-to-close="#service_note_modal" aria-label="Cancel">X Cancel</button>
            </div>
            <div class="modal-body">
                <input type="hidden" id="s_notes_cur_id" />
                <textarea class="service-notes"></textarea>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-fc-caution" data-modal-to-close="#service_note_modal">Cancel</button>
                <button type="button" class="btn btn-fc-primary save-service-notes" data-modal-to-close="#service_note_modal">Update</button>
            </div>
        </div>
    </div>
</div>


