<div class="modal" tabindex="-1" id="document_list_modal">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header d-flex justify-content-between">
                <h5 class="modal-title">Documents</h5>
                <button type="button" class="btn btn-success add-doc-btn m-3">+ Add</button>
                <button type="button" class="btn btn-fc-danger delete-docs-btn m-3" style="display:none">- Delete</button>
                <button type="button" data-bs-dismiss="modal" data-modal-to-close="#document_list_modal" aria-label="Cancel">X Cancel</button>
            </div>
            <div class="modal-body">
                <div class="container">
                    <div class="row">
                        <div class="col-12">
                            <ul class="document-list">
                            </ul>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>