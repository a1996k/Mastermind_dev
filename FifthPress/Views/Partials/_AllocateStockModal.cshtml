
<div class="modal" tabindex="-1" id="allocate_stock_modal">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header d-flex justify-content-between">
                <h5 class="modal-title">Allocate Stock</h5>
                <button type="button" data-bs-dismiss="modal" data-modal-to-close="#allocate_stock_modal" aria-label="Cancel">X Cancel</button>
            </div>
            <div class="modal-body">
                <div class="container">
                    <div class="row">
                        <div class="col-12 text-center">
                            <label class="fs-3"><u>Enter The Amount to Allocate</u> <input type="number" class="amount-to-allocate" /></label>
                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button class="btn btn-fc-danger gb-btn" data-modal-to-close="#allocate_stock_modal">Cancel</button>
                <button class="btn btn-fc-success allocate-stock-confirm-btn" data-modal-to-close="#allocate_stock_modal">Save</button>
            </div>
        </div>
    </div>
</div>

<script>
    function PassesAllocateStockValidation(toCheck) {

        return toCheck <= curStock && toCheck !== 0;
    };
    function AllocateStockToMaterial() {
        let entered = Number($('.amount-to-allocate').val());

        if (PassesAllocateStockValidation(entered)) {
            UpdateMaterialInventory('allocate-stock', $('#ac_helper').val(), entered);
        }
    };
    $(function () {

    }).on('click', '.allocate-stock-confirm-btn', AllocateStockToMaterial);
</script>