<div class="modal" tabindex="-1" id="denial_reason_modal">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Enter Reason for Denial</h5>
                <button type="button" data-bs-dismiss="modal" data-modal-to-close="#denial_reason_modal" aria-label="Cancel">X Cancel</button>
            </div>
            <div class="modal-body">
                <div class="container">
                    <div class="row">
                        <div class="col-12">
                            <label for="denial_reason">Reason</label>
                            <textarea id="denial_reason"></textarea>
                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-fc-info submit-denial-btn" data-modal-to-close="#">Submit Denial</button>
            </div>
        </div>
    </div>
</div>