<!-- ~/Views/Partials/_PreBillingDetailsModal.cshtml -->
<div id="preBillingDetailsModal" class="modal fade" tabindex="-1" role="dialog">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5>Pre-Billing Details</h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span>&times;</span>
                </button>
            </div>
            <div class="modal-body">
                <!-- This is where you load dynamic HTML or form fields for billing details -->
                <div class="form-group">
                    <label for="billingPO">PO Number</label>
                    <input type="text" class="form-control" id="billingPO" placeholder="Enter PO number" />
                </div>
                <!-- Add more fields as needed (notes, special instructions, etc.) -->
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-primary" onclick="saveBillingDetails()">
                    Save & Mark as Pre-Billed
                </button>
                <button type="button" class="btn btn-secondary" data-dismiss="modal">
                    Close
                </button>
            </div>
        </div>
    </div>
</div>