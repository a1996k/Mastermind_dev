<div class="modal" tabindex="-1" id="additional_time_modal">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Enter Info</h5>
                <button type="button" data-bs-dismiss="modal" data-modal-to-close="#additional_time_modal" aria-label="Cancel">X Cancel</button>
            </div>
            <div class="modal-body">
                <div class="container">
                    <div class="row">
                        <div class="col-12">
                            <div class="btn-group">
                                <label for="they_are">Customer Charge</label>
                                <input type="radio" name="whospaying" id="they_are" checked />
                                <label for="we_are">House Charge</label>
                                <input type="radio" name="whospaying" id="we_are" />
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-12">
                            <label for="xtra_time_notes">Reason</label>
                            <textarea id="xtra-time-notes"></textarea>
                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-fc-info commence-xtra-time" data-modal-to-close="#">Start Timer</button>
            </div>
        </div>
    </div>
</div>
