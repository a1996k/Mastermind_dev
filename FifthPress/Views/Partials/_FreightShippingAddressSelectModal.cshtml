<div class="modal" tabindex="-1" id="freight_shipping_address_modal">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Please select a Freight Address</h5>
                <button type="button" data-bs-dismiss="modal" data-modal-to-close="#freight_shipping_address_modal" aria-label="Cancel">X Cancel</button>
            </div>
            <div class="modal-body">
                <div class="nu-viewport">
                    <ul id="freight_address_list">
                    </ul>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-fc-caution" data-modal-to-close="#freight_shipping_address_modal">Cancel</button>
                <button type="button" class="btn btn-fc-primary update-freight-shipping-address-btn" data-modal-to-close="#freight_shipping_address_modal">Update</button>
            </div>
        </div>
    </div>
</div>