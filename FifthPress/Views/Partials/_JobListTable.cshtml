@using FifthPress.Models.ViewModels;
@model List<Job>

@foreach (Job j in Model)
{
    string dueDate = j.DueDate.HasValue ? j.DueDate.Value.ToString("M/d/yyyy") : "";
    string minDate = j.MinStartDate.HasValue ? j.MinStartDate.Value.ToString("M/d/yyyy") : "";
    
    <tr class="job-item" data-record-id="@Html.DisplayFor(model => j.Id)">
        <td class="job-state upd-job-state" data-state="@((JobStage)j.OverallJobStage)"><div class="@((JobStage)j.OverallJobStage)"></div></td>
        <td class="upd-job-number">@Html.DisplayFor(model => j.JobNumber)</td>
        <td class="upd-job-description" title="@Html.DisplayFor(model => j.Description)">@Html.DisplayFor(model => j.TruncatedTitle)</td>
        <td class="upd-job-client">@Html.DisplayFor(model => j.Client1.Title)</td>
        <td class="upd-min-start-date">@Html.DisplayFor(model => minDate)</td>
        <td class="upd-due-date">@Html.DisplayFor(model => dueDate)</td>
        <td class="upd-days-remaining">@j.DaysRemaining Days @Html.HiddenFor(model => j.JobStatus.Title)</td>
    </tr>
}