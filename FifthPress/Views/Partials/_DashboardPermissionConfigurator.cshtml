<div class="modal" tabindex="-1" id="dashboard_permission_config_modal">
    <div class="modal-dialog modal-xl">
        <div class="modal-content">
            <div class="modal-header d-flex justify-content-between">
                <div class="container">
                    <div class="row">
                        <div class="col-12 field-binder-row-flex justify-content-between">
                            <h5 class="modal-title ff-poppins fs-16">Configure <span class="db-requestor-name"></span>'s Permissions for <span class="db-card-title"></span></h5>
                            <button type="button" data-bs-dismiss="modal" data-modal-to-close="#dashboard_permission_config_modal" aria-label="Cancel">X Cancel</button>
