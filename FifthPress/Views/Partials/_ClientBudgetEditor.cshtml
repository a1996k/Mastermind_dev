@model FifthPress.Client

<style>
    .budget-settings-card {
        background: #f8f9fa;
        padding: 20px;
        border-radius: 5px;
        margin-bottom: 20px;
    }

    .budget-category-nav {
        display: flex;
        flex-wrap: wrap;
        gap: 10px;
        margin-bottom: 20px;
        border-bottom: 2px solid #ddd;
        padding-bottom: 10px;
    }

    .budget-category-btn {
        background: #fff;
        border: 1px solid #ddd;
        padding: 8px 16px;
        cursor: pointer;
        border-radius: 4px;
        transition: all 0.2s;
    }

    .budget-category-btn:hover {
        background: #e9ecef;
    }

    .budget-category-btn.active {
        background: #0066cc;
        color: white;
        border-color: #0066cc;
    }

    .budget-category-content {
        display: none;
    }

    .budget-category-content.active {
        display: block;
    }

    .budget-line-item-table {
        width: 100%;
        border-collapse: collapse;
        margin-bottom: 15px;
    }

    .budget-line-item-table th {
        background: #343a40;
        color: white;
        padding: 10px;
        text-align: left;
        font-weight: bold;
    }

    .budget-line-item-table td {
        padding: 8px;
        border-bottom: 1px solid #ddd;
    }

    .budget-line-item-table tr:hover {
        background: #f8f9fa;
    }

    .budget-summary {
        background: #e9ecef;
        padding: 15px;
        border-radius: 5px;
        margin-top: 20px;
    }

    .budget-summary-row {
        display: flex;
        justify-content: space-between;
        padding: 5px 0;
        font-size: 16px;
    }

    .budget-summary-row.grand-total {
        font-weight: bold;
        font-size: 18px;
        border-top: 2px solid #333;
        padding-top: 10px;
        margin-top: 10px;
    }

    .variance-positive {
        color: #28a745;
        font-weight: bold;
    }

    .variance-negative {
        color: #dc3545;
        font-weight: bold;
    }

    .btn-add-line-item {
        margin-bottom: 15px;
    }

    .line-item-edit-row {
        background: #fff3cd;
    }

    .line-item-input {
        width: 100%;
        padding: 4px;
        border: 1px solid #ced4da;
        border-radius: 3px;
    }

    .line-item-input-sm {
        width: 80px;
    }

    .line-item-input-md {
        width: 120px;
    }

    .budget-loading {
        text-align: center;
        padding: 40px;
        font-size: 18px;
        color: #6c757d;
    }
</style>

<div id="budgetEditorContainer" data-client-id="@Model.Id">
    <div class="budget-loading">
        <i class="fas fa-spinner fa-spin"></i> Loading budget data...
    </div>

    <div id="budgetEditorContent" style="display: none;">
        <!-- Budget Settings Section -->
        <div class="budget-settings-card">
            <h3>Budget Settings</h3>
            <div class="row">
                <div class="col-md-4">
                    <label>Tournament Location</label>
                    <input type="text" id="tournamentLocation" class="form-control" placeholder="e.g., Indianapolis, IN" />
                </div>
                <div class="col-md-3">
                    <label>Tax Rate (%)</label>
                    <input type="number" id="taxRate" class="form-control" step="0.01" min="0" max="100" />
                </div>
                <div class="col-md-5">
                    <label>Notes</label>
                    <textarea id="budgetNotes" class="form-control" rows="2"></textarea>
                </div>
            </div>
            <div class="row mt-2">
                <div class="col-md-12">
                    <button type="button" class="btn btn-primary btn-sm" id="saveBudgetSettings">Save Settings</button>
                </div>
            </div>
        </div>

        <!-- Category Navigation -->
        <div class="budget-category-nav">
            <button type="button" class="budget-category-btn active" data-category="Hardware Rental">Hardware Rental</button>
            <button type="button" class="budget-category-btn" data-category="Offsite Labor">Offsite Labor</button>
            <button type="button" class="budget-category-btn" data-category="Travel Expenses">Travel Expenses</button>
            <button type="button" class="budget-category-btn" data-category="Hotel/Accommodation">Hotel/Accommodation</button>
            <button type="button" class="budget-category-btn" data-category="Vehicle Rental">Vehicle Rental</button>
            <button type="button" class="budget-category-btn" data-category="Freight">Freight</button>
            <button type="button" class="budget-category-btn" data-category="Reimbursables - Hardware">Reimbursables</button>
            <button type="button" class="budget-category-btn" data-category="Management Fee">Management Fee</button>
            <button type="button" class="budget-category-btn" data-category="Storage Fee">Storage Fee</button>
            <button type="button" class="budget-category-btn" data-category="Design Fee">Design Fee</button>
            <button type="button" class="budget-category-btn" data-category="Onsite Print Info">Onsite Print Info</button>
            <button type="button" class="budget-category-btn" data-category="Miscellaneous">Miscellaneous</button>
        </div>

        <!-- Category Content Sections (will be populated dynamically) -->
        <div id="categoryContentContainer">
            <!-- Onsite Print Info Tab -->
            <div class="budget-category-content" data-category="Onsite Print Info">
                <div class="row mb-3">
                    <div class="col-md-6">
                        <label><strong>Airtable Base ID</strong></label>
                        <input type="text" id="onsitePrintBaseId" class="form-control" placeholder="e.g., appr4CfzgemFQSNGR" />
                        <small class="text-muted">Used for fetching onsite printing data from Airtable</small>
                    </div>
                    <div class="col-md-3">
                        <label><strong>Sq Ft Pricing ($)</strong></label>
                        <input type="number" id="onsitePrintSqftPrice" class="form-control" step="0.01" min="0" placeholder="e.g., 10.00" />
                        <small class="text-muted">Price per square foot</small>
                    </div>
                </div>
                <div class="row">
                    <div class="col-md-12">
                        <button type="button" class="btn btn-primary btn-sm" id="saveOnsitePrintInfo">Save Onsite Print Info</button>
                    </div>
                </div>
            </div>

            <!-- Dynamic category tables will be inserted here -->
        </div>

        <!-- Budget Summary -->
        @*<div class="budget-summary">
            <h4>Budget Summary</h4>
            <div class="budget-summary-row">
                <span>Total Estimated (before tax):</span>
                <span id="totalEstimated">$0.00</span>
            </div>
            <div class="budget-summary-row">
                <span>Total Actual (before tax):</span>
                <span id="totalActual">$0.00</span>
            </div>
            <div class="budget-summary-row">
                <span>Variance:</span>
                <span id="totalVariance" class="variance-positive">$0.00</span>
            </div>
            <div class="budget-summary-row">
                <span>Estimated Tax (<span id="taxRateDisplay">7</span>%):</span>
                <span id="estimatedTax">$0.00</span>
            </div>
            <div class="budget-summary-row">
                <span>Actual Tax:</span>
                <span id="actualTax">$0.00</span>
            </div>
            <div class="budget-summary-row grand-total">
                <span>Grand Total Estimated:</span>
                <span id="grandTotalEstimated">$0.00</span>
            </div>
            <div class="budget-summary-row grand-total">
                <span>Grand Total Actual:</span>
                <span id="grandTotalActual">$0.00</span>
            </div>
        </div>*@
    </div>
</div>

<!-- Line Item Edit Modal -->
<div class="modal fade" id="lineItemModal" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="lineItemModalTitle">Add Line Item</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <input type="hidden" id="editLineItemId" value="0" />
                <input type="hidden" id="editCategoryId" value="" />
                <input type="hidden" id="editCategoryName" value="" />

                <div class="row mb-3">
                    <div class="col-md-12">
                        <label>Item Description *</label>
                        <input type="text" id="editItemDescription" class="form-control" required />
                    </div>
                </div>

                <div class="row mb-3">
                    <div class="col-md-3">
                        <label>Quantity</label>
                        <input type="number" id="editQuantity" class="form-control" step="0.01" />
                    </div>
                    <div class="col-md-3">
                        <label>Days</label>
                        <input type="number" id="editQuantityDays" class="form-control" />
                    </div>
                    <div class="col-md-3">
                        <label>Unit Price</label>
                        <input type="number" id="editUnitPrice" class="form-control" step="0.01" />
                    </div>
                    <div class="col-md-3">
                        <label>Sq Ft</label>
                        <input type="number" id="editSqFt" class="form-control" step="0.01" />
                    </div>
                </div>

                <div class="row mb-3">
                    <div class="col-md-3">
                        <label>Width</label>
                        <input type="number" id="editWidth" class="form-control" step="0.01" />
                    </div>
                    <div class="col-md-3">
                        <label>Height</label>
                        <input type="number" id="editHeight" class="form-control" step="0.01" />
                    </div>
                    <div class="col-md-3">
                        <label>Start Date</label>
                        <input type="date" id="editStartDate" class="form-control" />
                    </div>
                    <div class="col-md-3">
                        <label>End Date</label>
                        <input type="date" id="editEndDate" class="form-control" />
                    </div>
                </div>

                <div class="row mb-3">
                    <div class="col-md-4">
                        <label>Estimated Amount *</label>
                        <input type="number" id="editEstimatedAmount" class="form-control" step="0.01" required />
                    </div>
                    <div class="col-md-4">
                        <label>Actual Amount</label>
                        <input type="number" id="editActualAmount" class="form-control" step="0.01" />
                    </div>
                    <div class="col-md-4">
                        <label>
                            <input type="checkbox" id="editIsTaxable" /> Taxable
                        </label>
                    </div>
                </div>

                <div class="row mb-3">
                    <div class="col-md-12">
                        <label>Notes</label>
                        <textarea id="editNotes" class="form-control" rows="3"></textarea>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-primary" id="saveLineItemBtn">Save Line Item</button>
            </div>
        </div>
    </div>
</div>
