<div class="modal" tabindex="-1" id="sheet_override_modal">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header d-flex justify-content-between">
                <h5 class="modal-title">Override Sheet Count</h5>
                <button type="button" data-bs-dismiss="modal" data-modal-to-close="#sheet_override_modal" aria-label="Cancel">X Cancel</button>
            </div>
            <div class="modal-body">
                <div class="container">
                    <div class="row">
                        <div class="col-12 text-center">
                            <label class="fs-3"><u>Enter New Sheet Count: </u> <input type="text" class="new-sheet-count" /></label>
                            <label class="fs-3"><u>Enter New Scrap Sheet Count: </u><input type="text" class="new-scrap-sheet-count" /></label>
                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button class="btn btn-fc-danger gb-btn" data-modal-to-close="#sheet_override_modal">Cancel</button>
                <button class="btn btn-fc-success submit-sheet-override-btn" data-modal-to-close="#sheet_override_modal">Save</button>
            </div>
        </div>
    </div>
</div>