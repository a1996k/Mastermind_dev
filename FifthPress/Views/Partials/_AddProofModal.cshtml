<div class="modal" tabindex="-1" id="add_proof_modal">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Upload Proof</h5>
                <button type="button" data-bs-dismiss="modal" data-modal-to-close="#add_proof_modal" aria-label="Cancel">X Cancel</button>
            </div>
            <div class="modal-body">
                <div class="container">
                    <form id="add_proof_form" enctype="multipart/form-data">
                        <div class="row">
                            <div class="col-12">
                                <input type="hidden" class="proof-item-id" name="itemId" />
                                <label for="proof_file_inp">Select PDF Proof</label>
                                <input type="file" class="form-control" name="proofFile" id="proof_file_inp" accept=".pdf" />
                                <small class="text-muted">Only PDF files are allowed</small>
                            </div>
                        </div>
                        <div class="row mt-3">
                            <div class="col-12 text-end">
                                <button type="button" class="btn btn-fc-info submit-proof-btn">
                                    <i class="fa-solid fa-upload me-2"></i>Upload Proof
                                </button>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-fc-caution" data-modal-to-close="#add_proof_modal">Cancel</button>
            </div>
        </div>
    </div>
</div>
