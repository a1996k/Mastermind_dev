<script>
    function GoToMarcus() {
        window.location = ProcessUrl('Administration/MarcusAdminScreen');
    };
    function GoToMyDashboard() {
        window.location = ProcessUrl('Dashboard/Index');
    };
    function TestAdp() {
        $.ajax({
            type: 'POST',
            url: ProcessUrl('test-adp'),
            beforeSend: function () {
                $('.test-adp-btn').prop('disabled', true);
            },
            success: function () {
                alert('Finished!');
            },
            complete: function (data) {
                $('.test-adp-btn').prop('disabled', false);
            }
        });
    };
    function GoToRecordInspector() {
        window.location = ProcessUrl('record-inspector');
    }
    document.addEventListener("DOMContentLoaded", function () {
        //day started?
        $.ajax({
            type: 'GET',
            url: ProcessUrl('user-status'),
            success: function (data) {
                var res = JSON.parse(data);

                if (!res.isMarcus) {
                    UIUpdate_RemoveMarcusScreens();
                }

                $('.u-welcome-msg').text(res.userName)
            }
        });
        //permissions
        // Get the data-permissions attribute value from the cookie
        var permissionsCookie = getCookie("Permissions");

        // Parse the permissionsCookie two characters at a time
        var permissions = [];
        for (var i = 0; i < permissionsCookie.length; i += 2) {
            permissions.push(permissionsCookie.substr(i, 2));
        }

        // Select all elements with [data-permissions] attribute
        var elements = document.querySelectorAll("[data-permissions]");

        // Loop through elements and remove those not in the permissions array
        elements.forEach(function (element) {
            var elementPermission = element.getAttribute("data-permissions");
            if (!permissions.includes(elementPermission)) {
                element.parentNode.removeChild(element);
            }
        });
    });

    // Function to get a specific cookie by name
    function getCookie(name) {
        var value = "; " + document.cookie;
        var parts = value.split("; " + name + "=");
        if (parts.length === 2) return parts.pop().split(";").shift();
    };

    function MenuNav(e) {
        e.preventDefault();
        var $ele = $(this);
        var h = $ele.attr('href');
        var url = ProcessUrl(h);

        window.location = url;
    }
    $(function () { })
        .on('click', '.nav-link', MenuNav)
        .on('click', '.test-adp-btn', TestAdp)
        .on('click', '.for-marcus button', GoToMarcus)
        .on('click', '.dashboard-nav-button', GoToMyDashboard)
        .on('click', '.record-inspector button', GoToRecordInspector);
</script>