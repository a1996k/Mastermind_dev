@model List<Service>

<div class="modal" tabindex="-1" id="general_service_modal">
    <div class="modal-dialog modal-xl">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Select Prepress Service(s)</h5>
                <button type="button" class="btn btn-fc-caution" data-modal-to-close="#general_service_modal">Cancel</button>
                <button type="button" class="btn btn-fc-primary general-service-add" data-modal-to-close="#general_service_modal">Update</button>
            </div>
            <div class="modal-body">
                <div class="nu-viewport">
                    <table id="general_service_table">
                        <thead>
                            <tr>
                                <th>
                                    Service
                                </th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (Service s in Model)
                            {
                                <tr data-record-title="@Html.DisplayFor(model => s.Title)" data-record-id="@Html.DisplayFor(model => s.Id)">
                                    <td>
                                        <label class="d-flex flex-row justify-content-between py-2">
                                            <span>@Html.DisplayFor(model => s.Title)</span>
                                            <input type="checkbox" class="btn btn-fc-primary btn-sm product-select-btn ms-3" data-item-title="@Html.DisplayFor(model => s.Title)" data-record-type="service" data-service-id="@Html.DisplayFor(model => s.Id)" />
                                        </label>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>