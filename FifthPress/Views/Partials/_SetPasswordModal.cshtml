<div class="modal" tabindex="-1" id="set_password_modal">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header d-flex justify-content-between">
                <h5 class="modal-title">Set New Password</h5>
                <button type="button" data-bs-dismiss="modal" data-modal-to-close="#set_password_modal" aria-label="Cancel">X Cancel</button>
            </div>
            <div class="modal-body">
                <div class="container">
                    <div class="row">
                        <div class="col-12 text-center">
                            <div class="field-binder-col-flex">
                                <label>New Password</label>
                                <input type="password" class="styled-input new-password-inp" />
                            </div>
                            <div class="field-binder-col-flex">
                                <label>Re-Type Password</label>
                                <input type="password" class="styled-input new-password-conf-inp" />
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button class="btn btn-fc-danger gb-btn" data-modal-to-close="#set_password_modal">Cancel</button>
                <button class="btn btn-fc-success submit-password" data-modal-to-close="#set_password_modal">Save</button>
            </div>
        </div>
    </div>
</div>