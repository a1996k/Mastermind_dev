<div class="modal" tabindex="-1" id="login">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header text-bg-dark text-center">
                <h5 class="modal-title">Operator Login</h5>
                <button type="button" data-bs-dismiss="modal" data-modal-to-close="#login" aria-label="Cancel">X Cancel</button>
            </div>
            <div class="modal-body">
                <div class="field-binder-col-flex align-items-end">
                    <div class="field-binder-row-flex">
                        <label for="operator_num">Enter your username: </label>
                        <input id="operator_un" type="text" class="text-center ms-3" autocomplete="off" />
                    </div>
                    <div class="field-binder-row-flex">
                        <label for="operator_pcode">Enter your passcode: </label>
                        <input id="operator_pcode" type="password" class="text-center ms-3" autocomplete="off" />
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-modal-to-close="#login" data-bs-dismiss="modal">Close</button>
                <button type="button" class="btn btn-fc-info execute-login">Login</button>
            </div>
        </div>
    </div>
</div>
