@using FifthPress.Models.ViewModels;
@model VM_MultiselectModel2

<select class="@Html.DisplayFor(model => model.SelectName)-Dummy styled-input" data-msl-class=".@Html.DisplayFor(model => model.SelectName)-msl-dropdown-container">
    <option value="">Select @Html.DisplayFor(model => model.SelectName)</option>
</select>

<!-- Searchable Dropdown with Checkboxes -->
<div class="msl-dropdown-container @Html.DisplayFor(model => model.SelectName)-msl-dropdown-container" style="display:none">
    <div class="msl-dropdown">
        <div class="field-binder-row-flex ps-2">
            <input type="checkbox" class="msl-all-cb m-1" checked />
            <input type="text" id="@Html.DisplayFor(model => model.SelectName)-search" class="msl-dropdown-search ff-dm-sans fs-12" placeholder="Search List..." />
        </div>
        <ul class="msl-dropdown-list">
            @foreach (SelectListItem si in Model.SelectList)
            {
                string checkboxId = String.Format("{0}_box_{1}", Model.SelectName, si.Value);
                <li class="ff-dm-sans fs-12">
                    <input type="checkbox" @(si.Selected ? "checked" : "") id="@Html.DisplayFor(model => checkboxId)" value="@Html.DisplayFor(model => si.Value)">
                    <label for="@Html.DisplayFor(model => checkboxId)">@Html.DisplayFor(model => si.Text)</label>
                </li>
            }
        </ul>

        <button type="button" class="btn btn-sm btn-fc-info close-msl">Close</button>
    </div>
</div>

<!-- Styles -->
<style>
    .msl-dropdown-container {
        position: relative;
        width: 300px;
    }

    .msl-dropdown {
        border: 1px solid #ccc;
        border-radius: 4px;
        padding: 10px;
        background-color: #fff;
        position: relative;
    }

    .msl-dropdown-search {
        width: 100%;
        padding: 8px;
        border: 1px solid #ccc;
        border-radius: 4px;
        margin-bottom: 5px;
    }

    .msl-dropdown-list {
        max-height: 150px;
        overflow-y: auto;
        padding: 0;
        list-style: none;
        margin: 0;
        border: 1px solid #ddd;
    }

        .msl-dropdown-list li {
            display: flex;
            align-items: center;
            padding: 5px;
            cursor: pointer;
        }

        .msl-dropdown-list input[type="checkbox"] {
            margin-right: 10px;
        }
</style>

<script>
    function ShowPartner(e) {
        e.preventDefault();
        let $dummyList = $('.@Html.DisplayFor(model => model.SelectName)-Dummy');
        $($dummyList.attr('data-msl-class')).show();
        $dummyList.hide();
    };
    function CloseMSL() {
        let $dummyList = $('.@Html.DisplayFor(model => model.SelectName)-Dummy');
        $dummyList.show();
        $($dummyList.attr('data-msl-class')).hide();
    };
    $(function () { })
        .on('click', '.@Html.DisplayFor(model => model.SelectName)-Dummy', ShowPartner)
        .on('click', '.close-msl', CloseMSL);

</script>