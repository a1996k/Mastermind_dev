        <div class="modal-content">
            <div class="modal-header">
                <button type="button" data-bs-dismiss="modal" data-modal-to-close="#qa_list_modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <table class="table">
                    <thead>
                        <tr>
                            <th>Pass/Fail</th>
                            <th>Job Number</th>
                            <th>Service Title</th>
                            <th>First Approver</th>
                            <th>First Approval Time</th>
