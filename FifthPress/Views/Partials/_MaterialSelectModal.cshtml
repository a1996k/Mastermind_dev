@using FifthPress.Models.ViewModels;
@model VM_Materials

<div class="modal" tabindex="-1" id="materials_select_modal">
    <div class="modal-dialog modal-xl">
        <div class="modal-content popup-modal-fc">
            <div class="modal-header">
                <h3 class="modal-title fc-popup">Select Material</h3>
                <button type="button" data-bs-dismiss="modal" data-modal-to-close="#materials_select_modal" aria-label="Cancel">X Cancel</button>
            </div>
            <div class="modal-body">
                <div class="nu-viewport container p-0">
                    <div class="row">
                        <div class="col-3">
                            <div class="sidebar-container">
                                <ul class="fs-3 p-0">
                                    @foreach (MaterialCategory mc in Model.MaterialCategoryObjs.OrderBy(x => x.ListOrder))
                                    {
                                        <li data-record-id="@mc.Id">@mc.Title</li>
                                    }
                                </ul>
                            </div>
                        </div>
                        <div class="col-9 mx-auto">
                            <table id="materials_select_table">
                                <thead>
                                    <tr>
                                        <th>
                                            Product
                                        </th>
                                        <th>
                                            Description
                                        </th>
                                        <th>
                                            Size
                                        </th>
                                        <th>
                                            Current Inventory
                                        </th>
                                        <th>
                                            Cost Per Unit
                                        </th>
                                    </tr>
                                </thead>
                                <tbody class="viewer">
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-fc-caution" data-modal-to-close="#materials_select_modal"><i class="fa-solid fa-chevron-left"></i> Back</button>
                <!--<button type="button" class="btn btn-fc-primary builder-product-add" data-modal-to-close="#materials_select_modal">Cutting Settings</button>-->
                <button type="button" class="btn btn-fc-primary builder-product-add" data-modal-to-close="#materials_select_modal">Update</button>
            </div>
        </div>
    </div>
</div>