    // Build a mini department chart for Actual vs Forecast breakdown
    function buildMiniDeptChart(canvasId, chartData, pluginSuffix, navUrl, periodId, deptId, contractTypeFilter) {
        var canvas = document.getElementById(canvasId);
        if (!canvas || chartData.length === 0) return null;

        var months = chartData.map(function(d) { return d.month; });
        var retainerData = chartData.map(function(d) { return d.retainer; });
        var nonRetainerData = chartData.map(function(d) { return d.nonRetainer; });
        var internalNBData = chartData.map(function(d) { return d.internalNonBillable; });

        var maxPerMonth = chartData.map(function(d) { return d.retainer + d.nonRetainer + d.internalNonBillable; });
        var yMax = Math.ceil((Math.max.apply(null, maxPerMonth.concat([80])) + 10) / 10) * 10;

        return new Chart(canvas.getContext('2d'), {
            type: 'bar',
            data: {
                labels: months,
                datasets: [
                    { label: 'Retainer', data: retainerData, backgroundColor: '#1a5276', stack: 'stack0' },
                    { label: 'Non-Retainer', data: nonRetainerData, backgroundColor: '#5dade2', stack: 'stack0' },
                    { label: 'Internal Non-Billable', data: internalNBData, backgroundColor: '#e67e22', stack: 'stack0' }
                ]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                onClick: function() {
                    var url = navUrl + '?periodId=' + periodId;
                    if (deptId !== 'all') url += '&departmentId=' + deptId;
                    url += '&contractTypeFilter=' + contractTypeFilter;
                    window.location.href = url;
                },
                plugins: {
                    legend: { display: false },
                    tooltip: {
                        callbacks: {
                            label: function(context) { return context.dataset.label + ': ' + context.parsed.y.toFixed(1) + '%'; },
                            afterBody: utilizationTooltipAfterBody
                        }
                    },
                    annotation: {
                        annotations: {
                            goalLine: { type: 'line', yMin: 80, yMax: 80, borderColor: '#d9534f', borderWidth: 2, borderDash: [5, 5] }
                        }
                    }
                },
                scales: {
                    x: { stacked: true, ticks: { font: { size: 10 } } },
                    y: { stacked: true, beginAtZero: true, max: yMax, ticks: { callback: function(v) { return v + '%'; }, font: { size: 10 } } }
                }
            },
            plugins: [createOverlayPlugin('overlay_' + pluginSuffix)]
        });
    }

    // Build a Total Utilization chart showing Actual + Forecast visually split
    function buildTotalUtilChart(canvasId, actualData, forecastData, pluginSuffix, navUrl, periodId, deptId) {
        var canvas = document.getElementById(canvasId);
        if (!canvas) return null;
        if (actualData.length === 0 && forecastData.length === 0) return null;

        // Merge months from both datasets
        var monthSet = {};
        actualData.forEach(function(d) { monthSet[d.month] = true; });
        forecastData.forEach(function(d) { monthSet[d.month] = true; });
        var months = Object.keys(monthSet);

        // Build lookup maps
        var actMap = {};
        actualData.forEach(function(d) { actMap[d.month] = d; });
        var fcMap = {};
        forecastData.forEach(function(d) { fcMap[d.month] = d; });

        // Create data arrays for each dataset
        var actRetainer = months.map(function(m) { return actMap[m] ? actMap[m].retainer : 0; });
        var actNonRetainer = months.map(function(m) { return actMap[m] ? actMap[m].nonRetainer : 0; });
        var fcRetainer = months.map(function(m) { return fcMap[m] ? fcMap[m].retainer : 0; });
        var fcNonRetainer = months.map(function(m) { return fcMap[m] ? fcMap[m].nonRetainer : 0; });

        // Calculate yMax from combined totals
        var maxPerMonth = months.map(function(m, i) {
            return actRetainer[i] + actNonRetainer[i] + fcRetainer[i] + fcNonRetainer[i];
        });
        var yMax = Math.ceil((Math.max.apply(null, maxPerMonth.concat([80])) + 10) / 10) * 10;

        return new Chart(canvas.getContext('2d'), {
            type: 'bar',
            data: {
                labels: months,
                datasets: [
                    { label: 'Actual Retainer', data: actRetainer, backgroundColor: '#1a5276', stack: 'stack0' },
                    { label: 'Actual Non-Retainer', data: actNonRetainer, backgroundColor: '#5dade2', stack: 'stack0' },
                    { label: 'Forecast Retainer', data: fcRetainer, backgroundColor: 'rgba(46, 134, 193, 0.45)', stack: 'stack0' },
                    { label: 'Forecast Non-Retainer', data: fcNonRetainer, backgroundColor: 'rgba(133, 193, 233, 0.45)', stack: 'stack0' }
                ]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                onClick: function() {
                    var url = navUrl + '?periodId=' + periodId;
                    if (deptId !== 'all') url += '&departmentId=' + deptId;
                    url += '&contractTypeFilter=0';
                    window.location.href = url;
                },
                plugins: {
                    legend: { display: false },
                    tooltip: {
                        callbacks: {
                            label: function(context) { return context.dataset.label + ': ' + context.parsed.y.toFixed(1) + '%'; },
                            afterBody: utilizationTooltipAfterBody
                        }
                    },
                    annotation: {
                        annotations: {
                            goalLine: { type: 'line', yMin: 80, yMax: 80, borderColor: '#d9534f', borderWidth: 2, borderDash: [5, 5] }
                        }
                    }
                },
                scales: {
                    x: { stacked: true, ticks: { font: { size: 10 } } },
                    y: { stacked: true, beginAtZero: true, max: yMax, ticks: { callback: function(v) { return v + '%'; }, font: { size: 10 } } }
                }
            },
            plugins: [createOverlayPlugin('overlay_' + pluginSuffix)]
        });
    }

        $(document).ready(function () {
            var periodId = @period.ForecastPeriodID;
            var selectedDeptId = @(selectedDeptId ?? 0);

            // ============================================================
            // Generate Internal Buckets button
            // ============================================================
            $('#btnGenerateInternal').click(function () {
                if (confirm('Generate internal non-billable contracts for each month in this period?\n\nExisting months will be skipped.')) {
                    $('#generateInternalForm').submit();
                }
            });

            // ============================================================
            // Checkbox & Bulk Action Bar logic
            // ============================================================
            function updateBulkBar() {
                var checked = $('.contract-checkbox:checked').length;
                if (checked > 0) {
                    $('#bulkActionBar').slideDown(200);
                    $('#selectedCount').text(checked);
                } else {
                    $('#bulkActionBar').slideUp(200);
                }
            }

            $('#selectAll').change(function () {
                $('.contract-checkbox').prop('checked', this.checked);
                updateBulkBar();
            });

            $(document).on('change', '.contract-checkbox', function () {
                var total = $('.contract-checkbox').length;
                var checked = $('.contract-checkbox:checked').length;
                $('#selectAll').prop('checked', total === checked);
                updateBulkBar();
            });

            $('#btnClearSelection').click(function () {
                $('.contract-checkbox, #selectAll').prop('checked', false);
                updateBulkBar();
            });

            $('#btnBulkApply').click(function () {
                $('#bulkApplyModal').modal('show');
            });

            $('#btnConfirmBulkApply').click(function () {
                var contractIds = [];
                var externalProjectIds = [];
                $('.contract-checkbox:checked').each(function () {
                    var id = parseInt(this.value);
                    if ($(this).data('external') === true) {
                        externalProjectIds.push(id);
                    } else {
                        contractIds.push(id);
                    }
                });

                var billingClassId = $('#bulkBillingClass').val();
                var subclass = $('#bulkSubclass').val();
                var hours = parseFloat($('#bulkHours').val()) || 0;

                if (!billingClassId) {
                    alert('Please select a billing class.');
                    return;
                }
                if (hours <= 0) {
                    alert('Please enter budgeted hours greater than 0.');
                    return;
                }

                var token = $('input[name="__RequestVerificationToken"]').val();

                $.ajax({
                    url: '@Url.Action("BulkAddDetails", "Forecasting")',
                    type: 'POST',
                    data: {
                        contractIds: contractIds,
                        externalProjectIds: externalProjectIds,
                        billingClassId: billingClassId,
                        billingSubclass: subclass,
                        budgetedHours: hours,
                        __RequestVerificationToken: token
                    },
                    traditional: true,
                    success: function (result) {
                        if (result.success) {
                            alert(result.message);
                            location.reload();
                        } else {
                            alert('Error: ' + result.message);
                        }
                    },
                    error: function () {
                        alert('An unexpected error occurred.');
                    }
                });
            });

            // ============================================================
            // Delete Contract
            // ============================================================
            $(document).on('click', '.btn-delete-contract', function () {
                var contractId = $(this).data('contract-id');
                var contractName = $(this).data('contract-name');
                var row = $(this).closest('tr');

                if (!confirm('Are you sure you want to delete "' + contractName + '"?\n\nThis will remove it from all charts and reports.')) {
                    return;
                }

                var token = $('input[name="__RequestVerificationToken"]').val();

                $.ajax({
                    url: '@Url.Action("DeleteContract", "Forecasting")',
                    type: 'POST',
                    data: {
                        contractId: contractId,
                        __RequestVerificationToken: token
                    },
                    success: function (result) {
                        if (result.success) {
                            row.fadeOut(300, function () { $(this).remove(); });
                        } else {
                            alert('Error: ' + result.message);
                        }
                    },
                    error: function () {
                        alert('An unexpected error occurred.');
                    }
                });
            });

            // ============================================================
            // Department selector change - reload page with new department
            // ============================================================
            $('#dashboardDeptSelector').change(function () {
                var deptId = $(this).val();
                window.location.href = '@Url.Action("Contracts", "Forecasting")?periodId=' + periodId + '&departmentId=' + deptId;
            });

            // ============================================================
            // Dashboard Charts - Combined chart commented out
            // ============================================================
            // var utilResult = null;
            // buildContractsUtilChart and buildContractsBCChart invocations commented out
            // (combined chart panel is hidden, replaced by per-department Actual vs Forecast below)

            // ============================================================
            // Per-Department Actual vs Forecast Charts
            // ============================================================
            var utilDashUrl = '@Url.Action("UtilizationDashboard", "Forecasting")';

            @{
                if (actualByDeptData != null && actualByDeptData.Any())
                {
                    <text>
                    var actualRaw = @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(actualByDeptData.Select(m => new {
                        month = m.MonthStart.HasValue ? m.MonthStart.Value.ToString("MMM yyyy") : m.MonthName,
                        deptId = m.DepartmentID,
                        deptName = m.DepartmentName,
                        retainer = Math.Round(m.RetainerPercentage ?? 0, 1),
                        nonRetainer = Math.Round(m.NonRetainerPercentage ?? 0, 1),
                        internalNonBillable = Math.Round(m.InternalNonBillablePercentage ?? 0, 1)
                    })));
                    </text>
                }
                else
                {
                    <text>var actualRaw = [];</text>
                }

                if (forecastByDeptData != null && forecastByDeptData.Any())
                {
                    <text>
                    var forecastRaw = @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(forecastByDeptData.Select(m => new {
                        month = m.MonthStart.HasValue ? m.MonthStart.Value.ToString("MMM yyyy") : m.MonthName,
                        deptId = m.DepartmentID,
                        deptName = m.DepartmentName,
                        retainer = Math.Round(m.RetainerPercentage ?? 0, 1),
                        nonRetainer = Math.Round(m.NonRetainerPercentage ?? 0, 1),
                        internalNonBillable = Math.Round(m.InternalNonBillablePercentage ?? 0, 1)
                    })));
                    </text>
                }
                else
                {
                    <text>var forecastRaw = [];</text>
                }
            }

            // Exclude Internal Marketing from charts
            actualRaw = actualRaw.filter(function(d) { return d.deptName !== 'Internal Marketing'; });
            forecastRaw = forecastRaw.filter(function(d) { return d.deptName !== 'Internal Marketing'; });

            // Helper: group data by department
            function groupByDept(data) {
                var groups = {};
                data.forEach(function(d) {
                    if (!groups[d.deptId]) groups[d.deptId] = { name: d.deptName, rows: [] };
                    groups[d.deptId].rows.push(d);
                });
                return groups;
            }

            // Helper: aggregate across departments for "All Departments" row
            function aggregateAllDepts(data) {
                var monthGroups = {};
                data.forEach(function(d) {
                    if (!monthGroups[d.month]) {
                        monthGroups[d.month] = { count: 0, retainer: 0, nonRetainer: 0, internalNonBillable: 0 };
                    }
                    monthGroups[d.month].count++;
                    monthGroups[d.month].retainer += d.retainer;
                    monthGroups[d.month].nonRetainer += d.nonRetainer;
                    monthGroups[d.month].internalNonBillable += d.internalNonBillable;
                });
                return Object.keys(monthGroups).map(function(month) {
                    var g = monthGroups[month];
                    return {
                        month: month,
                        retainer: Math.round((g.retainer / g.count) * 10) / 10,
                        nonRetainer: Math.round((g.nonRetainer / g.count) * 10) / 10,
                        internalNonBillable: Math.round((g.internalNonBillable / g.count) * 10) / 10
                    };
                });
            }

            // Build "All Departments" row charts
            if (actualRaw.length > 0 || forecastRaw.length > 0) {
                var allActual = aggregateAllDepts(actualRaw);
                var allForecast = aggregateAllDepts(forecastRaw);
                buildMiniDeptChart('chart-all-actual', allActual, 'all_actual', utilDashUrl, periodId, 'all', 1);
                buildTotalUtilChart('chart-all-total', allActual, allForecast, 'all_total', utilDashUrl, periodId, 'all');

                // Build per-department rows dynamically
                var actualByDept = groupByDept(actualRaw);
                var forecastByDept = groupByDept(forecastRaw);

                // Collect all department IDs from both sets
                var allDeptIds = {};
                Object.keys(actualByDept).forEach(function(id) { allDeptIds[id] = actualByDept[id].name; });
                Object.keys(forecastByDept).forEach(function(id) { allDeptIds[id] = forecastByDept[id].name; });

                // Sort departments by name
                var sortedDeptIds = Object.keys(allDeptIds).sort(function(a, b) {
                    return allDeptIds[a].localeCompare(allDeptIds[b]);
                });

                // Create HTML rows and charts for each department
                var container = document.getElementById('deptChartRows');
                if (container) {
                    sortedDeptIds.forEach(function(deptId) {
                        var deptName = allDeptIds[deptId];
                        var rowDiv = document.createElement('div');
                        rowDiv.className = 'row';
                        rowDiv.style.cssText = 'margin-bottom: 15px; border-bottom: 1px solid #eee; padding-bottom: 15px;';
                        rowDiv.innerHTML =
                            '<div class="col-md-12"><h5><strong>' + deptName + '</strong></h5></div>' +
                            '<div class="col-md-6">' +
                                '<h6 class="text-center text-muted">Actual</h6>' +
                                '<div style="height: 200px; cursor: pointer;"><canvas id="chart-' + deptId + '-actual"></canvas></div>' +
                            '</div>' +
                            '<div class="col-md-6">' +
                                '<h6 class="text-center text-muted">Total (Actual + Forecast)</h6>' +
                                '<div style="height: 200px; cursor: pointer;"><canvas id="chart-' + deptId + '-total"></canvas></div>' +
                            '</div>';
                        container.appendChild(rowDiv);

                        var actData = actualByDept[deptId] ? actualByDept[deptId].rows : [];
                        var fcData = forecastByDept[deptId] ? forecastByDept[deptId].rows : [];

                        buildMiniDeptChart('chart-' + deptId + '-actual', actData, deptId + '_actual', utilDashUrl, periodId, deptId, 1);
                        buildTotalUtilChart('chart-' + deptId + '-total', actData, fcData, deptId + '_total', utilDashUrl, periodId, deptId);
                    });
                }
            }
        });

        // ============================================================
        // Quick Add Contract
        // ============================================================
        var qaBillingClasses = [];

        function addQuickBillingClass() {
            var bcId = $('#qaBillingClass').val();
            var bcName = $('#qaBillingClass option:selected').text();
            var hours = parseFloat($('#qaHours').val()) || 0;

            if (!bcId || hours <= 0) {
                alert('Please select a billing class and enter hours.');
                return;
            }

            // Check for duplicate
            if (qaBillingClasses.some(function(bc) { return bc.id == bcId; })) {
                alert('This billing class is already added.');
                return;
            }

            qaBillingClasses.push({ id: bcId, name: bcName, hours: hours });
            renderQaBillingClasses();

            // Reset inputs
            $('#qaBillingClass').val('');
            $('#qaHours').val('');
        }

        function removeQaBillingClass(index) {
            qaBillingClasses.splice(index, 1);
            renderQaBillingClasses();
        }

        function renderQaBillingClasses() {
            var html = '';
            var total = 0;
            qaBillingClasses.forEach(function(bc, i) {
                html += '<tr><td>' + bc.name + '</td><td>' + bc.hours + '</td>' +
                    '<td><button class="btn btn-xs btn-danger" onclick="removeQaBillingClass(' + i + ')">X</button></td></tr>';
                total += bc.hours;
            });
            $('#qaBillingClassList').html(html);
            $('#qaTotalHours').text(total);
            $('#qaBillingClassTable').toggle(qaBillingClasses.length > 0);
        }

        function submitQuickAdd() {
            var contractName = $('#qaContractName').val().trim();
            var clientName = $('#qaClientName').val().trim();
            var startDate = $('#qaStartDate').val();
            var endDate = $('#qaEndDate').val();

            if (!contractName || !clientName || !startDate || !endDate) {
                alert('Please fill in all required fields.');
                return;
            }

            var data = {
                periodId: @period.ForecastPeriodID,
                contractName: contractName,
                clientName: clientName,
                startDate: startDate,
                endDate: endDate,
                isRetainer: $('#qaIsRetainer').val() === 'true',
                isActual: $('#qaIsActual').val() === 'true',
                includeInCharts: $('#qaIncludeInCharts').is(':checked'),
                billingClasses: qaBillingClasses
            };

            $.ajax({
                url: '@Url.Action("QuickAddContract", "Forecasting")',
                type: 'POST',
                contentType: 'application/json',
                data: JSON.stringify(data),
                success: function(response) {
                    if (response.success) {
                        alert('Contract created: ' + response.contractName);
                        location.reload();
                    } else {
                        alert('Error: ' + response.message);
                    }
                },
                error: function() {
                    alert('Error creating contract');
                }
            });
        }

        // Reset modal on close
        $('#quickAddModal').on('hidden.bs.modal', function() {
            $('#qaContractName, #qaClientName, #qaHours').val('');
            $('#qaBillingClass').val('');
            $('#qaIncludeInCharts').prop('checked', true);
            qaBillingClasses = [];
            renderQaBillingClasses();
        });
    </script>
}
