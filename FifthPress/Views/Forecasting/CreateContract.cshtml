@model ContractForecast

@{
    ViewBag.Title = "Create Contract";
    var period = ViewBag.Period as ForecastPeriod;
}

@if (period == null)
{
    <div class="alert alert-danger">
        <h4>Error: Period Not Found</h4>
        <p>The forecast period could not be loaded. Please try again.</p>
        @Html.ActionLink("Back to Periods", "Index", null, new { @class = "btn btn-default" })
    </div>
    return;
}

<div class="container-fluid">
    <div class="row">
        <div class="col-md-8 col-md-offset-2">
            <h2>Create New Contract</h2>
            <p class="text-muted">For period: @period.PeriodName</p>

            @using (Html.BeginForm("CreateContract", "Forecasting", FormMethod.Post, new { @class = "form-horizontal" }))
            {
                @Html.AntiForgeryToken()
                @Html.HiddenFor(model => model.ForecastPeriodID)

                <div class="panel panel-default">
                    <div class="panel-body">
                        @Html.ValidationSummary(true, "", new { @class = "text-danger" })

                        <div class="form-group">
                            @Html.LabelFor(model => model.ContractName, new { @class = "control-label col-md-3" })
                            <div class="col-md-9">
                                @Html.TextBoxFor(model => model.ContractName, new { @class = "form-control", placeholder = "Contract or project name" })
                                @Html.ValidationMessageFor(model => model.ContractName, "", new { @class = "text-danger" })
                            </div>
                        </div>

                        <div class="form-group">
                            <label class="control-label col-md-3">Client</label>
                            <div class="col-md-9">
                                @Html.DropDownList("ExternalClientId", (SelectList)ViewBag.Clients, "-- Select Client --", new { @class = "form-control" })
                            </div>
                        </div>

                        <div class="form-group">
                            @Html.LabelFor(model => model.StartDate, new { @class = "control-label col-md-3" })
                            <div class="col-md-9">
                                @Html.TextBoxFor(model => model.StartDate, "{0:yyyy-MM-dd}", new { @class = "form-control", type = "date" })
                                @Html.ValidationMessageFor(model => model.StartDate, "", new { @class = "text-danger" })
                            </div>
                        </div>

                        <div class="form-group">
                            @Html.LabelFor(model => model.EndDate, new { @class = "control-label col-md-3" })
                            <div class="col-md-9">
                                @Html.TextBoxFor(model => model.EndDate, "{0:yyyy-MM-dd}", new { @class = "form-control", type = "date" })
                                @Html.ValidationMessageFor(model => model.EndDate, "", new { @class = "text-danger" })
                            </div>
                        </div>

                        <div class="form-group">
                            @Html.LabelFor(model => model.TotalBudgetedHours, new { @class = "control-label col-md-3" })
                            <div class="col-md-9">
                                @Html.TextBoxFor(model => model.TotalBudgetedHours, new { @class = "form-control", type = "number", step = "0.1", placeholder = "Total budgeted hours (optional)" })
                                @Html.ValidationMessageFor(model => model.TotalBudgetedHours, "", new { @class = "text-danger" })
                            </div>
                        </div>

                        <div class="form-group">
                            <label class="control-label col-md-3">Contract Type</label>
                            <div class="col-md-9">
                                <div class="well well-sm" style="margin-bottom: 10px; background-color: #f0f7ff; border-color: #5dade2;">
                                    <div class="radio">
                                        <label>
                                            <input type="radio" name="IsActual" value="false" checked="checked" />
                                            <strong>Forecasted Contract</strong>
                                            <span class="text-muted">- Projected work that may or may not happen</span>
                                        </label>
                                    </div>
                                    <div class="radio">
                                        <label>
                                            <input type="radio" name="IsActual" value="true" />
                                            <strong>Actual Contract</strong>
                                            <span class="text-muted">- Confirmed work that is happening or completed</span>
                                        </label>
                                    </div>
                                    <hr style="margin: 10px 0;" />
                                    <small class="text-muted">
                                        <strong>Note:</strong> This determines how the contract appears in Actual vs Forecast reports.
                                        Forecasted contracts represent planned work, while Actual contracts represent confirmed work.
                                    </small>
                                </div>
                            </div>
                        </div>

                        <div class="form-group">
                            <label class="control-label col-md-3">Categorization</label>
                            <div class="col-md-9">
                                <div class="well well-sm" style="margin-bottom: 0;">
                                    <div class="checkbox">
                                        <label>
                                            @Html.CheckBoxFor(model => model.IsRetainer)
                                            <strong>This is a retainer client</strong>
                                        </label>
                                    </div>
                                    <div class="checkbox">
                                        <label>
                                            @Html.CheckBoxFor(model => model.Billable, new { @checked = "checked" })
                                            <strong>This contract is billable</strong>
                                        </label>
                                    </div>
                                    <div class="checkbox">
                                        <label>
                                            @Html.CheckBoxFor(model => model.IsInternal)
                                            <strong>This is an internal project</strong> (only applies if billable)
                                        </label>
                                    </div>
                                    <div class="checkbox">
                                        <label>
                                            <input type="checkbox" name="IncludeInCharts" value="true" checked="checked" />
                                            <strong>Include in Charts</strong>
                                            <span class="text-muted">- Uncheck to create as draft (excluded from utilization charts)</span>
                                        </label>
                                    </div>
                                    <hr style="margin: 10px 0;" />
                                    <small class="text-muted">
                                        <strong>Categorization:</strong><br />
                                        - External Billable = Billable + Not Internal (client work)<br />
                                        - Internal Billable = Billable + Internal (internal projects)<br />
                                        - Non-Billable = Not Billable (training, admin, etc.)
                                    </small>
                                </div>
                            </div>
                        </div>

                        <div class="form-group">
                            @Html.LabelFor(model => model.Notes, new { @class = "control-label col-md-3" })
                            <div class="col-md-9">
                                @Html.TextAreaFor(model => model.Notes, new { @class = "form-control", rows = "3", placeholder = "Optional notes..." })
                                @Html.ValidationMessageFor(model => model.Notes, "", new { @class = "text-danger" })
                            </div>
                        </div>
                    </div>

                    <div class="panel-footer">
                        <div class="form-group">
                            <div class="col-md-offset-3 col-md-9">
                                <button type="submit" class="btn btn-primary">
                                    <i class="glyphicon glyphicon-floppy-disk"></i> Create Contract
                                </button>
                                @Html.ActionLink("Cancel", "Contracts", new { periodId = period.ForecastPeriodID }, new { @class = "btn btn-default" })
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
</div>
