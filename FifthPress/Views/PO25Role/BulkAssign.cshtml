@model FifthPress.Models.ViewModels2.PO25.VM_BulkRoleAssignment25
@{
    ViewBag.Title = "Bulk Role Assignment";
}

<h2>Bulk Role Assignment</h2>

@using (Html.BeginForm("BulkAssign", "PO25Role", FormMethod.Post))
{
    @Html.AntiForgeryToken()

    <div class="form-group">
        <label for="RoleId">Role</label>
        @Html.DropDownListFor(m => m.RoleId, new SelectList(Model.AvailableRoles, "RoleId", "RoleName"), "Select role...", new { @class = "form-control", required = "required" })
    </div>

    <div class="form-group">
        <label for="DepartmentId">Department (if applicable)</label>
        @Html.DropDownListFor(m => m.DepartmentId, Model.Departments, new { @class = "form-control" })
    </div>

    <div class="form-group">
        <label>Select Users</label>
        @for (int i = 0; i < Model.Users.Count; i++)
        {
            <div class="form-check">
                <label class="form-check-label">
                    <input type="checkbox" name="SelectedUserIds" value="@Model.Users[i].Value" class="form-check-input" />
                    @Model.Users[i].Text
                </label>
            </div>
        }
    </div>

    <button type="submit" class="btn btn-primary">Assign Role to Selected Users</button>
    @Html.ActionLink("Cancel", "Index", null, new { @class = "btn btn-secondary ml-2" })
}
