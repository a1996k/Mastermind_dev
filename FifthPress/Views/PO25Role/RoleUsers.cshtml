@model FifthPress.Models.ViewModels2.PO25.VM_RoleUserList25
@{
    ViewBag.Title = "Users with Role";
}

<h2>Users with Role: @Model.RoleName</h2>
<p class="text-muted">@Model.RoleDescription</p>

<table class="table table-bordered">
    <thead>
        <tr>
            <th>User</th>
            <th>Email</th>
            <th>Department</th>
            <th>Assigned</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var user in Model.Users)
        {
            <tr>
                <td>@user.UserName</td>
                <td>@user.Email</td>
                <td>@(string.IsNullOrWhiteSpace(user.DepartmentName) ? "System-wide" : user.DepartmentName)</td>
                <td>@user.AssignedDate.ToShortDateString()</td>
            </tr>
        }
    </tbody>
</table>

@Html.ActionLink("Back to Role List", "Index", null, new { @class = "btn btn-secondary" })
