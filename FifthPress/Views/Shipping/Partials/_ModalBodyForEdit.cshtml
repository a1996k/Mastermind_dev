@model List<OrdersShipped>

<div class="container">
    
    <div class="field-binder-col-flex border-bottom">
        @if (Model.Count > 0)
        {
            <h3 class="ff-poppins fs-14 fw-bold">Orders Shipped for Job #@Html.DisplayFor(model => model.First().Job1.JobNumber)</h3>
            foreach (OrdersShipped os in Model)
            {

                <div class="field-binder-row-flex os-edit-row" data-record-id="@Html.DisplayFor(model => os.Id)">
                    <div class="field-binder-row-flex">
                        @if (os.UserId.HasValue)
                        {
                            <span class="ff-dm-sans fs-12 fw-bold">@Html.DisplayFor(model => os.User.FirstName) @Html.DisplayFor(model => os.User.LastName)</span>
                        }
                    </div>
                    <div class="field-binder-col-flex mins-input">
                        <label class="ff-poppins fs-12">Date</label>
                        <span class="ff-dm-sans fs-12 fw-bold">@os.ShipmentDate.Value.ToLongDateString()</span>
                    </div>
                    <div class="field-binder-col-flex mins-input">
                        <label class="ff-poppins fs-12">Notes</label>
                        @Html.TextAreaFor(model => os.Notes, htmlAttributes: new { @class = "styled-input" })
                    </div>
                    <div class="field-binder-col-flex mins-input">
                        <label class="ff-poppins fs-12">Cost</label>
                        @Html.EditorFor(model => os.FreightCost, new { htmlAttributes = new { @class = "styled-input" } })
                    </div>
                    <div class="field-binder-col-flex mins-input">
                        <label class="ff-poppins fs-12">Markup</label>
                        @Html.EditorFor(model => os.Markup, new { htmlAttributes = new { @class = "styled-input" } })
                    </div>
                    <div class="field-binder-col-flex mins-input">
                        <label class="ff-poppins fs-12">Price</label>
                        @Html.EditorFor(model => os.FreightPrice, new { htmlAttributes = new { @class = "styled-input" } })
                    </div>
                    <div class="field-binder-col-flex">
                        <label class="ff-poppins fs-12">Internal Charge</label>
                        @Html.CheckBoxFor(model => os.InternalCharge.Value)
                    </div>
                </div>
            }
        }
        else
        {
            <p class="ff-dm-sans fs-16 fw-bold">No orders have been shipped for this job.</p>
        }
    </div>
    <div class="field-binder-col-flex">
        @if (Model.Count > 0)
        {
            <button class="btn btn-fc-danger gb-btn" data-modal-to-close="#edit_shipped_orders_modal">Cancel</button>
            <button class="btn btn-success save-shipped-orders" data-modal-to-close="#edit_shipped_orders_modal">Save</button>
        }
    </div>
</div>