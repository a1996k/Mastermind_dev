<div class="field-binder-col-flex">
    <label>Title for Shipment</label>
    <input type="text" name="Title" />
</div>
<div class="field-binder-col-flex">
    <label>Shipment Notes</label>
    <textarea name="Notes"></textarea>
</div>
<div class="field-binder-row-flex">
    <div class="field-binder-col-flex">
        <label>Jobs on Shipment</label>
        <ul name="Jobs" class="jobs">
        </ul>
        <input type="text" class="job-num-autocomplete autocomplete-job" />
        @*<button type="button" class="btn btn-sm btn-fc-info add-job-btn">Add Job</button>*@
    </div>
</div>
<div class="field-binder-col-flex">
    <button type="button" class="btn btn-sm btn-success add-shipment-btn">Save/Add Shipment</button>
</div>