@model List<FifthPress.Models.ViewModels2.PO25.RecurringScheduleViewModel>

@{
    ViewBag.Title = "Recurring Orders";
}

<div class="container-fluid">
    <div class="row">
        <div class="col-md-12">
            <h2><i class="fa fa-repeat"></i> Recurring Orders</h2>
            <hr />

            @if (TempData["Success"] != null)
            {
                <div class="alert alert-success alert-dismissible">
                    <button type="button" class="close" data-dismiss="alert">&times;</button>
                    @TempData["Success"]
                </div>
            }

            @if (TempData["Error"] != null)
            {
                <div class="alert alert-danger alert-dismissible">
                    <button type="button" class="close" data-dismiss="alert">&times;</button>
                    @TempData["Error"]
                </div>
            }

            <div class="row mb-3">
                <div class="col-md-6">
                    <a href="/PO25/CreateRecurring" class="btn btn-primary">Create Recurring Order</a>
                </div>
                <div class="col-md-6 text-right">
                    <a href="/PO25/Index" class="btn btn-default">Back to Purchase Orders</a>
                    <a href="/PO25/ReconciliationDashboard" class="btn btn-warning">Reconciliation Dashboard</a>
                </div>
            </div>

            @if (Model != null && Model.Any())
            {
                <div class="panel panel-default">
                    <div class="panel-heading">
                        <h3 class="panel-title"><i class="fa fa-list"></i> Active Recurring Schedules</h3>
                    </div>
                    <div class="panel-body">
                        <div class="table-responsive">
                            <table class="table table-striped table-hover">
                                <thead>
                                    <tr>
                                        <th>Description</th>
                                        <th>Department</th>
                                        <th>Type</th>
                                        <th>Amount</th>
                                        <th>Frequency</th>
                                        <th>Start Date</th>
                                        <th>End Date</th>
                                        <th>Next Process</th>
                                        <th>Last Processed</th>
                                        <th>Status</th>
                                        <th>Actions</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var schedule in Model)
                                    {
                                        <tr class="@(!schedule.IsActive ? "text-muted" : "")">
                                            <td>
                                                <strong>@schedule.Description</strong>
                                            </td>
                                            <td>@schedule.DepartmentName</td>
                                            <td>
                                                @if (schedule.IsAllocation)
                                                {
                                                    <span class="label label-warning">Allocation</span>
                                                }
                                                else
                                                {
                                                    <span class="label label-info">Fixed Cost</span>
                                                }
                                            </td>
                                            <td>@schedule.FormattedAmount</td>
                                            <td>@schedule.RecurrenceType</td>
                                            <td>@schedule.StartDate.ToString("MM/dd/yyyy")</td>
                                            <td>
                                                @if (schedule.EndDate.HasValue)
                                                {
                                                    @schedule.EndDate.Value.ToString("MM/dd/yyyy")
                                                }
                                                else
                                                {
                                                    <em>Ongoing</em>
                                                }
                                            </td>
                                            <td>
                                                @if (!schedule.IsActive)
                                                {
                                                    @* Show actual parent PO status when inactive *@
                                                    @if (schedule.ParentPOStatus == "Draft")
                                                    {
                                                        <span class="badge badge-secondary">Draft - Not Submitted</span>
                                                    }
                                                    else if (schedule.ParentPOStatus == "Pending")
                                                    {
                                                        <span class="badge badge-warning">Pending Approval</span>
                                                    }
                                                    else if (schedule.ParentPOStatus == "Denied")
                                                    {
                                                        <span class="badge badge-danger">Denied</span>
                                                    }
                                                    else if (schedule.ParentPOStatus == "Approved")
                                                    {
                                                        <span class="badge badge-info">Paused</span>
                                                    }
                                                    else
                                                    {
                                                        <span class="badge badge-secondary">Inactive (@schedule.ParentPOStatus)</span>
                                                    }
                                                }
                                                else if (schedule.NextProcessDate.HasValue && schedule.NextProcessDate.Value > DateTime.Now.Date)
                                                {
                                                    <span class="text-success">@schedule.NextProcessDate.Value.ToString("MM/dd/yyyy")</span>
                                                }
                                                else if (schedule.NextProcessDate.HasValue)
                                                {
                                                    <span class="text-warning">@schedule.NextProcessDate.Value.ToString("MM/dd/yyyy")</span>
                                                }
                                                else
                                                {
                                                    <em>Not scheduled</em>
                                                }
                                            </td>
                                            <td>
                                                @if (schedule.LastProcessedDate.HasValue)
                                                {
                                                    @schedule.LastProcessedDate.Value.ToString("MM/dd/yyyy")
                                                }
                                                else
                                                {
                                                    <em>Never</em>
                                                }
                                            </td>
                                            <td>
                                                @if (schedule.IsActive)
                                                {
                                                    <span class="label label-success">Active</span>
                                                }
                                                else
                                                {
                                                    <span class="label label-default">Inactive</span>
                                                }
                                            </td>
                                            <td>
                                                <div class="action-dropdown">
                                                    <button type="button" class="btn btn-info btn-xs action-toggle">
                                                        Actions <i class="fa fa-caret-down"></i>
                                                    </button>
                                                    <ul class="action-menu">
                                                        @if (schedule.ParentPOStatus == "Draft")
                                                        {
                                                            <li>
                                                                <a href="/PO25/Submit/@schedule.ParentPOId">
                                                                    <i class="fa fa-paper-plane"></i> Submit for Approval
                                                                </a>
                                                            </li>
                                                            <li class="divider"></li>
                                                        }
                                                        <li>
                                                            <a href="/PO25/EditRecurring/@schedule.RecurringId">
                                                                <i class="fa fa-edit"></i> Edit Schedule
                                                            </a>
                                                        </li>
                                                        <li>
                                                            <a href="/PO25/ViewHistory/@schedule.RecurringId">
                                                                <i class="fa fa-history"></i> View History
                                                            </a>
                                                        </li>
                                                        @if (schedule.IsActive)
                                                        {
                                                            <li>
                                                                <a href="#" onclick="pauseSchedule(@schedule.RecurringId); return false;">
                                                                    <i class="fa fa-pause"></i> Pause Schedule
                                                                </a>
                                                            </li>
                                                        }
                                                        else
                                                        {
                                                            <li>
                                                                <a href="#" onclick="activateSchedule(@schedule.RecurringId); return false;">
                                                                    <i class="fa fa-play"></i> Activate Schedule
                                                                </a>
                                                            </li>
                                                        }
                                                        <li class="divider"></li>
                                                        <li>
                                                            <a href="#" onclick="deleteSchedule(@schedule.RecurringId); return false;" class="text-danger">
                                                                <i class="fa fa-trash"></i> Delete Schedule
                                                            </a>
                                                        </li>
                                                    </ul>
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                    <div class="panel-footer">
                        <div class="row">
                            <div class="col-md-6">
                                <small class="text-muted">
                                    Total Active Schedules: @Model.Count(s => s.IsActive) |
                                    Total Monthly Amount: @Model.Where(s => s.IsActive).Sum(s => s.MonthlyAmount).ToString("C")
                                </small>
                            </div>
                            <div class="col-md-6 text-right">
                                <small class="text-muted">
                                    <i class="fa fa-info-circle"></i> Recurring orders are automatically generated based on their next process date
                                </small>
                            </div>
                        </div>
                    </div>
                </div>
            }
            else
            {
                <div class="panel panel-default">
                    <div class="panel-body text-center">
                        <i class="fa fa-repeat fa-3x text-muted"></i>
                        <h4>No Recurring Orders Found</h4>
                        <p class="text-muted">You haven't created any recurring orders yet.</p>
                        <a href="/PO25/CreateRecurring" class="btn btn-primary">Create Your First Recurring Order</a>
                    </div>
                </div>
            }
        </div>
    </div>
</div>

<script>
function pauseSchedule(recurringId) {
    if (confirm('Are you sure you want to pause this recurring schedule? No new orders will be generated until you reactivate it.')) {
        $.post('@Url.Action("PauseSchedule")', { id: recurringId }, function(data) {
            if (data.success) {
                location.reload();
            } else {
                alert('Error: ' + data.message);
            }
        });
    }
}

function activateSchedule(recurringId) {
    if (confirm('Are you sure you want to activate this recurring schedule? Orders will resume being generated automatically.')) {
        $.post('@Url.Action("ActivateSchedule")', { id: recurringId }, function(data) {
            if (data.success) {
                location.reload();
            } else {
                alert('Error: ' + data.message);
            }
        });
    }
}

function deleteSchedule(recurringId) {
    if (confirm('Are you sure you want to delete this recurring schedule? This action cannot be undone.')) {
        $.post('@Url.Action("DeleteSchedule")', { id: recurringId }, function(data) {
            if (data.success) {
                location.reload();
            } else {
                alert('Error: ' + data.message);
            }
        });
    }
}

$(document).ready(function() {
    console.log('RecurringIndex JS loaded, action-toggle count:', $('.action-toggle').length);

    // Auto-dismiss alerts after 5 seconds
    setTimeout(function() {
        $('.alert').fadeOut('slow');
    }, 5000);

    // Custom action dropdown with explicit positioning
    $(document).on('click', '.action-toggle', function(e) {
        console.log('Action toggle clicked!');
        e.preventDefault();
        e.stopPropagation();

        var $btn = $(this);
        var $menu = $btn.siblings('.action-menu');
        var wasOpen = $menu.hasClass('open');

        // Close all menus first
        $('.action-menu').removeClass('open').css({ top: '', left: '', right: '' });

        // Toggle this one with explicit position
        if (!wasOpen) {
            var btnOffset = $btn.offset();
            var btnWidth = $btn.outerWidth();
            var btnHeight = $btn.outerHeight();
            var menuWidth = 180;

            // Position below button, aligned to right edge
            $menu.css({
                position: 'fixed',
                top: (btnOffset.top + btnHeight + 4) + 'px',
                left: (btnOffset.left + btnWidth - menuWidth) + 'px'
            }).addClass('open');

            console.log('Menu positioned at:', btnOffset.top + btnHeight + 4, btnOffset.left + btnWidth - menuWidth);
        }
    });

    // Close when clicking outside
    $(document).on('click', function() {
        $('.action-menu').removeClass('open').css({ top: '', left: '', position: '' });
    });
});
</script>

<style>
    .btn-xs {
        padding: 1px 5px;
        font-size: 12px;
        line-height: 1.5;
        border-radius: 3px;
    }

    .action-dropdown {
        position: relative;
        display: inline-block;
    }

    .action-menu {
        display: none;
        min-width: 180px;
        background: #fff;
        border: 1px solid #ccc;
        border-radius: 4px;
        box-shadow: 0 2px 8px rgba(0,0,0,0.15);
        list-style: none;
        padding: 5px 0;
        z-index: 9999;
        margin: 0;
    }

    .action-menu.open {
        display: block;
    }

    .action-menu li a {
        display: block;
        padding: 6px 15px;
        color: #333;
        text-decoration: none;
        white-space: nowrap;
    }

    .action-menu li a:hover {
        background: #f5f5f5;
    }

    .action-menu li a.text-danger {
        color: #d9534f;
    }

    .action-menu .divider {
        height: 1px;
        margin: 5px 0;
        background: #e5e5e5;
    }

    .table td, .table th {
        vertical-align: middle;
        padding: 12px !important;
    }

    .table thead th {
        padding: 15px 12px !important;
    }
</style>