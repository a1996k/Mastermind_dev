@model FifthPress.Models.ViewModels2.PO25.ReconciliationDashboardViewModel

@{
    ViewBag.Title = "Monthly Reconciliation Dashboard";
}

<div class="container-fluid">
    <div class="row">
        <div class="col-md-12">
            <h2><i class="fa fa-calculator"></i> Monthly Reconciliation Dashboard</h2>
            <h4 class="text-muted">@Model.MonthName</h4>
            <hr />

            @if (TempData["Success"] != null)
            {
                <div class="alert alert-success alert-dismissible">
                    <button type="button" class="close" data-dismiss="alert">&times;</button>
                    @TempData["Success"]
                </div>
            }

            @if (TempData["Error"] != null)
            {
                <div class="alert alert-danger alert-dismissible">
                    <button type="button" class="close" data-dismiss="alert">&times;</button>
                    @TempData["Error"]
                </div>
            }
        </div>
    </div>

    <!-- Summary Cards -->
    <div class="row">
        <div class="col-md-3">
            <div class="panel panel-primary">
                <div class="panel-heading">
                    <h3 class="panel-title"><i class="fa fa-money"></i> Total Allocated</h3>
                </div>
                <div class="panel-body text-center">
                    <h3>@Model.FormattedTotalAllocated</h3>
                    <p class="text-muted">Budget allocated this month</p>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="panel panel-success">
                <div class="panel-heading">
                    <h3 class="panel-title"><i class="fa fa-credit-card"></i> Total Spent</h3>
                </div>
                <div class="panel-body text-center">
                    <h3>@Model.FormattedTotalSpent</h3>
                    <p class="text-muted">Actual amount spent</p>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="panel panel-@(Model.TotalVariance >= 0 ? "warning" : "info")">
                <div class="panel-heading">
                    <h3 class="panel-title"><i class="fa fa-bar-chart"></i> Variance</h3>
                </div>
                <div class="panel-body text-center">
                    <h3 class="@Model.TotalVarianceClass">@Model.FormattedTotalVariance</h3>
                    <p class="text-muted">
                        @if (Model.TotalVariance > 0)
                        {
                            <span>Over allocated</span>
                        }
                        else if (Model.TotalVariance < 0)
                        {
                            <span>Under allocated</span>
                        }
                        else
                        {
                            <span>On target</span>
                        }
                    </p>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="panel panel-@(Model.UnreconciledCount > 0 ? "danger" : "success")">
                <div class="panel-heading">
                    <h3 class="panel-title"><i class="fa fa-exclamation-triangle"></i> Status</h3>
                </div>
                <div class="panel-body text-center">
                    <h3>@Model.UnreconciledCount</h3>
                    <p class="text-muted">
                        @if (Model.UnreconciledCount > 0)
                        {
                            <span>Items need reconciliation</span>
                        }
                        else
                        {
                            <span>All items reconciled</span>
                        }
                    </p>
                </div>
            </div>
        </div>
    </div>

    <!-- Navigation -->
    <div class="row">
        <div class="col-md-12">
            <div class="btn-group" role="group">
                @Html.ActionLink("Back to Orders", "Index", null, new { @class = "btn btn-default" })
                @Html.ActionLink("Export Report", "ExportReconciliation", new { year = Model.CurrentYear, month = Model.CurrentMonth }, new { @class = "btn btn-info" })

                @if (Model.UnreconciledCount == 0 && Model.ReconciliationItems.Any())
                {
                    <button type="button" class="btn btn-success" onclick="finalizeReconciliation()">
                        <i class="fa fa-check"></i> Finalize Month
                    </button>
                }
            </div>
        </div>
    </div>
    <br />

    <!-- Reconciliation Items -->
    @if (Model.ReconciliationItems != null && Model.ReconciliationItems.Any())
    {
        <div class="panel panel-default">
            <div class="panel-heading">
                <h3 class="panel-title"><i class="fa fa-list"></i> Allocation Reconciliation Items</h3>
            </div>
            <div class="panel-body">
                <div class="table-responsive">
                    <table class="table table-striped table-hover">
                        <thead>
                            <tr>
                                <th>Description</th>
                                <th>Department</th>
                                <th>Allocated Amount</th>
                                <th>Actual Spent</th>
                                <th>Variance</th>
                                <th>Status</th>
                                <th>Reconciled Date</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model.ReconciliationItems)
                            {
                                <tr class="@(item.IsReconciled ? "" : "warning")" data-reconciliation-id="@item.ReconciliationId">
                                    <td>
                                        <strong>@item.Description</strong>
                                    </td>
                                    <td>@item.DepartmentName</td>
                                    <td>@item.FormattedAllocated</td>
                                    <td>
                                        @if (item.IsReconciled)
                                        {
                                            @item.FormattedActual
                                        }
                                        else
                                        {
                                            <div class="input-group input-group-sm">
                                                <span class="input-group-addon">$</span>
                                                <input type="number" class="form-control actual-spent"
                                                       value="@(item.ActualSpent?.ToString("F2") ?? "")"
                                                       step="0.01" min="0"
                                                       placeholder="Enter amount" />
                                            </div>
                                        }
                                    </td>
                                    <td>
                                        <span class="variance-display @item.VarianceClass">@item.FormattedVariance</span>
                                    </td>
                                    <td>
                                        @if (item.IsReconciled)
                                        {
                                            <span class="label label-success">Reconciled</span>
                                        }
                                        else
                                        {
                                            <span class="label label-warning">Pending</span>
                                        }
                                    </td>
                                    <td>
                                        @if (item.ReconciliationDate.HasValue)
                                        {
                                            @item.ReconciliationDate.Value.ToString("MM/dd/yyyy")
                                        }
                                        else
                                        {
                                            <em>Not reconciled</em>
                                        }
                                    </td>
                                    <td>
                                        @if (!item.IsReconciled)
                                        {
                                            <button type="button" class="btn btn-sm btn-success reconcile-btn"
                                                    data-reconciliation-id="@item.ReconciliationId"
                                                    data-allocated="@item.AllocatedAmount">
                                                <i class="fa fa-check"></i> Reconcile
                                            </button>
                                        }
                                        else
                                        {
                                            <button type="button" class="btn btn-sm btn-warning unrereconcile-btn"
                                                    data-reconciliation-id="@item.ReconciliationId">
                                                <i class="fa fa-undo"></i> Edit
                                            </button>
                                        }

                                        @if (!string.IsNullOrEmpty(item.ReconciliationNotes))
                                        {
                                            <button type="button" class="btn btn-sm btn-info"
                                                    data-toggle="tooltip"
                                                    title="@item.ReconciliationNotes">
                                                <i class="fa fa-comment"></i>
                                            </button>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    }
    else
    {
        <div class="panel panel-default">
            <div class="panel-body text-center">
                <i class="fa fa-calculator fa-3x text-muted"></i>
                <h4>No Allocation Items for Reconciliation</h4>
                <p class="text-muted">There are no allocation items requiring reconciliation for @Model.MonthName.</p>
                @Html.ActionLink("View Recurring Orders", "RecurringIndex", null, new { @class = "btn btn-primary" })
            </div>
        </div>
    }
</div>

<!-- Notes Modal -->
<div class="modal fade" id="notesModal" tabindex="-1" role="dialog">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal">&times;</button>
                <h4 class="modal-title">Reconciliation Notes</h4>
            </div>
            <div class="modal-body">
                <div class="form-group">
                    <label for="reconciliationNotes">Notes (optional):</label>
                    <textarea class="form-control" id="reconciliationNotes" rows="3" placeholder="Add any notes about this reconciliation..."></textarea>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-default" data-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-primary" id="saveReconciliation">Save Reconciliation</button>
            </div>
        </div>
    </div>
</div>

<script>
var currentReconciliationId = null;
var currentActualAmount = null;

$(document).ready(function() {
    // Initialize tooltips
    $('[data-toggle="tooltip"]').tooltip();

    // Handle actual spent input changes
    $('.actual-spent').on('input', function() {
        var row = $(this).closest('tr');
        var allocated = parseFloat(row.find('.reconcile-btn').data('allocated'));
        var actual = parseFloat($(this).val()) || 0;
        var variance = actual - allocated;

        var varianceDisplay = row.find('.variance-display');
        varianceDisplay.text('
                 + variance.toFixed(2));

        // Update variance class
        varianceDisplay.removeClass('text-success text-danger text-muted');
        if (variance > 0) {
            varianceDisplay.addClass('text-danger');
        } else if (variance < 0) {
            varianceDisplay.addClass('text-success');
        } else {
            varianceDisplay.addClass('text-muted');
        }
    });

    // Handle reconcile button click
    $('.reconcile-btn').click(function() {
        var row = $(this).closest('tr');
        var actualSpentInput = row.find('.actual-spent');
        var actualAmount = parseFloat(actualSpentInput.val());

        if (isNaN(actualAmount) || actualAmount < 0) {
            alert('Please enter a valid amount spent.');
            actualSpentInput.focus();
            return;
        }

        currentReconciliationId = $(this).data('reconciliation-id');
        currentActualAmount = actualAmount;

        $('#notesModal').modal('show');
    });

    // Handle save reconciliation
    $('#saveReconciliation').click(function() {
        var notes = $('#reconciliationNotes').val();

        $.ajax({
            url: '@Url.Action("UpdateReconciliation")',
            type: 'POST',
            data: {
                reconciliationId: currentReconciliationId,
                actualSpent: currentActualAmount,
                notes: notes,
                __RequestVerificationToken: $('input[name="__RequestVerificationToken"]').val()
            },
            success: function(data) {
                if (data.success) {
                    $('#notesModal').modal('hide');
                    location.reload();
                } else {
                    alert('Error: ' + data.message);
                }
            },
            error: function() {
                alert('An error occurred while saving the reconciliation.');
            }
        });
    });

    // Handle unreoncile (edit) button click
    $('.unreoncile-btn').click(function() {
        var reconciliationId = $(this).data('reconciliation-id');
        if (confirm('Are you sure you want to edit this reconciliation? This will mark it as unreconciled.')) {
            $.ajax({
                url: '@Url.Action("UnreconcileItem")',
                type: 'POST',
                data: {
                    reconciliationId: reconciliationId,
                    __RequestVerificationToken: $('input[name="__RequestVerificationToken"]').val()
                },
                success: function(data) {
                    if (data.success) {
                        location.reload();
                    } else {
                        alert('Error: ' + data.message);
                    }
                },
                error: function() {
                    alert('An error occurred while editing the reconciliation.');
                }
            });
        }
    });

    // Clear notes when modal is hidden
    $('#notesModal').on('hidden.bs.modal', function() {
        $('#reconciliationNotes').val('');
        currentReconciliationId = null;
        currentActualAmount = null;
    });

    // Auto-dismiss alerts after 5 seconds
    setTimeout(function() {
        $('.alert').fadeOut('slow');
    }, 5000);
});

function finalizeReconciliation() {
    if (confirm('Are you sure you want to finalize this month\'s reconciliation? This will lock the data and prevent further changes.')) {
        $.ajax({
            url: '@Url.Action("FinalizeReconciliation")',
            type: 'POST',
            data: {
                year: @Model.CurrentYear,
                month: @Model.CurrentMonth,
                __RequestVerificationToken: $('input[name="__RequestVerificationToken"]').val()
            },
            success: function(data) {
                if (data.success) {
                    alert('Month finalized successfully!');
                    location.reload();
                } else {
                    alert('Error: ' + data.message);
                }
            },
            error: function() {
                alert('An error occurred while finalizing the month.');
            }
        });
    }
}
</script>

@Html.AntiForgeryToken()

<style>
    .panel-body .input-group-sm {
        width: 120px;
    }

    .variance-display {
        font-weight: bold;
    }

    .modal-body .form-group {
        margin-bottom: 15px;
    }

    .btn-group {
        margin-bottom: 15px;
    }

    .table td {
        vertical-align: middle;
    }

    .warning {
        background-color: #fcf8e3 !important;
    }
</style>