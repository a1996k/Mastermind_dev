@model FifthPress.Models.ViewModels2.PO25.VM_AmendTaxFreight25
@{
    ViewBag.Title = "Amend Tax/Freight";
}

<div class="container-fluid">
    <div class="row">
        <div class="col-md-12">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h2>Amend Tax/Freight - PO #@Model.PONumber</h2>
                <span class="badge badge-success badge-lg">Approved</span>
            </div>

            @if (TempData["SuccessMessage"] != null)
            {
                <div class="alert alert-success alert-dismissible">
                    <button type="button" class="close" data-dismiss="alert">&times;</button>
                    @TempData["SuccessMessage"]
                </div>
            }

            @if (TempData["ErrorMessage"] != null)
            {
                <div class="alert alert-danger alert-dismissible">
                    <button type="button" class="close" data-dismiss="alert">&times;</button>
                    @TempData["ErrorMessage"]
                </div>
            }

            <div class="row">
                <div class="col-md-8">
                    @using (Html.BeginForm("AmendTaxFreight", "PO25", FormMethod.Post, new { @class = "form-horizontal", role = "form" }))
                    {
                        @Html.AntiForgeryToken()
                        @Html.HiddenFor(m => m.PO_OrderId)
                        @Html.HiddenFor(m => m.CurrentFreightAmount)
                        @Html.HiddenFor(m => m.CurrentTaxAmount)
                        @Html.HiddenFor(m => m.CurrentTaxRate)
                        @Html.HiddenFor(m => m.CurrentIsTaxPercentage)
                        @Html.HiddenFor(m => m.SubtotalAmount)

                        <div class="card">
                            <div class="card-header">
                                <h4>PO Information</h4>
                            </div>
                            <div class="card-body">
                                <div class="row">
                                    <div class="col-md-4">
                                        <strong>Vendor:</strong><br />
                                        @Model.VendorName
                                    </div>
                                    <div class="col-md-4">
                                        <strong>Department:</strong><br />
                                        @Model.DepartmentName
                                    </div>
                                    <div class="col-md-4">
                                        <strong>Subtotal:</strong><br />
                                        @Model.SubtotalAmount.ToString("C")
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="card mt-3">
                            <div class="card-header bg-warning">
                                <h4 class="mb-0">Amendment Details</h4>
                            </div>
                            <div class="card-body">
                                <div class="alert alert-info">
                                    <i class="fas fa-info-circle"></i>
                                    You are amending an approved PO. All changes will be logged with your reason for the amendment.
                                </div>

                                <div class="row">
                                    <div class="col-md-6">
                                        <h5>Current Values</h5>
                                        <table class="table table-sm table-bordered">
                                            <tr>
                                                <td>Freight:</td>
                                                <td class="text-right">@(Model.CurrentFreightAmount?.ToString("C") ?? "$0.00")</td>
                                            </tr>
                                            <tr>
                                                <td>Tax:</td>
                                                <td class="text-right">
                                                    @if (Model.CurrentIsTaxPercentage)
                                                    {
                                                        @(Model.CurrentTaxRate?.ToString("F2") ?? "0")@:%
                                                    }
                                                    else
                                                    {
                                                        @(Model.CurrentTaxAmount?.ToString("C") ?? "$0.00")
                                                    }
                                                </td>
                                            </tr>
                                            <tr class="table-active">
                                                <td><strong>Current Total:</strong></td>
                                                <td class="text-right"><strong>@Model.CurrentTotal.ToString("C")</strong></td>
                                            </tr>
                                        </table>
                                    </div>
                                    <div class="col-md-6">
                                        <h5>New Values</h5>
                                        <div class="form-group">
                                            @Html.LabelFor(m => m.NewFreightAmount, "New Freight Amount", new { @class = "control-label" })
                                            @Html.TextBoxFor(m => m.NewFreightAmount, new { @class = "form-control freight-input", @type = "number", @step = "0.01", @min = "0", @placeholder = "0.00" })
                                        </div>

                                        <div class="form-check mb-2">
                                            @Html.CheckBoxFor(m => m.IsTaxPercentage, new { @class = "form-check-input", @id = "IsTaxPercentage" })
                                            @Html.LabelFor(m => m.IsTaxPercentage, "Tax by Percentage", new { @class = "form-check-label" })
                                        </div>

                                        <div class="form-group" id="taxRateGroup">
                                            @Html.LabelFor(m => m.NewTaxRate, "New Tax Rate", new { @class = "control-label" })
                                            <div class="input-group">
                                                @Html.TextBoxFor(m => m.NewTaxRate, new { @class = "form-control tax-rate-input", @type = "number", @step = "0.01", @min = "0", @max = "100", @placeholder = "0.00" })
                                                <div class="input-group-append">
                                                    <span class="input-group-text">%</span>
                                                </div>
                                            </div>
                                        </div>

                                        <div class="form-group" id="taxAmountGroup" style="display:none;">
                                            @Html.LabelFor(m => m.NewTaxAmount, "New Tax Amount", new { @class = "control-label" })
                                            @Html.TextBoxFor(m => m.NewTaxAmount, new { @class = "form-control tax-amount-input", @type = "number", @step = "0.01", @min = "0", @placeholder = "0.00" })
                                        </div>

                                        <table class="table table-sm table-bordered mt-3">
                                            <tr class="table-success">
                                                <td><strong>New Total:</strong></td>
                                                <td class="text-right"><strong id="newTotalDisplay">@Model.NewTotal.ToString("C")</strong></td>
                                            </tr>
                                        </table>
                                    </div>
                                </div>

                                <hr />

                                <div class="form-group">
                                    @Html.LabelFor(m => m.Reason, "Reason for Amendment", new { @class = "control-label" })
                                    <span class="text-danger">*</span>
                                    @Html.TextAreaFor(m => m.Reason, new { @class = "form-control", @rows = "3", @placeholder = "Please provide a reason for this amendment...", @required = "required" })
                                    @Html.ValidationMessageFor(m => m.Reason, "", new { @class = "text-danger" })
                                </div>
                            </div>
                        </div>

                        <div class="card mt-3">
                            <div class="card-body">
                                <div class="row">
                                    <div class="col-md-6">
                                        @Html.ActionLink("Cancel", "Details", new { id = Model.PO_OrderId }, new { @class = "btn btn-secondary" })
                                    </div>
                                    <div class="col-md-6 text-right">
                                        <button type="submit" class="btn btn-warning">
                                            <i class="fa fa-save"></i> Save Amendment
                                        </button>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                </div>

                <div class="col-md-4">
                    @if (Model.AmendmentHistory != null && Model.AmendmentHistory.Any())
                    {
                        <div class="card">
                            <div class="card-header">
                                <h5 class="mb-0">Amendment History</h5>
                            </div>
                            <div class="card-body p-0">
                                <div class="list-group list-group-flush">
                                    @foreach (var amendment in Model.AmendmentHistory)
                                    {
                                        <div class="list-group-item">
                                            <div class="d-flex w-100 justify-content-between">
                                                <h6 class="mb-1">@amendment.AmendmentTypeDescription</h6>
                                                <small class="text-muted">@amendment.AmendedDate.ToString("M/d/yyyy h:mm tt")</small>
                                            </div>
                                            <p class="mb-1">@amendment.ChangeDescription</p>
                                            <small>
                                                <strong>By:</strong> @amendment.AmendedBy<br />
                                                @if (!string.IsNullOrEmpty(amendment.Reason))
                                                {
                                                    <strong>Reason:</strong> @amendment.Reason
                                                }
                                            </small>
                                        </div>
                                    }
                                </div>
                            </div>
                        </div>
                    }
                    else
                    {
                        <div class="card">
                            <div class="card-header">
                                <h5 class="mb-0">Amendment History</h5>
                            </div>
                            <div class="card-body">
                                <p class="text-muted mb-0">No previous amendments for this PO.</p>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

<script>
$(document).ready(function () {
    var subtotal = @Model.SubtotalAmount;

    // Toggle between percentage and fixed amount for tax
    $('#IsTaxPercentage').change(function () {
        if ($(this).is(':checked')) {
            $('#taxRateGroup').show();
            $('#taxAmountGroup').hide();
            $('.tax-amount-input').val('');
        } else {
            $('#taxRateGroup').hide();
            $('#taxAmountGroup').show();
            $('.tax-rate-input').val('');
        }
        updateNewTotal();
    });

    // Initial state for tax fields
    if ($('#IsTaxPercentage').is(':checked')) {
        $('#taxRateGroup').show();
        $('#taxAmountGroup').hide();
    } else {
        $('#taxRateGroup').hide();
        $('#taxAmountGroup').show();
    }

    // Update total when values change
    $(document).on('input', '.freight-input, .tax-rate-input, .tax-amount-input', function () {
        updateNewTotal();
    });

    function updateNewTotal() {
        var freight = parseFloat($('.freight-input').val()) || 0;
        var isTaxPercentage = $('#IsTaxPercentage').is(':checked');
        var taxAmount = 0;

        if (isTaxPercentage) {
            var taxRate = parseFloat($('.tax-rate-input').val()) || 0;
            taxAmount = subtotal * (taxRate / 100);
        } else {
            taxAmount = parseFloat($('.tax-amount-input').val()) || 0;
        }

        var total = subtotal + freight + taxAmount;
        $('#newTotalDisplay').text('$' + total.toFixed(2));
    }

    // Initial calculation
    updateNewTotal();
});
</script>

<style>
    .badge-lg {
        font-size: 0.9rem;
        padding: 0.5rem 0.75rem;
    }
</style>
