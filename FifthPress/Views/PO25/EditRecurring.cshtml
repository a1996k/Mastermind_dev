@model FifthPress.Models.ViewModels2.PO25.EditRecurringScheduleViewModel

@{
    ViewBag.Title = "Edit Recurring Schedule";
}

<div class="container-fluid">
    <div class="row">
        <div class="col-md-12">
            <h2><i class="fa fa-edit"></i> Edit Recurring Schedule</h2>
            <hr />

            @if (TempData["Error"] != null)
            {
                <div class="alert alert-danger alert-dismissible">
                    <button type="button" class="close" data-dismiss="alert">&times;</button>
                    @TempData["Error"]
                </div>
            }

            @using (Html.BeginForm("EditRecurring", "PO25", FormMethod.Post))
            {
                @Html.AntiForgeryToken()
                @Html.HiddenFor(m => m.RecurringId)
                @Html.HiddenFor(m => m.StartDate) // Start date shouldn't be editable after creation

                <div class="panel panel-primary">
                    <div class="panel-heading">
                        <h3 class="panel-title"><i class="fa fa-info-circle"></i> Schedule Information</h3>
                    </div>
                    <div class="panel-body">
                        <div class="row">
                            <div class="col-md-6">
                                <div class="form-group">
                                    @Html.LabelFor(m => m.VendorId, "Vendor", new { @class = "control-label" })
                                    <div class="input-group">
                                        @Html.DropDownListFor(m => m.VendorId, Model.Vendors, "-- Select Vendor --", new { @class = "form-control", id = "VendorDropdown", required = "required" })
                                        <div class="input-group-btn">
                                            <button type="button" class="btn btn-success" id="addVendorBtn" title="Add New Vendor">
                                                <i class="fa fa-plus"></i> Add
                                            </button>
                                        </div>
                                    </div>
                                    @Html.ValidationMessageFor(m => m.VendorId, "", new { @class = "text-danger" })
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-group">
                                    @Html.LabelFor(m => m.DepartmentId, "Department", new { @class = "control-label" })
                                    @Html.DropDownListFor(m => m.DepartmentId, Model.Departments, "Select Department...", new { @class = "form-control", required = "required" })
                                    @Html.ValidationMessageFor(m => m.DepartmentId, "", new { @class = "text-danger" })
                                </div>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-12">
                                <div class="form-group">
                                    @Html.LabelFor(m => m.Description, "Description", new { @class = "control-label" })
                                    @Html.TextBoxFor(m => m.Description, new { @class = "form-control", required = "required" })
                                    @Html.ValidationMessageFor(m => m.Description, "", new { @class = "text-danger" })
                                </div>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-4">
                                <div class="form-group">
                                    @Html.LabelFor(m => m.MonthlyAmount, "Monthly Amount", new { @class = "control-label" })
                                    <div class="input-group">
                                        <span class="input-group-addon">$</span>
                                        @Html.TextBoxFor(m => m.MonthlyAmount, new { @class = "form-control", type = "number", step = "0.01", min = "0", required = "required" })
                                    </div>
                                    @Html.ValidationMessageFor(m => m.MonthlyAmount, "", new { @class = "text-danger" })
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="form-group">
                                    @Html.LabelFor(m => m.RecurrenceType, "Recurrence Type", new { @class = "control-label" })
                                    @Html.DropDownListFor(m => m.RecurrenceType, Model.RecurrenceTypes, new { @class = "form-control", required = "required" })
                                    @Html.ValidationMessageFor(m => m.RecurrenceType, "", new { @class = "text-danger" })
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="form-group">
                                    @Html.LabelFor(m => m.EndDate, "End Date", new { @class = "control-label" })
                                    @Html.TextBoxFor(m => m.EndDate, new { @class = "form-control", type = "date" })
                                    <small class="text-muted">Leave blank for ongoing</small>
                                    @Html.ValidationMessageFor(m => m.EndDate, "", new { @class = "text-danger" })
                                </div>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-6">
                                <div class="form-group">
                                    <label class="control-label">Start Date</label>
                                    <p class="form-control-static">@Model.StartDate.ToString("MM/dd/yyyy")</p>
                                    <small class="text-muted">Start date cannot be changed after creation</small>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-group">
                                    <div class="checkbox" style="margin-top: 25px;">
                                        <label>
                                            @Html.CheckBoxFor(m => m.IsActive)
                                            <strong>Schedule is active</strong><br>
                                            <small class="text-muted">Uncheck to pause automatic order generation</small>
                                        </label>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-12">
                                <div class="form-group">
                                    <div class="checkbox">
                                        <label>
                                            @Html.CheckBoxFor(m => m.IsAllocation)
                                            <strong>This is an allocation (requires monthly reconciliation)</strong><br>
                                            <small class="text-muted">Check this if the amount is a budget allocation rather than a fixed cost</small>
                                        </label>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Warning Panel for Changes -->
                <div class="panel panel-warning">
                    <div class="panel-heading">
                        <h3 class="panel-title"><i class="fa fa-exclamation-triangle"></i> Important Notes</h3>
                    </div>
                    <div class="panel-body">
                        <ul>
                            <li><strong>Amount Changes:</strong> Will apply to future orders only. Past orders remain unchanged.</li>
                            <li><strong>Recurrence Changes:</strong> Next process date will be recalculated based on the new frequency.</li>
                            <li><strong>Allocation Type:</strong> Changing between allocation and fixed cost affects reconciliation requirements.</li>
                            <li><strong>Pausing Schedule:</strong> Will prevent new orders from being generated until reactivated.</li>
                        </ul>
                    </div>
                </div>

                <div class="panel panel-default">
                    <div class="panel-body text-center">
                        <button type="submit" class="btn btn-primary btn-lg">
                            <i class="fa fa-save"></i> Save Changes
                        </button>
                        @Html.ActionLink("Cancel", "Index", null, new { @class = "btn btn-default btn-lg" })
                    </div>
                </div>
            }
        </div>
    </div>
</div>

<script>
$(document).ready(function() {
    // Show/hide reconciliation info based on allocation checkbox
    $('#IsAllocation').change(function() {
        if ($(this).is(':checked')) {
            showAllocationInfo();
        } else {
            hideAllocationInfo();
        }
    });

    function showAllocationInfo() {
        if ($('#allocationInfo').length === 0) {
            var infoPanel = $('<div id="allocationInfo" class="alert alert-info">' +
                '<h5><i class="fa fa-info-circle"></i> Allocation Information</h5>' +
                '<p>Since this is marked as an allocation:</p>' +
                '<ul>' +
                '<li>Monthly reconciliation will be required</li>' +
                '<li>You\'ll need to enter actual spending amounts each month</li>' +
                '<li>Variance tracking will be available in reports</li>' +
                '<li>Unused allocation amounts will not roll over to future months</li>' +
                '</ul>' +
                '</div>');
            $('.panel-warning').before(infoPanel);
        }
    }

    function hideAllocationInfo() {
        $('#allocationInfo').remove();
    }

    // Initialize on page load
    if ($('#IsAllocation').is(':checked')) {
        showAllocationInfo();
    }

    // Validate end date is after start date
    $('#EndDate').change(function() {
        var startDate = new Date('@Model.StartDate.ToString("yyyy-MM-dd")');
        var endDate = new Date($(this).val());

        if (endDate && endDate <= startDate) {
            alert('End date must be after the start date (' + startDate.toLocaleDateString() + ')');
            $(this).val('');
        }
    });

    // Auto-dismiss alerts after 5 seconds
    setTimeout(function() {
        $('.alert-danger').fadeOut('slow');
    }, 5000);

    // Vendor addition functionality
    $('#addVendorBtn').click(function() {
        // Load states dropdown if not already loaded
        if ($('#vendorState option').length === 1) {
            $.ajax({
                url: '@Url.Action("GetStates", "Vendors")',
                type: 'GET',
                success: function(states) {
                    $.each(states, function(index, state) {
                        $('#vendorState').append($('<option></option>')
                            .attr('value', state.Value)
                            .text(state.Text));
                    });
                },
                error: function() {
                    console.error('Failed to load states');
                }
            });
        }
        $('#addVendorModal').modal('show');
    });

    $('#saveVendorBtn').click(function() {
        var vendorData = {
            Title: $('#vendorTitle').val(),
            ContactName: $('#vendorContactName').val(),
            Phone: $('#vendorPhone').val(),
            Address: $('#vendorAddress').val(),
            City: $('#vendorCity').val(),
            State: $('#vendorState').val(),
            Zip: $('#vendorZip').val(),
            Email: $('#vendorEmail').val(),
            WebAddress: $('#vendorWebAddress').val(),
            Notes: $('#vendorNotes').val()
        };

        if (!vendorData.Title) {
            alert('Vendor name is required.');
            return;
        }

        $.ajax({
            url: '@Url.Action("AddVendor", "Vendors")',
            type: 'POST',
            data: vendorData,
            success: function(response) {
                if (response.success) {
                    // Add new option to dropdown
                    var newOption = new Option(response.vendor.title, response.vendor.id, true, true);
                    $('#VendorDropdown').append(newOption).trigger('change');

                    // Close modal and reset form
                    $('#addVendorModal').modal('hide');
                    $('#addVendorForm')[0].reset();

                    alert(response.message);
                } else {
                    alert('Error: ' + response.message);
                }
            },
            error: function() {
                alert('An error occurred while adding the vendor.');
            }
        });
    });
});
</script>

<!-- Add Vendor Modal -->
<div class="modal fade" id="addVendorModal" tabindex="-1" role="dialog" aria-labelledby="addVendorModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
                <h4 class="modal-title" id="addVendorModalLabel"><i class="fa fa-plus-circle"></i> Add New Vendor</h4>
            </div>
            <div class="modal-body">
                <form id="addVendorForm">
                    <div class="row">
                        <div class="col-md-6">
                            <div class="form-group">
                                <label for="vendorTitle">Vendor Name <span class="text-danger">*</span></label>
                                <input type="text" class="form-control" id="vendorTitle" required>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-group">
                                <label for="vendorContactName">Contact Name</label>
                                <input type="text" class="form-control" id="vendorContactName">
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-6">
                            <div class="form-group">
                                <label for="vendorPhone">Phone</label>
                                <input type="tel" class="form-control" id="vendorPhone">
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-group">
                                <label for="vendorEmail">Email</label>
                                <input type="email" class="form-control" id="vendorEmail">
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-12">
                            <div class="form-group">
                                <label for="vendorAddress">Address</label>
                                <input type="text" class="form-control" id="vendorAddress">
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-5">
                            <div class="form-group">
                                <label for="vendorCity">City</label>
                                <input type="text" class="form-control" id="vendorCity">
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="form-group">
                                <label for="vendorState">State</label>
                                <select class="form-control" id="vendorState">
                                    <option value="">-- Select State --</option>
                                </select>
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="form-group">
                                <label for="vendorZip">Zip Code</label>
                                <input type="text" class="form-control" id="vendorZip">
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-12">
                            <div class="form-group">
                                <label for="vendorWebAddress">Website</label>
                                <input type="url" class="form-control" id="vendorWebAddress" placeholder="https://...">
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-12">
                            <div class="form-group">
                                <label for="vendorNotes">Notes</label>
                                <textarea class="form-control" id="vendorNotes" rows="3"></textarea>
                            </div>
                        </div>
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-default" data-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-primary" id="saveVendorBtn">
                    <i class="fa fa-save"></i> Save Vendor
                </button>
            </div>
        </div>
    </div>
</div>

<style>
    .form-control-static {
        font-weight: bold;
        color: #555;
    }

    .input-group-addon {
        background-color: #f5f5f5;
    }

    .checkbox {
        padding-top: 7px;
    }

    .panel-body ul {
        margin-bottom: 0;
    }

    .alert ul {
        margin-bottom: 0;
    }

    #allocationInfo {
        margin-top: 15px;
    }
</style>