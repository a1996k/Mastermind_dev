@model FifthPress.Models.ViewModels2.PO25.ReconciliationHistoryPageViewModel

@{
    ViewBag.Title = "Reconciliation History";
}

<div class="container-fluid">
    <div class="row">
        <div class="col-md-12">
            <h2><i class="fa fa-history"></i> Reconciliation History</h2>
            <h4 class="text-muted">@Model.MonthName</h4>
            <hr />

            @if (TempData["Success"] != null)
            {
                <div class="alert alert-success alert-dismissible">
                    <button type="button" class="close" data-dismiss="alert">&times;</button>
                    @TempData["Success"]
                </div>
            }

            @if (TempData["Error"] != null)
            {
                <div class="alert alert-danger alert-dismissible">
                    <button type="button" class="close" data-dismiss="alert">&times;</button>
                    @TempData["Error"]
                </div>
            }
        </div>
    </div>

    <!-- Navigation -->
    <div class="row">
        <div class="col-md-8">
            <div class="btn-group" role="group">
                <a href="@Url.Action("ReconciliationDashboard")" class="btn btn-@(Model.IsCurrentMonth ? "primary" : "default")">
                    <i class="fa fa-calendar"></i> Current Month
                </a>
                <a href="@Url.Action("ReconciliationHistory")" class="btn btn-@(!Model.IsCurrentMonth ? "primary" : "default")">
                    <i class="fa fa-history"></i> History
                </a>
                <a href="@Url.Action("Index")" class="btn btn-default">
                    <i class="fa fa-arrow-left"></i> Back to Orders
                </a>
            </div>
        </div>
        <div class="col-md-4">
            <div class="form-group">
                <select class="form-control" id="periodSelector" onchange="changePeriod()">
                    <option value="">Select a period...</option>
                    @foreach (var period in Model.AvailablePeriods)
                    {
                        <option value="@Url.Action("ReconciliationHistory", new { year = period.Year, month = period.Month })"
                                @(period.Year == Model.SelectedYear && period.Month == Model.SelectedMonth ? "selected" : "")>
                            @period.MonthName - <span class="@period.StatusClass">@period.CompletionStatus</span>
                        </option>
                    }
                </select>
            </div>
        </div>
    </div>

    <!-- Summary Cards -->
    <div class="row">
        <div class="col-md-3">
            <div class="panel panel-primary">
                <div class="panel-heading">
                    <h3 class="panel-title"><i class="fa fa-money"></i> Total Allocated</h3>
                </div>
                <div class="panel-body text-center">
                    <h3>@Model.FormattedTotalAllocated</h3>
                    <p class="text-muted">Budget allocated</p>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="panel panel-success">
                <div class="panel-heading">
                    <h3 class="panel-title"><i class="fa fa-credit-card"></i> Total Spent</h3>
                </div>
                <div class="panel-body text-center">
                    <h3>@Model.FormattedTotalSpent</h3>
                    <p class="text-muted">Actual amount spent</p>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="panel panel-@(Model.TotalVariance >= 0 ? "warning" : "info")">
                <div class="panel-heading">
                    <h3 class="panel-title"><i class="fa fa-bar-chart"></i> Variance</h3>
                </div>
                <div class="panel-body text-center">
                    <h3 class="@Model.TotalVarianceClass">@Model.FormattedTotalVariance</h3>
                    <p class="text-muted">
                        @if (Model.TotalVariance > 0)
                        {
                            <span>Over allocated</span>
                        }
                        else if (Model.TotalVariance < 0)
                        {
                            <span>Under allocated</span>
                        }
                        else
                        {
                            <span>On target</span>
                        }
                    </p>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="panel panel-@(Model.UnreconciledCount > 0 ? "danger" : "success")">
                <div class="panel-heading">
                    <h3 class="panel-title">
                        <i class="fa fa-@(Model.IsHistoricalMonth ? "check-circle" : "exclamation-triangle")"></i>
                        Status
                    </h3>
                </div>
                <div class="panel-body text-center">
                    <h3>@Model.UnreconciledCount</h3>
                    <p class="text-muted">
                        @if (Model.UnreconciledCount > 0)
                        {
                            if (Model.IsCurrentMonth)
                            {
                                <span>Items need reconciliation</span>
                            }
                            else
                            {
                                <span>Items not reconciled</span>
                            }
                        }
                        else
                        {
                            <span>All items reconciled</span>
                        }
                    </p>
                </div>
            </div>
        </div>
    </div>

    <!-- Action Buttons -->
    @if (Model.IsCurrentMonth && Model.UnreconciledCount > 0)
    {
        <div class="row">
            <div class="col-md-12">
                <div class="alert alert-info">
                    <i class="fa fa-info-circle"></i>
                    <strong>Current Month:</strong> You can edit reconciliations for the current month.
                    <a href="@Url.Action("ReconciliationDashboard")" class="btn btn-sm btn-primary pull-right">
                        Go to Dashboard
                    </a>
                </div>
            </div>
        </div>
    }
    else if (Model.IsHistoricalMonth)
    {
        <div class="row">
            <div class="col-md-12">
                <div class="alert alert-warning">
                    <i class="fa fa-lock"></i>
                    <strong>Historical Data:</strong> This is historical reconciliation data and cannot be modified.
                </div>
            </div>
        </div>
    }

    <!-- Reconciliation Items -->
    @if (Model.ReconciliationItems != null && Model.ReconciliationItems.Any())
    {
        <div class="panel panel-default">
            <div class="panel-heading">
                <h3 class="panel-title">
                    <i class="fa fa-list"></i> Allocation Reconciliation Items
                    <span class="badge pull-right">@Model.ReconciliationItems.Count items</span>
                </h3>
            </div>
            <div class="panel-body">
                <div class="table-responsive">
                    <table class="table table-striped table-hover">
                        <thead>
                            <tr>
                                <th>Description</th>
                                <th>Department</th>
                                <th>Month/Year</th>
                                <th>Allocated Amount</th>
                                <th>Actual Spent</th>
                                <th>Variance</th>
                                <th>Variance %</th>
                                <th>Status</th>
                                <th>Reconciled Date</th>
                                <th>Notes</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model.ReconciliationItems)
                            {
                                <tr class="@(item.IsReconciled ? "" : "warning")">
                                    <td>
                                        <strong>@item.Description</strong>
                                    </td>
                                    <td>@item.DepartmentName</td>
                                    <td>@item.MonthName</td>
                                    <td>@item.FormattedAllocated</td>
                                    <td>@item.FormattedActual</td>
                                    <td>
                                        <span class="@item.VarianceClass">@item.FormattedVariance</span>
                                    </td>
                                    <td>
                                        <span class="@item.VarianceClass">@item.VariancePercentage.ToString("F1")%</span>
                                    </td>
                                    <td>
                                        @if (item.IsReconciled)
                                        {
                                            <span class="label label-success">Reconciled</span>
                                        }
                                        else
                                        {
                                            <span class="label label-warning">Pending</span>
                                        }
                                    </td>
                                    <td>
                                        @if (item.ReconciliationDate.HasValue)
                                        {
                                            @item.ReconciliationDate.Value.ToString("MM/dd/yyyy")
                                        }
                                        else
                                        {
                                            <em class="text-muted">Not reconciled</em>
                                        }
                                    </td>
                                    <td>
                                        @if (!string.IsNullOrEmpty(item.ReconciliationNotes))
                                        {
                                            <button type="button" class="btn btn-sm btn-info"
                                                    data-toggle="tooltip"
                                                    title="@item.ReconciliationNotes">
                                                <i class="fa fa-comment"></i>
                                            </button>
                                        }
                                        else
                                        {
                                            <em class="text-muted">None</em>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
            <div class="panel-footer">
                <div class="row">
                    <div class="col-md-6">
                        <small class="text-muted">
                            <i class="fa fa-info-circle"></i>
                            Showing @Model.ReconciliationItems.Count reconciliation items for @Model.MonthName
                        </small>
                    </div>
                    <div class="col-md-6 text-right">
                        <small class="text-muted">
                            Reconciled: @Model.ReconciliationItems.Count(r => r.IsReconciled) of @Model.ReconciliationItems.Count
                        </small>
                    </div>
                </div>
            </div>
        </div>
    }
    else
    {
        <div class="panel panel-default">
            <div class="panel-body text-center">
                <i class="fa fa-calendar fa-3x text-muted"></i>
                <h4>No Reconciliation Data</h4>
                <p class="text-muted">There are no reconciliation records for @Model.MonthName.</p>
                @if (Model.AvailablePeriods.Any())
                {
                    <p>Select a different period from the dropdown above.</p>
                }
            </div>
        </div>
    }
</div>

<script>
    $(document).ready(function () {
        // Initialize tooltips
        $('[data-toggle="tooltip"]').tooltip();

        // Auto-dismiss alerts after 5 seconds
        setTimeout(function () {
            $('.alert').fadeOut('slow');
        }, 5000);
    });

    function changePeriod() {
        var selector = document.getElementById('periodSelector');
        if (selector.value) {
            window.location.href = selector.value;
        }
    }
</script>

<style>
    .panel-body .badge {
        background-color: #337ab7;
    }

    .table td {
        vertical-align: middle;
    }

    .warning {
        background-color: #fcf8e3 !important;
    }

    .alert .btn {
        margin-left: 10px;
    }
</style>
