@model FifthPress.Models.ViewModels2.PO25.UnifiedPurchaseOrderViewModel

@{
    ViewBag.Title = "Purchase Orders";
}

<div class="container-fluid">
    <div class="row">
        <div class="col-md-12">
            <h2><i class="fa fa-shopping-cart"></i> My Purchase Orders</h2>

            @if (TempData["SuccessMessage"] != null || TempData["Success"] != null)
            {
                <div class="alert alert-success alert-dismissible">
                    <button type="button" class="close" data-dismiss="alert">&times;</button>
                    @(TempData["SuccessMessage"] ?? TempData["Success"])
                </div>
            }

            @if (TempData["ErrorMessage"] != null || TempData["Error"] != null)
            {
                <div class="alert alert-danger alert-dismissible">
                    <button type="button" class="close" data-dismiss="alert">&times;</button>
                    @(TempData["ErrorMessage"] ?? TempData["Error"])
                </div>
            }

            <div class="row mb-3">
                <div class="col-md-6">
                    <a href="/PO25/Create" class="btn btn-primary">Create New PO</a>
                    <a href="/PO25/CreateRecurring" class="btn btn-info">Create Recurring Order</a>

                    @if (ViewBag.HasAdminAccess == true)
                    {
                        <a href="/PO25Admin/Index" class="btn btn-danger" title="System Administration">Admin Portal</a>
                    }
                </div>
                <div class="col-md-6 text-right">
                    <button type="button" class="btn btn-outline-secondary filter-btn active" data-filter="all">All Orders</button>
                    <button type="button" class="btn btn-outline-secondary filter-btn" data-filter="Draft">My Drafts</button>
                    <button type="button" class="btn btn-outline-warning filter-btn" data-filter="Pending">Pending Approval</button>
                    <button type="button" class="btn btn-outline-success filter-btn" data-filter="Approved">Approved</button>
                    <a href="/PO25/ReconciliationDashboard" class="btn btn-warning">Reconciliation Dashboard</a>
                </div>
            </div>

            <!-- Navigation Tabs -->
            <ul class="nav nav-tabs" id="poTabs" role="tablist">
                <li class="nav-item" role="presentation">
                    <button class="nav-link active" id="regular-tab" data-bs-toggle="tab" data-bs-target="#regular" type="button" role="tab" aria-controls="regular" aria-selected="true">
                        <i class="fa fa-list"></i> Regular Orders
                        @if (Model?.RegularPOs?.Any() == true)
                        {
                            <span class="badge bg-primary">@Model.RegularPOs.Count</span>
                        }
                    </button>
                </li>
                <li class="nav-item" role="presentation">
                    <button class="nav-link" id="recurring-tab" data-bs-toggle="tab" data-bs-target="#recurring" type="button" role="tab" aria-controls="recurring" aria-selected="false">
                        <i class="fa fa-repeat"></i> Recurring Orders
                        @if (Model?.RecurringSchedules?.Any() == true)
                        {
                            <span class="badge bg-info">@Model.RecurringSchedules.Count</span>
                        }
                    </button>
                </li>
            </ul>

            <div class="tab-content" id="poTabsContent">
                <!-- Regular Purchase Orders Tab -->
                <div class="tab-pane fade show active" id="regular" role="tabpanel" aria-labelledby="regular-tab">
                    <div class="mt-3">
                        @if (Model?.RegularPOs?.Any() == true)
                        {
                            <div class="table-responsive">
                                <table class="table table-striped table-hover">
                                    <thead class="thead-dark">
                                        <tr>
                                            <th>PO #</th>
                                            <th>Type</th>
                                            <th>Vendor</th>
                                            <th>Department</th>
                                            <th>Created By</th>
                                            <th>Job Ticket</th>
                                            <th>Total Amount</th>
                                            <th>Status</th>
                                            <th>Date Submitted</th>
                                            <th>Actions</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var po in Model.RegularPOs)
                                        {
                                            <tr data-status="@po.Status" data-user-id="@po.SubmittedByUserId">
                                                <td>
                                                    @Html.ActionLink(po.PO_OrderId.ToString(), "Details", new { id = po.PO_OrderId })
                                                </td>
                                                <td>
                                                    @if (po.OrderType == "Recurring")
                                                    {
                                                        <span class="badge badge-info">Recurring</span>
                                                    }
                                                    else
                                                    {
                                                        <span class="badge badge-default">Standard</span>
                                                    }
                                                </td>
                                                <td>@(po.Vendor?.Title ?? "N/A")</td>
                                                <td>@(po.Department?.Title ?? "N/A")</td>
                                                <td>@(po.User?.FirstName ?? "") @(po.User?.LastName ?? "")</td>
                                                <td>
                                                    @{
                                                        var jobTickets = po.PO_LineItems25?
                                                            .Where(li => !string.IsNullOrEmpty(li.JobTicketNumber))
                                                            .Select(li => li.JobTicketNumber)
                                                            .Distinct()
                                                            .ToList() ?? new List<string>();
                                                    }
                                                    @if (jobTickets.Any())
                                                    {
                                                        string.Join(", ", jobTickets);
                                                    }
                                                    else
                                                    {
                                                        <text>N/A</text>
                                                    }
                                                </td>
                                                <td>$@(po.PO_LineItems25?.Sum(li => li.Cost * li.Quantity).ToString("F2") ?? "0.00")</td>
                                                <td>
                                                    @switch (po.Status)
                                                    {
                                                        case "Draft":
                                                            <span class="badge badge-secondary">@po.Status</span>
                                                            break;
                                                        case "Pending":
                                                            <span class="badge badge-warning">@po.Status</span>
                                                            break;
                                                        case "Approved":
                                                            <span class="badge badge-success">@po.Status</span>
                                                            break;
                                                        case "Denied":
                                                            <span class="badge badge-danger">@po.Status</span>
                                                            break;
                                                        case "SentBack":
                                                            <span class="badge badge-info">Sent Back</span>
                                                            break;
                                                        case "Cancelled":
                                                            <span class="badge badge-dark">@po.Status</span>
                                                            break;
                                                        default:
                                                            <span class="badge badge-light">@po.Status</span>
                                                            break;
                                                    }
                                                </td>
                                                <td>
                                                    @if (po.DateSubmitted.HasValue)
                                                    {
                                                        @po.DateSubmitted.Value.ToString("MM/dd/yyyy")
                                                    }
                                                    else
                                                    {
                                                        <em>Draft</em>
                                                    }
                                                </td>
                                                <td>
                                                    @Html.ActionLink("View", "Details", new { id = po.PO_OrderId }, new { @class = "btn btn-sm btn-outline-primary" })

                                                    @if (po.Status == "Draft" || po.Status == "SentBack")
                                                    {
                                                        @Html.ActionLink("Edit", "Edit", new { id = po.PO_OrderId }, new { @class = "btn btn-sm btn-outline-warning" })
                                                    }

                                                    @if (po.Status == "Draft")
                                                    {
                                                        using (Html.BeginForm("Submit", "PO25", new { id = po.PO_OrderId }, FormMethod.Post, new { @class = "d-inline" }))
                                                        {
                                                            @Html.AntiForgeryToken()
                                                            <button type="submit" class="btn btn-sm btn-success" onclick="return confirm('Submit this PO for approval?')">Submit</button>
                                                        }
                                                    }

                                                    @if (po.Status == "Pending" || po.Status == "Draft")
                                                    {
                                                        using (Html.BeginForm("Cancel", "PO25", new { id = po.PO_OrderId }, FormMethod.Post, new { @class = "d-inline" }))
                                                        {
                                                            @Html.AntiForgeryToken()
                                                            <button type="submit" class="btn btn-sm btn-outline-danger" onclick="return confirm('Cancel this PO?')">Cancel</button>
                                                        }
                                                    }

                                                    @Html.ActionLink("Copy", "Copy", new { id = po.PO_OrderId }, new { @class = "btn btn-sm btn-outline-info" })
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                        else
                        {
                            <div class="alert alert-info">
                                <h4>No Regular Purchase Orders Found</h4>
                                <p>You haven't created any regular purchase orders yet. <a href="/PO25/Create" class="alert-link">Create your first PO</a> to get started.</p>
                            </div>
                        }
                    </div>
                </div>

                <!-- Recurring Orders Tab -->
                <div class="tab-pane fade" id="recurring" role="tabpanel" aria-labelledby="recurring-tab">
                    <div class="mt-3">
                        @if (Model?.RecurringSchedules?.Any() == true)
                        {
                            <div class="panel panel-default">
                                <div class="panel-heading">
                                    <h3 class="panel-title"><i class="fa fa-list"></i> Active Recurring Schedules</h3>
                                </div>
                                <div class="panel-body">
                                    <div class="table-responsive">
                                        <table class="table table-striped table-hover">
                                            <thead>
                                                <tr>
                                                    <th>Description</th>
                                                    <th>Department</th>
                                                    <th>Type</th>
                                                    <th>Amount</th>
                                                    <th>Frequency</th>
                                                    <th>Start Date</th>
                                                    <th>End Date</th>
                                                    <th>Next Process</th>
                                                    <th>Last Processed</th>
                                                    <th>Status</th>
                                                    <th>Actions</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                @foreach (var schedule in Model.RecurringSchedules)
                                                {
                                                    <tr class="@(!schedule.IsActive ? "text-muted" : "")">
                                                        <td>
                                                            <strong>@schedule.Description</strong>
                                                        </td>
                                                        <td>@schedule.DepartmentName</td>
                                                        <td>
                                                            @if (schedule.IsAllocation)
                                                            {
                                                                <span class="label label-warning">Allocation</span>
                                                            }
                                                            else
                                                            {
                                                                <span class="label label-info">Fixed Cost</span>
                                                            }
                                                        </td>
                                                        <td>@schedule.FormattedRecurringAmount</td>
                                                        <td>@schedule.FrequencyDisplay</td>
                                                        <td>@schedule.StartDate.ToString("MM/dd/yyyy")</td>
                                                        <td>
                                                            @if (schedule.EndDate.HasValue)
                                                            {
                                                                @schedule.EndDate.Value.ToString("MM/dd/yyyy")
                                                            }
                                                            else
                                                            {
                                                                <em>Ongoing</em>
                                                            }
                                                        </td>
                                                        <td>
                                                            @if (!schedule.IsActive)
                                                            {
                                                                <span class="badge badge-secondary">Inactive</span>
                                                            }
                                                            else if (schedule.NextProcessDate.HasValue && schedule.NextProcessDate.Value > DateTime.Now.Date)
                                                            {
                                                                <span class="text-success">@schedule.NextProcessDate.Value.ToString("MM/dd/yyyy")</span>
                                                            }
                                                            else if (schedule.NextProcessDate.HasValue)
                                                            {
                                                                <span class="text-warning">@schedule.NextProcessDate.Value.ToString("MM/dd/yyyy")</span>
                                                            }
                                                            else
                                                            {
                                                                <em>Not scheduled</em>
                                                            }
                                                        </td>
                                                        <td>
                                                            @if (schedule.LastProcessedDate.HasValue)
                                                            {
                                                                @schedule.LastProcessedDate.Value.ToString("MM/dd/yyyy")
                                                            }
                                                            else
                                                            {
                                                                <em>Never</em>
                                                            }
                                                        </td>
                                                        <td>
                                                            @if (schedule.IsActive)
                                                            {
                                                                <span class="label label-success">Active</span>
                                                            }
                                                            else
                                                            {
                                                                <span class="label label-default">Inactive</span>
                                                            }
                                                        </td>
                                                        <td class="recurring-actions-cell">
                                                            <div class="recurring-action-dropdown">
                                                                <button type="button" class="btn btn-info btn-xs recurring-action-toggle">
                                                                    Actions <i class="fa fa-caret-down"></i>
                                                                </button>
                                                                <ul class="recurring-action-menu">
                                                                    <li>
                                                                        <a href="@Url.Action("EditRecurring", new { id = schedule.RecurringId })">
                                                                            <i class="fa fa-edit"></i> Edit Schedule
                                                                        </a>
                                                                    </li>
                                                                    <li>
                                                                        <a href="@Url.Action("ViewHistory", new { id = schedule.RecurringId })">
                                                                            <i class="fa fa-history"></i> View History
                                                                        </a>
                                                                    </li>
                                                                    @if (schedule.IsActive)
                                                                    {
                                                                        <li>
                                                                            <a href="#" onclick="pauseSchedule(@schedule.RecurringId); return false;">
                                                                                <i class="fa fa-pause"></i> Pause Schedule
                                                                            </a>
                                                                        </li>
                                                                    }
                                                                    else
                                                                    {
                                                                        <li>
                                                                            <a href="#" onclick="activateSchedule(@schedule.RecurringId); return false;">
                                                                                <i class="fa fa-play"></i> Activate Schedule
                                                                            </a>
                                                                        </li>
                                                                    }
                                                                    <li class="divider"></li>
                                                                    <li>
                                                                        <a href="#" onclick="deleteSchedule(@schedule.RecurringId)" class="text-danger">
                                                                            <i class="fa fa-trash"></i> Delete Schedule
                                                                        </a>
                                                                    </li>
                                                                </ul>
                                                            </div>
                                                        </td>
                                                    </tr>
                                                }
                                            </tbody>
                                        </table>
                                    </div>
                                </div>
                                <div class="panel-footer">
                                    <div class="row">
                                        <div class="col-md-12">
                                            <small class="text-muted">
                                                Total Active Schedules: @Model.RecurringSchedules.Count(s => s.IsActive) |
                                                Total Monthly Amount: @Model.RecurringSchedules.Where(s => s.IsActive).Sum(s => s.MonthlyAmount).ToString("C")
                                            </small>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        }
                        else
                        {
                            <div class="panel panel-default">
                                <div class="panel-body text-center">
                                    <i class="fa fa-repeat fa-3x text-muted"></i>
                                    <h4>No Recurring Orders Found</h4>
                                    <p class="text-muted">You haven't created any recurring orders yet.</p>
                                    @Html.ActionLink("Create Your First Recurring Order", "CreateRecurring", null, new { @class = "btn btn-primary" })
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    function pauseSchedule(recurringId) {
        if (confirm('Are you sure you want to pause this recurring schedule? No new orders will be generated until you reactivate it.')) {
            $.post(ProcessUrl('PO25/PauseSchedule'), { id: recurringId }, function (data) {
                if (data.success) {
                    location.reload();
                } else {
                    alert('Error: ' + data.message);
                }
            });
        }
    }

    function activateSchedule(recurringId) {
        if (confirm('Are you sure you want to activate this recurring schedule? Orders will resume being generated automatically.')) {
            $.post(ProcessUrl('PO25/ActivateSchedule'), { id: recurringId }, function (data) {
                if (data.success) {
                    location.reload();
                } else {
                    alert('Error: ' + data.message);
                }
            });
        }
    }

    function deleteSchedule(recurringId) {
        if (confirm('Are you sure you want to delete this recurring schedule? This action cannot be undone.')) {
            $.post(ProcessUrl('PO25/DeleteSchedule'), { id: recurringId }, function (data) {
                if (data.success) {
                    location.reload();
                } else {
                    alert('Error: ' + data.message);
                }
            });
        }
    }

    $(document).ready(function () {
        // Auto-dismiss alerts after 5 seconds
        setTimeout(function () {
            $('.alert').fadeOut('slow');
        }, 5000);

        // Bootstrap 5 tab event listener (optional - should work automatically)
        document.querySelectorAll('button[data-bs-toggle="tab"]').forEach(function (tabEl) {
            tabEl.addEventListener('shown.bs.tab', function (event) {
                console.log('Tab switched to: ' + event.target.getAttribute('data-bs-target'));
            });
        });
    });
</script>

<style>
    .badge {
        font-size: 0.875em;
    }

    .table th {
        border-top: none;
    }

    .btn-sm {
        margin-right: 2px;
        margin-bottom: 2px;
    }

    /* Style for Admin Portal button */
    .btn-danger {
        margin-left: 8px;
        border: 1px solid #dc3545;
        background-color: #dc3545;
        color: white;
    }

        .btn-danger:hover {
            background-color: #c82333;
            border-color: #bd2130;
        }

    .badge {
        color: blue !important;
    }

    .btn-group-xs > .btn, .btn-xs {
        padding: 1px 5px;
        font-size: 12px;
        line-height: 1.5;
        border-radius: 3px;
    }

    .dropdown-menu {
        min-width: 160px;
    }

        .dropdown-menu > li > a {
            padding: 3px 20px;
        }

    .table td {
        vertical-align: middle;
    }

    .nav-tabs {
        border-bottom: 1px solid #ddd;
        margin-bottom: 0;
    }

    .tab-content {
        border-left: 1px solid #ddd;
        border-right: 1px solid #ddd;
        border-bottom: 1px solid #ddd;
        padding: 0;
    }

    .nav-link {
        color: #495057;
        border: 1px solid transparent;
        border-top-left-radius: 0.25rem;
        border-top-right-radius: 0.25rem;
    }

        .nav-link.active {
            color: #495057;
            background-color: #fff;
            border-color: #ddd #ddd #fff;
        }

    /* Recurring Actions Dropdown */
    .recurring-actions-cell {
        position: relative;
        overflow: visible;
    }

    .recurring-action-dropdown {
        position: relative;
        display: inline-block;
    }

    .recurring-action-menu {
        display: none;
        position: absolute;
        top: 100%;
        right: 0;
        margin-top: 2px;
        min-width: 180px;
        background: #fff;
        border: 1px solid #ccc;
        border-radius: 4px;
        box-shadow: 0 2px 8px rgba(0,0,0,0.15);
        list-style: none;
        padding: 5px 0;
        z-index: 9999;
    }

    .recurring-action-menu.open {
        display: block;
    }

    .recurring-action-menu li a {
        display: block;
        padding: 6px 15px;
        color: #333;
        text-decoration: none;
        white-space: nowrap;
    }

    .recurring-action-menu li a:hover {
        background: #f5f5f5;
    }

    .recurring-action-menu li a.text-danger {
        color: #d9534f;
    }

    .recurring-action-menu .divider {
        height: 1px;
        margin: 5px 0;
        background: #e5e5e5;
    }
</style>

<script>
$(document).ready(function() {
    var currentUserId = @ViewBag.CurrentUserId;

    // Recurring actions dropdown toggle
    $(document).on('click', '.recurring-action-toggle', function(e) {
        e.preventDefault();
        e.stopPropagation();

        var $menu = $(this).siblings('.recurring-action-menu');
        var wasOpen = $menu.hasClass('open');

        // Close all menus first
        $('.recurring-action-menu').removeClass('open');

        // Toggle this one
        if (!wasOpen) {
            $menu.addClass('open');
        }
    });

    // Close dropdown when clicking outside
    $(document).on('click', function(e) {
        if (!$(e.target).closest('.recurring-action-dropdown').length) {
            $('.recurring-action-menu').removeClass('open');
        }
    });

    // Filter button functionality
    $('.filter-btn').click(function() {
        var filter = $(this).data('filter');

        // Update active button
        $('.filter-btn').removeClass('active');
        $(this).addClass('active');

        // Filter the regular PO table rows
        $('#regular tbody tr').each(function() {
            var status = $(this).data('status');
            var userId = $(this).data('user-id');

            if (filter === 'all') {
                $(this).show();
            } else if (filter === 'Draft') {
                // "My Drafts" - show only drafts created by current user
                if (status === 'Draft' && userId === currentUserId) {
                    $(this).show();
                } else {
                    $(this).hide();
                }
            } else if (status === filter) {
                $(this).show();
            } else {
                $(this).hide();
            }
        });

        // Update row count display
        var visibleRows = $('#regular tbody tr:visible').length;
        console.log('Visible rows after filter:', visibleRows);
    });
});
</script>