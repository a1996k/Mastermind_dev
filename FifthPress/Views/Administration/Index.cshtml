@{
    ViewBag.Title = "Administration";
}

@Styles.Render("~/Content/admincss")

<input type="hidden" class="hidden-navver" />

<div class="container-fluid admin-wrapper">
    <div class="row justify-content-between">
        <div class="col-lg-4 d-flex flex-direction-column align-items-center">
            <h2 class="admin-h2">Administration</h2>
        </div>
        <div class="col-lg-8">
            <div class="d-flex justify-content-end admin-nav-group">
                <button type="button" class="btn btn-lg btn-fc-caution fc-btn-admin me-3" data-ajax-load="Users">Users</button>
                <button type="button" class="btn btn-lg btn-fc-caution fc-btn-admin me-3" data-ajax-load="Customers">Clients</button>
                <button type="button" class="btn btn-lg btn-fc-caution fc-btn-admin me-3" data-ajax-load="Services">Services</button>
                <button type="button" class="btn btn-lg btn-fc-caution fc-btn-admin me-3" data-ajax-load="ServiceCategories">Service Categories</button>
                <button type="button" class="btn btn-lg btn-fc-caution fc-btn-admin me-3" data-ajax-load="Materials">Materials</button>
                <button type="button" class="btn btn-lg btn-fc-caution fc-btn-admin me-3" data-ajax-load="Presses">Presses</button>
                <a href="@Url.Action("Index", "ClientLogin")" data-permissions="3d" class="btn btn-lg btn-fc-caution fc-btn-admin me-3">Client Login</a>
                <a href="@Url.Action("ReprintReasons", "Administration")" class="btn btn-lg btn-fc-caution fc-btn-admin me-3">Reprint Reasons</a>
                <button type="button" class="btn btn-lg btn-fc-caution me-3 bugs-btn">View Bugs</button>
                <button type="button" class="btn btn-lg btn-fc-danger me-3" data-modal-to-open="#set_password_modal">Change My Password</button>
            </div>
        </div>
    </div>
</div>

<div class="d-flex flex-row flex-nowrap justify-content-around fc-table-wrapper">
    <div class="container-fluid p-4">
        <div class="row">
            <div class="col-3" style="display:none">
                <div class="sidebar-container pt-5">
                </div>
            </div>
            <div class="col-9">
                <div class="fc-table-content">
                    <div class="d-flex justify-content-between mb-4 align-items-center">
                        <div class="dynamic-button-home"></div>
                        <button type="button" class="btn btn-success new-user-btn" style="display:none" data-ajax-load="Users">Add New User</button>
                        <button type="button" class="btn btn-success new-service-btn " style="display:none" data-ajax-load="Services">New Service</button>
                        <button type="button" class="btn btn-success new-material-btn " style="display:none" data-ajax-load="Materials">New Material</button>
                        <button type="button" class="btn btn-success new-press-btn " style="display:none" data-ajax-load="Presses">New Press</button>
                        <button type="button" class="btn btn-success new-service-cat-btn " style="display:none" data-ajax-load="ServiceCategories">New Service Category</button>
                        <button type="button" class="btn btn-success new-customer-btn " style="display:none" data-ajax-load="Customers">New Customer</button>
                    </div>
                    <table class="table table-borderless" id="psDataTable">
                        <thead>
                        </thead>
                        <tbody class="viewer fc-item-td">
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

