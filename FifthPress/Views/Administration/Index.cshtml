<div class="modal new-stock-type-modal" tabindex="-1" id="new_stock_type_modal">
    <div class="modal-dialog modal-fullscreen">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">New Stock Type</h5>
            </div>
            <div class="modal-body">
                <p class="fs-3">This stock type was not found for the selected press. Would you like to add this stock type to this press?</p>
                <p><button type="button" class="btn btn-fc-info new-stock-type-btn" data-modal-to-close="#new_stock_type_modal">Yes</button><button type="button" class="btn btn-fc-caution cancel-new-stock-type" data-modal-to-close="#new_stock_type_modal">No</button></p>
            </div>
        </div>
    </div>
</div>

