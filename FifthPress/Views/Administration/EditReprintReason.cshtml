@model FifthPress.Reprint_Reasons
@{
    ViewBag.Title = "Edit Reprint Reason";
    var categories = ViewBag.Categories as List<string> ?? new List<string>();
    var costAllocations = ViewBag.CostAllocations as List<string> ?? new List<string>();
}

<div class="container p-4" style="max-width: 700px;">
    <h2>Edit Reprint Reason</h2>

    @using (Html.BeginForm("EditReprintReason", "Administration", FormMethod.Post))
    {
        @Html.AntiForgeryToken()
        @Html.HiddenFor(m => m.ReasonId)
        @Html.ValidationSummary(false, "", new { @class = "alert alert-danger", style = "margin-top:10px;" })

        <div class="form-group mb-3">
            <label for="Category">Category</label>
            <input type="text" name="Category" id="Category" class="form-control" list="categoryList"
                   value="@Model.Category" placeholder="Pick an existing category or type a new one" autocomplete="off" />
            <datalist id="categoryList">
                @foreach (var c in categories)
                {
                    <option value="@c"></option>
                }
            </datalist>
        </div>

        <div class="form-group mb-3">
            <label for="ReasonText">Reason</label>
            <input type="text" name="ReasonText" id="ReasonText" class="form-control"
                   value="@Model.ReasonText" maxlength="100" />
        </div>

        <div class="form-group mb-3">
            <label for="DefaultCostAllocation">Default Cost Allocation</label>
            <input type="text" name="DefaultCostAllocation" id="DefaultCostAllocation" class="form-control" list="costAllocList"
                   value="@Model.DefaultCostAllocation" placeholder="e.g. Bill Customer" autocomplete="off" />
            <datalist id="costAllocList">
                @foreach (var c in costAllocations)
                {
                    <option value="@c"></option>
                }
            </datalist>
        </div>

        <div class="form-group mb-3">
            <label for="SortOrder">Sort Order</label>
            <input type="number" name="SortOrder" id="SortOrder" class="form-control" value="@Model.SortOrder" />
        </div>

        <div class="form-check mb-3">
            <input type="checkbox" name="IsActive" id="IsActive" class="form-check-input" value="true" @(Model.IsActive ? "checked" : "") />
            <input type="hidden" name="IsActive" value="false" />
            <label class="form-check-label" for="IsActive">Active</label>
        </div>

        <button type="submit" class="btn btn-success">Save</button>
        <a href="@Url.Action("ReprintReasons")" class="btn btn-secondary">Cancel</a>
    }
</div>
