@model FifthPress.Models.ViewModels2.PO25.VM_AllPOs25

@{
    ViewBag.Title = "All Purchase Orders";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container-fluid">
    <div class="row">
        <div class="col-md-12">
            <h2><i class="fa fa-list"></i> All Purchase Orders</h2>
            <hr />
            <a href="@Url.Action("Index")" class="btn btn-default">
                <i class="fa fa-arrow-left"></i> Back to Dashboard
            </a>
        </div>
    </div>

    <!-- Alert Messages -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible">
            <button type="button" class="close" data-dismiss="alert">&times;</button>
            @TempData["SuccessMessage"]
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible">
            <button type="button" class="close" data-dismiss="alert">&times;</button>
            @TempData["ErrorMessage"]
        </div>
    }

    <!-- Filters -->
    <div class="row">
        <div class="col-md-12">
            <div class="panel panel-default">
                <div class="panel-heading">
                    <h3 class="panel-title"><i class="fa fa-filter"></i> Filters</h3>
                </div>
                <div class="panel-body">
                    @using (Html.BeginForm("AllPOs", "PO25Admin", FormMethod.Get, new { @class = "form-horizontal" }))
                    {
                        <div class="row">
                            <div class="col-md-3">
                                <div class="form-group">
                                    <label for="status" class="control-label">Status</label>
                                    @Html.DropDownList("status", Model.Statuses, new { @class = "form-control" })
                                </div>
                            </div>
                            <div class="col-md-3">
                                <div class="form-group">
                                    <label for="departmentId" class="control-label">Department</label>
                                    @Html.DropDownList("departmentId", Model.Departments, new { @class = "form-control" })
                                </div>
                            </div>
                            <div class="col-md-2">
                                <div class="form-group">
                                    <label for="startDate" class="control-label">Start Date</label>
                                    @Html.TextBox("startDate", Model.StartDateFilter?.ToString("yyyy-MM-dd"), new { @class = "form-control", @type = "date" })
                                </div>
                            </div>
                            <div class="col-md-2">
                                <div class="form-group">
                                    <label for="endDate" class="control-label">End Date</label>
                                    @Html.TextBox("endDate", Model.EndDateFilter?.ToString("yyyy-MM-dd"), new { @class = "form-control", @type = "date" })
                                </div>
                            </div>
                            <div class="col-md-2">
                                <div class="form-group">
                                    <label class="control-label">&nbsp;</label>
                                    <div>
                                        <button type="submit" class="btn btn-primary btn-block">
                                            <i class="fa fa-search"></i> Filter
                                        </button>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>

    <!-- Bulk Actions -->
    @if (Model.POs != null && Model.POs.Any(po => po.Status == "Pending"))
    {
        <div class="row">
            <div class="col-md-12">
                <div class="panel panel-warning">
                    <div class="panel-heading">
                        <h3 class="panel-title"><i class="fa fa-cogs"></i> Bulk Actions</h3>
                    </div>
                    <div class="panel-body">
                        @using (Html.BeginForm("BulkApprove", "PO25Admin", FormMethod.Post, new { id = "bulkApprovalForm" }))
                        {
                            @Html.AntiForgeryToken()
                            <div class="row">
                                <div class="col-md-6">
                                    <div class="form-group">
                                        <label for="bulkComment">Approval Comment (Optional)</label>
                                        <input type="text" id="bulkComment" name="comment" class="form-control"
                                               placeholder="Enter comment for bulk approval..." />
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="form-group">
                                        <label>&nbsp;</label>
                                        <div>
                                            <button type="submit" class="btn btn-success" id="bulkApproveBtn" disabled>
                                                <i class="fa fa-check"></i> Bulk Approve Selected
                                            </button>
                                            <span class="text-muted" id="selectedCount">0 POs selected</span>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    }

    <!-- POs Table -->
    @if (Model.POs != null && Model.POs.Any())
    {
        <div class="row">
            <div class="col-md-12">
                <div class="panel panel-default">
                    <div class="panel-heading">
                        <h3 class="panel-title">
                            <i class="fa fa-table"></i> Purchase Orders
                            <span class="badge">@Model.POs.Count() total</span>
                        </h3>
                    </div>
                    <div class="panel-body">
                        <div class="table-responsive">
                            <table class="table table-striped table-hover" id="posTable">
                                <thead>
                                    <tr>
                                        @if (Model.POs.Any(po => po.Status == "Pending"))
                                        {
                                            <th width="30">
                                                <input type="checkbox" id="selectAll" />
                                            </th>
                                        }
                                        <th>PO #</th>
                                        <th>Submitter</th>
                                        <th>Department</th>
                                        <th>Vendor</th>
                                        <th>Total Amount</th>
                                        <th>Status</th>
                                        <th>Date Submitted</th>
                                        <th>Actions</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var po in Model.POs)
                                    {
                                        <tr class="@(po.Status == "Denied" ? "danger" : po.Status == "Approved" ? "success" : po.Status == "Pending" ? "warning" : "")">
                                            @if (Model.POs.Any(p => p.Status == "Pending"))
                                            {
                                                <td>
                                                    @if (po.Status == "Pending")
                                                    {
                                                        <input type="checkbox" class="po-checkbox" value="@po.PO_OrderId" />
                                                    }
                                                </td>
                                            }
                                            <td>
                                                <a href="@Url.Action("Details", "PO25", new { id = po.PO_OrderId })">
                                                    <strong>#@po.PO_OrderId</strong>
                                                </a>
                                            </td>
                                            <td>@po.SubmitterName</td>
                                            <td>@po.DepartmentName</td>
                                            <td>@po.VendorName</td>
                                            <td>$@po.TotalAmount.ToString("N2")</td>
                                            <td>
                                                <span class="label @(po.Status == "Approved" ? "label-success" : po.Status == "Denied" ? "label-danger" : po.Status == "Pending" ? "label-warning" : po.Status == "Draft" ? "label-default" : "label-info")">
                                                    @po.Status
                                                </span>
                                            </td>
                                            <td>@(po.DateSubmitted?.ToString("MM/dd/yyyy") ?? "N/A")</td>
                                            <td>
                                                <div class="btn-group btn-group-xs">
                                                    <a href="@Url.Action("Details", "PO25", new { id = po.PO_OrderId })" class="btn btn-info" title="View Details">
                                                        <i class="fa fa-eye"></i>
                                                    </a>
                                                    @if (po.Status == "Pending")
                                                    {
                                                        <a href="@Url.Action("Review", "PO25Approval", new { id = po.PO_OrderId })" class="btn btn-primary" title="Review for Approval">
                                                            <i class="fa fa-gavel"></i>
                                                        </a>
                                                    }
                                                    @if (po.Status == "Draft" || po.Status == "SentBack")
                                                    {
                                                        <a href="@Url.Action("Edit", "PO25", new { id = po.PO_OrderId })" class="btn btn-warning" title="Edit">
                                                            <i class="fa fa-edit"></i>
                                                        </a>
                                                    }
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Summary Statistics -->
        <div class="row">
            <div class="col-md-3">
                <h4>Total POs</h4>
                <h3 class="text-primary">@Model.POs.Count()</h3>
            </div>
            <div class="col-md-3">
                <h4>Total Value</h4>
                <h3 class="text-success">
                    $@Model.POs.Sum(po => po.TotalAmount).ToString("N0")
                </h3>
            </div>
            <div class="col-md-3">
                <h4>Pending Approval</h4>
                <h3 class="text-warning">@Model.POs.Count(po => po.Status == "Pending")</h3>
            </div>
            <div class="col-md-3">
                <h4>Approved</h4>
                <h3 class="text-info">@Model.POs.Count(po => po.Status == "Approved")</h3>
            </div>
        </div>

    }
    else
    {
        <div class="row">
            <div class="col-md-12">
                <div class="alert alert-info">
                    <i class="fa fa-info-circle"></i> No purchase orders found matching the current filters.
                </div>
            </div>
        </div>
    }
</div>

<script>
$(document).ready(function() {
    // Initialize DataTable if available
    if ($.fn.DataTable) {
        $('#posTable').DataTable({
            "order": [[ @(Model.POs != null && Model.POs.Any(po => po.Status == "Pending") ? "7" : "6"), "desc" ]], // Sort by date submitted
            "pageLength": 50
        });
    }

    // Handle select all functionality
    $('#selectAll').change(function() {
        $('.po-checkbox').prop('checked', this.checked);
        updateBulkApprovalButton();
    });

    // Handle individual checkbox changes
    $('.po-checkbox').change(function() {
        updateBulkApprovalButton();

        // Update select all checkbox
        var totalCheckboxes = $('.po-checkbox').length;
        var checkedCheckboxes = $('.po-checkbox:checked').length;
        $('#selectAll').prop('checked', totalCheckboxes === checkedCheckboxes);
    });

    // Bulk approval form submission
    $('#bulkApprovalForm').submit(function(e) {
        var selectedIds = $('.po-checkbox:checked').map(function() {
            return this.value;
        }).get();

        if (selectedIds.length === 0) {
            e.preventDefault();
            alert('Please select at least one PO to approve.');
            return false;
        }

        if (!confirm('Are you sure you want to approve ' + selectedIds.length + ' purchase order(s)?')) {
            e.preventDefault();
            return false;
        }

        // Add hidden inputs for selected IDs
        var form = this;
        selectedIds.forEach(function(id) {
            var input = document.createElement('input');
            input.type = 'hidden';
            input.name = 'poIds';
            input.value = id;
            form.appendChild(input);
        });
    });

    // Auto-dismiss alerts
    setTimeout(function() {
        $('.alert').fadeOut('slow');
    }, 5000);
});

function updateBulkApprovalButton() {
    var checkedCount = $('.po-checkbox:checked').length;
    $('#selectedCount').text(checkedCount + ' PO' + (checkedCount !== 1 ? 's' : '') + ' selected');
    $('#bulkApproveBtn').prop('disabled', checkedCount === 0);
}
</script>

<style>
.table th {
    background-color: #f5f5f5;
}
.table-hover tbody tr:hover {
    background-color: #f9f9f9;
}
#posTable_wrapper .dataTables_length,
#posTable_wrapper .dataTables_filter {
    margin-bottom: 10px;
}
</style>