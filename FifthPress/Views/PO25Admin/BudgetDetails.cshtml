@model FifthPress.Models.ViewModels2.PO25.VM_BudgetDetails25

@{
    ViewBag.Title = "Budget Details - " + Model.Budget?.DepartmentName;
}

<div class="container-fluid">
    <div class="row">
        <div class="col-md-12">
            <h2><i class="fa fa-money"></i> Budget Details - @Model.Budget?.DepartmentName</h2>
            <hr />
            <a href="@Url.Action("BudgetManagement")" class="btn btn-default">
                <i class="fa fa-arrow-left"></i> Back to Budget Management
            </a>
        </div>
    </div>

    @if (Model.Budget != null)
    {
        <!-- Budget Overview -->
        <div class="row">
            <div class="col-md-12">
                <div class="panel panel-primary">
                    <div class="panel-heading">
                        <h3 class="panel-title"><i class="fa fa-pie-chart"></i> Budget Overview</h3>
                    </div>
                    <div class="panel-body">
                        <div class="row">
                            <div class="col-md-3">
                                <div class="text-center">
                                    <h3 class="text-primary">$@Model.Budget.AnnualBudget.ToString("N0")</h3>
                                    <p class="text-muted">Annual Budget</p>
                                </div>
                            </div>
                            <div class="col-md-3">
                                <div class="text-center">
                                    <h3 class="text-info">$@Model.Budget.YtdSpent.ToString("N0")</h3>
                                    <p class="text-muted">Year-to-Date Spent</p>
                                </div>
                            </div>
                            <div class="col-md-3">
                                <div class="text-center">
                                    <h3 class="@(Model.Budget.AvailableBalance < 0 ? "text-danger" : "text-success")">
                                        $@Model.Budget.AvailableBalance.ToString("N0")
                                    </h3>
                                    <p class="text-muted">Available Balance</p>
                                </div>
                            </div>
                            <div class="col-md-3">
                                <div class="text-center">
                                    <h3 class="@(Model.Budget.PercentUsed > 100 ? "text-danger" : Model.Budget.PercentUsed > 90 ? "text-warning" : "text-success")">
                                        @Model.Budget.PercentUsed.ToString("F1")%
                                    </h3>
                                    <p class="text-muted">Utilization</p>
                                </div>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-12">
                                <div class="progress" style="height: 25px;">
                                    <div class="progress-bar @(Model.Budget.PercentUsed > 100 ? "progress-bar-danger" : Model.Budget.PercentUsed > 90 ? "progress-bar-warning" : "progress-bar-success")"
                                         style="width: @(Math.Min(Model.Budget.PercentUsed, 100))%">
                                        @Model.Budget.PercentUsed.ToString("F1")% Used
                                    </div>
                                    @if (Model.Budget.PercentUsed > 100)
                                    {
                                        <div class="progress-bar progress-bar-danger progress-bar-striped"
                                             style="width: @(Model.Budget.PercentUsed - 100)%">
                                            Over Budget: @((Model.Budget.PercentUsed - 100).ToString("F1"))%
                                        </div>
                                    }
                                </div>
                            </div>
                        </div>

                        @if (Model.Budget.IsOverBudget)
                        {
                            <div class="alert alert-danger" style="margin-top: 15px;">
                                <i class="fa fa-exclamation-triangle"></i>
                                <strong>Budget Alert:</strong> This department has exceeded its annual budget by $@((Model.Budget.YtdSpent - Model.Budget.AnnualBudget).ToString("N0")).
                            </div>
                        }
                        else if (Model.Budget.PercentUsed > 90)
                        {
                            <div class="alert alert-warning" style="margin-top: 15px;">
                                <i class="fa fa-warning"></i>
                                <strong>Budget Warning:</strong> This department is approaching its budget limit.
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>

        <!-- Monthly Spending Chart -->
        if (Model.MonthlySpending != null && Model.MonthlySpending.Any())
        {
            <div class="row">
                <div class="col-md-12">
                    <div class="panel panel-default">
                        <div class="panel-heading">
                            <h3 class="panel-title"><i class="fa fa-line-chart"></i> Monthly Spending Trend (Last 12 Months)</h3>
                        </div>
                        <div class="panel-body">
                            <canvas id="monthlySpendingChart" height="100"></canvas>
                        </div>
                    </div>
                </div>
            </div>
        }

        <!-- Usage History -->
        if (Model.UsageHistory != null && Model.UsageHistory.Any())
        {
            <div class="row">
                <div class="col-md-12">
                    <div class="panel panel-info">
                        <div class="panel-heading">
                            <h3 class="panel-title"><i class="fa fa-history"></i> Recent Budget Usage</h3>
                        </div>
                        <div class="panel-body">
                            <div class="table-responsive">
                                <table class="table table-striped table-hover" id="usageTable">
                                    <thead>
                                        <tr>
                                            <th>Date</th>
                                            <th>PO #</th>
                                            <th>Description</th>
                                            <th>Amount</th>
                                            <th>Type</th>
                                            <th>Running Total</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @{
                                            var runningTotal = 0m;
                                        }
                                        @foreach (var usage in Model.UsageHistory.OrderByDescending(u => u.UsageDate))
                                        {
                                            runningTotal += usage.Amount;
                                            <tr>
                                                <td>@usage.UsageDate?.ToString("MM/dd/yyyy")</td>
                                                <td>
                                                    <a href="@Url.Action("Details", "PO25", new { id = usage.PO_OrderId })">
                                                        #@usage.PO_OrderId
                                                    </a>
                                                </td>
                                                <td>@usage.Description</td>
                                                <td>$@usage.Amount.ToString("N2")</td>
                                                <td>
                                                    <span class="label @(usage.IsBillable ? "label-success" : "label-info")">
                                                        @(usage.IsBillable ? "Billable" : "Non-Billable")
                                                    </span>
                                                </td>
                                                <td>$@runningTotal.ToString("N2")</td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        }

        <!-- Budget Actions -->
        <div class="row">
            <div class="col-md-12">
                <div class="panel panel-warning">
                    <div class="panel-heading">
                        <h3 class="panel-title"><i class="fa fa-cogs"></i> Budget Actions</h3>
                    </div>
                    <div class="panel-body">
                        <div class="btn-group">
                            <button type="button" class="btn btn-primary" onclick="adjustBudget()">
                                <i class="fa fa-edit"></i> Adjust Budget
                            </button>
                            <button type="button" class="btn btn-info" onclick="exportBudgetReport()">
                                <i class="fa fa-download"></i> Export Report
                            </button>
                            <button type="button" class="btn btn-warning" onclick="resetBudget()">
                                <i class="fa fa-refresh"></i> Reset YTD Spending
                            </button>
                            <button type="button" class="btn btn-success" onclick="projectSpending()">
                                <i class="fa fa-calculator"></i> Spending Projection
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }
    else
    {
        <div class="row">
            <div class="col-md-12">
                <div class="alert alert-danger">
                    <i class="fa fa-exclamation-triangle"></i> Budget information not found.
                </div>
            </div>
        </div>
    }
</div>

<!-- Adjust Budget Modal -->
<div class="modal fade" id="adjustBudgetModal" tabindex="-1" role="dialog">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            @using (Html.BeginForm("UpdateBudget", "PO25Admin", FormMethod.Post))
            {
                @Html.AntiForgeryToken()
                <div class="modal-header">
                    <button type="button" class="close" data-dismiss="modal">&times;</button>
                    <h4 class="modal-title">Adjust Budget</h4>
                </div>
                <div class="modal-body">
                    <input type="hidden" name="departmentId" value="@Model.Budget?.DepartmentId" />
                    <div class="form-group">
                        <label>Department</label>
                        <input type="text" class="form-control" value="@Model.Budget?.DepartmentName" readonly />
                    </div>
                    <div class="form-group">
                        <label>Current Annual Budget</label>
                        <input type="text" class="form-control" value="$@Model.Budget?.AnnualBudget.ToString(" N0")" readonly />
                    </div>
                    <div class="form-group">
                        <label for="newBudget">New Annual Budget</label>
                        <div class="input-group">
                            <span class="input-group-addon">$</span>
                            <input type="number" id="newBudget" name="budget" class="form-control"
                                   min="0" step="0.01" value="@Model.Budget?.AnnualBudget" required />
                        </div>
                    </div>
                    <div class="checkbox">
                        <label>
                            <input type="checkbox" name="allowOverages" value="true" />
                            Allow Budget Overages
                        </label>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-default" data-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary">Update Budget</button>
                </div>
            }
        </div>
    </div>
</div>

<script src="https://cdnjs.cloudflare.com/ajax/libs/Chart.js/2.9.4/Chart.min.js"></script>
<script>
$(document).ready(function() {
    // Initialize DataTable
    if ($.fn.DataTable) {
        $('#usageTable').DataTable({
            "order": [[ 0, "desc" ]], // Sort by date descending
            "pageLength": 25
        });
    }

    // Initialize monthly spending chart
    @if (Model.MonthlySpending != null && Model.MonthlySpending.Any())
    {
        <text>
        var ctx = document.getElementById('monthlySpendingChart').getContext('2d');
        var chart = new Chart(ctx, {
            type: 'line',
            data: {
                labels: [@Html.Raw(string.Join(",", Model.MonthlySpending.Select(m => "'" + new DateTime(m.Year, m.Month, 1).ToString("MMM yyyy") + "'")))],
                datasets: [{
                    label: 'Monthly Spending',
                    data: [@Html.Raw(string.Join(",", Model.MonthlySpending.Select(m => m.Amount.ToString())))],
                    borderColor: 'rgb(75, 192, 192)',
                    backgroundColor: 'rgba(75, 192, 192, 0.2)',
                    tension: 0.1
                }]
            },
            options: {
                responsive: true,
                scales: {
                    y: {
                        beginAtZero: true,
                        ticks: {
                            callback: function(value, index, values) {
                                return '$' + value.toLocaleString();
                            }
                        }
                    }
                },
                plugins: {
                    tooltip: {
                        callbacks: {
                            label: function(context) {
                                return 'Spending: $' + context.parsed.y.toLocaleString();
                            }
                        }
                    }
                }
            }
        });
        </text>
    }
});

function adjustBudget() {
    $('#adjustBudgetModal').modal('show');
}

function exportBudgetReport() {
    var url = '@Url.Action("ExportBudgetReport", "PO25Admin", new { id = Model.Budget?.DepartmentId })';
    window.open(url, '_blank');
}

function resetBudget() {
    if (confirm('Are you sure you want to reset the year-to-date spending for this department? This action cannot be undone.')) {
        var url = '@Url.Action("ResetBudgetSpending", "PO25Admin", new { id = Model.Budget?.DepartmentId })';
        window.location.href = url;
    }
}

function projectSpending() {
    // Calculate projection based on current spending rate
    var currentMonth = new Date().getMonth() + 1;
    var monthsRemaining = 12 - currentMonth;
    var currentSpending = @(Model.Budget?.YtdSpent ?? 0);
    var monthlyAverage = currentSpending / currentMonth;
    var projectedTotal = currentSpending + (monthlyAverage * monthsRemaining);
    var projectedOverage = projectedTotal - @(Model.Budget?.AnnualBudget ?? 0);

    var message = 'Spending Projection:\n\n';
    message += 'Current YTD Spending: $' + currentSpending.toLocaleString() + '\n';
    message += 'Monthly Average: $' + monthlyAverage.toLocaleString() + '\n';
    message += 'Projected Year-End Total: $' + projectedTotal.toLocaleString() + '\n';

    if (projectedOverage > 0) {
        message += '\nProjected Budget Overage: $' + projectedOverage.toLocaleString();
    } else {
        message += '\nProjected Budget Remaining: $' + Math.abs(projectedOverage).toLocaleString();
    }

    alert(message);
}
</script>

<style>
    .progress {
        height: 25px;
    }

    .table th {
        background-color: #f5f5f5;
    }

    #monthlySpendingChart {
        max-height: 400px;
    }
</style>