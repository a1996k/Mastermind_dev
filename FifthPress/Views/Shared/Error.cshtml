@{
    Layout = null;
    var errorType = ViewBag.ErrorType as string ?? "Error";
    var errorMessage = ViewBag.ErrorMessage as string ?? "An unexpected error occurred while processing your request.";
    var errorRefId = ViewBag.ErrorReferenceId as string;
}

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@errorType - Mastermind</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <style>
        body {
            background: linear-gradient(135deg, #74b9ff 0%, #0984e3 100%);
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        }
        .error-container {
            background: white;
            border-radius: 16px;
            box-shadow: 0 20px 60px rgba(0,0,0,0.3);
            padding: 3rem;
            max-width: 600px;
            width: 90%;
            text-align: center;
        }
        .error-icon {
            font-size: 5rem;
            color: #0984e3;
            margin-bottom: 1rem;
        }
        .error-title {
            color: #333;
            font-weight: 600;
            margin-bottom: 1rem;
        }
        .error-message {
            color: #666;
            margin-bottom: 2rem;
            line-height: 1.6;
        }
        .error-ref-box {
            background: #f8f9fa;
            border: 1px solid #dee2e6;
            border-radius: 8px;
            padding: 1rem;
            margin-bottom: 2rem;
        }
        .error-ref-label {
            font-size: 0.85rem;
            color: #6c757d;
            margin-bottom: 0.5rem;
        }
        .error-ref-id {
            font-family: 'Consolas', 'Monaco', monospace;
            font-size: 1.1rem;
            font-weight: 600;
            color: #495057;
            user-select: all;
            cursor: pointer;
        }
        .btn-home {
            background: linear-gradient(135deg, #74b9ff 0%, #0984e3 100%);
            border: none;
            padding: 0.75rem 2rem;
            font-weight: 500;
            border-radius: 8px;
            color: white;
            text-decoration: none;
            display: inline-block;
            transition: transform 0.2s, box-shadow 0.2s;
        }
        .btn-home:hover {
            transform: translateY(-2px);
            box-shadow: 0 5px 20px rgba(9,132,227,0.4);
            color: white;
        }
        .help-text {
            font-size: 0.85rem;
            color: #6c757d;
            margin-top: 1.5rem;
        }
    </style>
</head>
<body>
    <div class="error-container">
        <div class="error-icon">&#128269;</div>
        <h1 class="error-title">@errorType</h1>
        <p class="error-message">@errorMessage</p>

        @if (!string.IsNullOrEmpty(errorRefId))
        {
            <div class="error-ref-box">
                <div class="error-ref-label">Error Reference ID</div>
                <div class="error-ref-id">@errorRefId</div>
            </div>
        }

        <a href="~/" class="btn btn-home">Return to Home</a>

        <p class="help-text">
            Use your browser's back button or return to the home page.
        </p>
    </div>
</body>
</html>
