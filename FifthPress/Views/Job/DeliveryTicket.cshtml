@using FifthPress.Models.ViewModels;
@model VM_DeliveryTicket

@Styles.Render("~/Content/deliveryticket")

<style>

    .ticket-wrapper {
        font-family: poppins;
        padding: 80px 20px 0 20px;
    }

    .vert-text {
        transform: rotate(90deg);
        display: flex;
        justify-content: end;
        align-items: center;
        font-weight: bold;
        right: 0;
        white-space: nowrap;
        height: 100%;
        font-size: 24px !important;
        padding-right: 15px;
    }

    .header-row {
        background: #dcdcdc;
        -webkit-print-color-adjust: exact;
        font-weight: 700;
    }

    .na {
        font-style: italic;
    }

        .na:after {
            content: 'n/a';
        }

    .body-content {
        padding-top: 0px !important;
    }

    @@media print {

        .ticket-wrapper {
            padding: 0 20px !important;
        }

        .body-content, .ticket-wrapper {
            background: white;
        }

        .header-row .col, .header-row .col-4 {
            border: 1px solid #fff;
            padding: 5px;
        }
    }
</style>
<div class="ticket-wrapper pt-5">

    <!-- Header -->
    <div class="row">
        <div class="col-3">
            <h4>@DateTime.Now.ToString("M/d/yyyy hh:mm tt")</h4>
        </div>
        <div class="col-6 text-center">
            @if (Model.Job.BlindShipping.Value == false)
            {
                <!-- Show FifthColor if we are not blind shipping -->
                <h4>FifthColor</h4>
            }
            <h4>@Html.DisplayFor(model => model.Job.Description)</h4>
            <h5>@DateTime.Now.ToString("M/d/yyyy")</h5>
        </div>
        <div class="col-3">
            <div class="fs-1 text-end vert-text">@Html.DisplayFor(model => model.Job.JobNumber)</div>
        </div>
    </div>

    @if (Model.Job.BlindShipping.HasValue && Model.Job.BlindShipping.Value && Model.Job.BlindShippingPivotTable != null)
    {
        <!-- Blind Shipping Info -->
        <div class="header-wrapper mb-2">
            <div class="row header-row fs-4 mt-5">
                <div class="col-4">
                    Shipping From
                </div>
                <div class="col-4 text-center">
                    Date / P.O. Number
                </div>
                <div class="col-4">
                    Shipping To
                </div>
            </div>
        </div>
        <div class="row fs-5">
            <div class="col-4">
                <div class="field-binder-col-flex">
                    <div>@Html.DisplayFor(model => model.Job.BlindShippingPivotTable.FromCompany)</div>
                    <div>@Html.DisplayFor(model => model.Job.BlindShippingPivotTable.FromAddress)</div>
                    <div>@Html.DisplayFor(model => model.Job.BlindShippingPivotTable.FromCity), @Html.DisplayFor(model => model.Job.BlindShippingPivotTable.FromState) @Html.DisplayFor(model => model.Job.BlindShippingPivotTable.FromZip)</div>
                </div>
            </div>
            <div class="col-4 text-center">
                <div class="field-binder-col-flex">
                    <div>@DateTime.Now.ToString("M/d/yyyy")</div>
                    <div class="mt-3">P.O.: @ViewBag.BlindShippingPO</div>
                </div>
            </div>
            <div class="col-4">
                <div class="field-binder-col-flex">
                    <div>@Html.DisplayFor(model => model.Job.BlindShippingPivotTable.ShipCompany)</div>
                    <div>Attn: @Html.DisplayFor(model => model.Job.BlindShippingPivotTable.ShipAttention)</div>
                    <div>@Html.DisplayFor(model => model.Job.BlindShippingPivotTable.ShipAddress)</div>
                    <div>@Html.DisplayFor(model => model.Job.BlindShippingPivotTable.ShipCity), @Html.DisplayFor(model => model.Job.BlindShippingPivotTable.ShipState) @Html.DisplayFor(model => model.Job.BlindShippingPivotTable.ShipZip)</div>
                    <div>@Html.DisplayFor(model => model.Job.BlindShippingPivotTable.ShipPhoneNumber)</div>
                </div>
            </div>
        </div>
    }
    else
    {
        <!-- Client info -->
        <div class="header-wrapper mb-2">
            <div class="row header-row fs-4 mt-5">
                <div class="col-4">
                    Bill To
                </div>
                <div class="col-4">
                    Ordered By
                </div>
                <div class="col-4">
                    Ship To
                </div>
            </div>
        </div>
        <div class="row fs-5">
            <div class="col-4">
                <div class="field-binder-col-flex">
                    <div>@Html.DisplayFor(model => model.Job.Client1.Title)</div>
                    <div>@Html.DisplayFor(model => model.Job.Client1.Address)</div>
                    <div>@Html.DisplayFor(model => model.Job.Client1.AddressAlt)</div>
                    <div>@Html.DisplayFor(model => model.Job.Contact1.Phone)</div>
                    <div>@Html.DisplayFor(model => model.Job.Client1.City) @Html.DisplayFor(model => model.Job.Client1.USState.Abbreviation) @Html.DisplayFor(model => model.Job.Client1.Zip)</div>
                    <div class="pt-5">
                        <div>@Html.DisplayFor(model => model.Job.Client1.Notes)</div>
                        <div>@Html.DisplayFor(model => model.Job.Contact1.ContactNote)</div>
                    </div>
                </div>
            </div>
            <div class="col-4">
                <div class="field-binder-col-flex">
                    @Html.DisplayFor(model => model.Job.Contact1.First)&nbsp;@Html.DisplayFor(model => model.Job.Contact1.Last)
                    @Html.DisplayFor(model => model.Job.Contact1.Email)
                    @Html.DisplayFor(model => model.Job.Contact1.Phone)
                    @Html.DisplayFor(model => model.Job.Contact1.Phone2)
                    P.O.: @Html.DisplayFor(model => model.Job.PurchaseOrderNumber)
                </div>
            </div>
            <div class="col-4">
                <div class="field-binder-col-flex">
                    <div>@Html.DisplayFor(model => model.Job.ShippingAddress1.Attention)</div>
                    <div>@Html.DisplayFor(model => model.Job.ShippingAddress1.CustomerName)</div>
                    <div>@Html.DisplayFor(model => model.Job.ShippingAddress1.Address)</div>
                    <div>@Html.DisplayFor(model => model.Job.ShippingAddress1.Phone)</div>
                    <div>@Html.DisplayFor(model => model.Job.ShippingAddress1.City) @Html.DisplayFor(model => model.Job.ShippingAddress1.USState.Abbreviation) @Html.DisplayFor(model => model.Job.ShippingAddress1.Zip)</div>
                </div>
            </div>
        </div>
    }
    <div class="row header-row fw-bold fs-5 mt-5 mb-2">
        <div class="col">
            <span>Acct. No.</span>
        </div>
        <div class="col">
            <span>Ordered By</span>
        </div>
        <div class="col">
            <span>Phone</span>
        </div>
        <div class="col">
            <span>P.O. No.</span>
        </div>
        <div class="col">
            <span>CSR</span>
        </div>
        <div class="col">
            <span>Sales Rep</span>
        </div>
    </div>
    <div class="row fs-5">
        <div class="col">
            @Html.DisplayFor(model => model.Job.Client1.Id)
        </div>
        <div class="col">
            @Html.DisplayFor(model => model.Job.Contact1.First) @Html.DisplayFor(model => model.Job.Contact1.Last)
        </div>
        <div class="col">
            @Html.DisplayFor(model => model.Job.Contact1.Phone)
        </div>
        <div class="col">
            @Html.DisplayFor(model => model.Job.PurchaseOrderNumber)
        </div>
        <div class="col">
            @if (Model.Job.CreatedBy.HasValue)
            {
                string cbDisplay = String.Format("{0} {1}", (Model.Job.User.FirstName ?? ""), (Model.Job.User.LastName ?? ""));
                @Html.DisplayFor(model => cbDisplay);
            }
        </div>
        <div class="col">
            <!-- Sales Rep -->
        </div>
    </div>
    <div class="row header-row fw-bold fs-5 mt-3 mb-2">
        <div class="col-3 col">
            <span>Quantity</span>
        </div>
        <div class="col-9 col">
            <span>Description</span>
        </div>
    </div>

    @foreach (JobItem ji in Model.Job.JobItems.ToList())
    {
        <div class="row fs-4 delivery-ticket-row">
            <div class="col-3 col">
                @Html.DisplayFor(model => ji.Quantity)
            </div>
            <div class="col-9 col">
                @Html.DisplayFor(model => ji.Description)
            </div>
        </div>
    }

    <div class="signature-line row justify-content-end" style="margin-top: 100px">
        <div class="col-9">
            <p class="fs-4">
                Received By:
                <span class="signature-line-line"></span>
            </p>
        </div>
        <div class="col-3">
            <p class="fs-4">
                Date:
                <span class="signature-line-line"></span>
            </p>
        </div>
    </div>
</div>