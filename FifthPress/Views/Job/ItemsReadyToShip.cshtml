@model List<ItemsReadyToShip_Result>

@Styles.Render("~/Content/joblistcss")

<div class="container fs-3">
    <h1>Jobs Ready to Ship</h1>
    <div class="row pt-3">
        <label for="user_toggle_checkbox">Only Show My Jobs <input type="checkbox" id="user_toggle_checkbox" /></label>
    </div>
    <div class="row pt-3">
        <div class="col-12">
            <button type="button" class="btn btn-sm btn-fc-info create-shipment-btn ff-poppins fs-15">New Shipment</button>
            <div class="ship-build-buttons" style="display:none">
                <button type="button" class="btn btn-sm btn-success to-details-btn ff-poppins fs-15" data-modal-to-open="#notesModal" disabled>Submit Shipment</button>
                <button type="button" class="btn btn-sm btn-fc-danger cancel-shipment-btn ff-poppins fs-15">Cancel Shipment</button>
            </div>
        </div>
    </div>
    <table id="rts_table" class="fs-3">
        <thead>
            <tr>
                <th>Select</th>
                <th>Job Number</th>
                <th>PO #</th>
                <th>Client</th>
                <th>Description</th>
                <th>Due Date</th>
                <th>Completed</th>
                <th>Project Manager</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var x in Model)
            {
                <tr class="job-item-row" data-record-id="@Html.DisplayFor(model => x.JobItemId)" data-pm-id="@Html.DisplayFor(model => x.ProjectManager)">
                    <td><input type="checkbox" /></td>
                    <td>@Html.DisplayFor(model => x.JobNumber)</td>
                    <td>@Html.DisplayFor(model => x.PurchaseOrderNumber)</td>
                    <td>@Html.DisplayFor(model => x.ClientName)</td>
                    <td>@Html.DisplayFor(model => x.ItemDescription)</td>
                    <td>@(x.DueDate.HasValue ? x.DueDate.Value.ToString("M/d/yyyy") : "")</td>
                    <td>@(x.CompletedAt.HasValue ? x.CompletedAt.Value.ToString("M/d/yyyy") : "")</td>
                    <td>@Html.DisplayFor(model => x.ProjectManagerName)</td>
                </tr>
            }
        </tbody>
    </table>
</div>

