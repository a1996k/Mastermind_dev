@* Modal *@
<div class="modal fade" id="notesModal" tabindex="-1" aria-labelledby="notesModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="notesModalLabel">Shipment Details</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <!-- Job Details List -->
                <ul id="jobDetailsList" class="list-group mb-3">
                    <!-- Job items will be dynamically inserted here -->
                </ul>

                <div class="mb-3">
                    <label for="noteTitle" class="form-label">Title</label>
                    <input type="text" class="form-control" id="noteTitle" placeholder="Enter title">
                </div>
                <div class="mb-3">
                    <label for="noteContent" class="form-label">Notes</label>
                    <textarea class="form-control" id="noteContent" rows="4" placeholder="Enter your notes"></textarea>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                <button type="button" class="btn btn-primary validate-details-btn">Save</button>
            </div>
        </div>
    </div>
</div>

@Scripts.Render("~/bundles/jobshipments")