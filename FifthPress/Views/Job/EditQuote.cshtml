<script src="~/Scripts/ClientCostSplits.js"></script>

<!-- Import Items Modal -->
<div class="modal fade" id="importItemsModal" tabindex="-1" aria-labelledby="importItemsModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-xl">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="importItemsModalLabel">Import Items from Job/Quote</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div id="import-step-1">
                    <div class="mb-3">
                        <label for="sourceJobNumber" class="form-label">Job or Quote Number</label>
                        <div class="input-group">
                            <input type="text" class="form-control" id="sourceJobNumber" placeholder="Enter job or quote number">
                            <button class="btn btn-primary" type="button" id="searchItemsBtn">Search</button>
                        </div>
                    </div>
                    <div id="searchStatus" class="mt-2"></div>
                </div>
                <div id="import-step-2" style="display: none;">
                    <div class="row mb-3">
                        <div class="col-md-6">
                            <h6>Source: <span id="sourceRecordInfo"></span></h6>
                        </div>
                        <div class="col-md-6 text-end">
                            <button type="button" class="btn btn-sm btn-outline-primary" id="selectAllItemsBtn">Select All</button>
                            <button type="button" class="btn btn-sm btn-outline-secondary" id="deselectAllItemsBtn">Deselect All</button>
                        </div>
                    </div>
                    <div class="table-responsive" style="max-height: 400px; overflow-y: auto;">
                        <table class="table table-sm">
                            <thead class="sticky-top bg-light">
                                <tr>
                                    <th width="5%">
                                        <input type="checkbox" id="selectAllCheckbox">
                                    </th>
                                    <th width="25%">Title</th>
                                    <th width="30%">Description</th>
                                    <th width="10%">Qty</th>
                                    <th width="15%">Material</th>
                                    <th width="10%">Cost</th>
                                    <th width="5%">Type</th>
                                </tr>
                            </thead>
                            <tbody id="itemsTableBody">
                            </tbody>
                        </table>
                    </div>
                    <div class="mt-3">
                        <div class="alert alert-info">
                            <small>Selected items will be copied to this quote. Original items will remain unchanged.</small>
                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-primary" id="importSelectedBtn" style="display: none;">Import Selected Items</button>
            </div>
        </div>
    </div>
</div>

<script>
    $(function () {
        $('#client_autocomplete').trigger('change');

        UpdateMarkupPercentage('@Html.DisplayFor(model => model.VM_Quote.Quote.MarkupOverrideAsPercent)');

        // Initialize Client Cost Splits
        ClientCostSplits.init({
            entityId: @(Model.VM_Quote.Quote.Id),
            entityType: 'Quote',
            baseClientId: @(Model.VM_Quote.Quote.Client ?? 0),
            baseClientName: '@Html.Raw(Model.VM_Quote.Quote.Client1?.Title?.Replace("'", "\\'") ?? "")',
            totalAmount: @(Model.ItemTotals?.Total ?? 0)
        });

        PositionPricingWrapper();
        $(window).on('resize', PositionPricingWrapper);
    });

    // Import Items functionality
    let availableItems = [];
    const targetQuoteId = @Html.Raw(Json.Encode(Model.VM_Quote.Quote.Id));

    $('#searchItemsBtn').click(function() {
        const jobNumber = $('#sourceJobNumber').val().trim();
        if (!jobNumber) {
            $('#searchStatus').html('<div class="alert alert-warning">Please enter a job or quote number</div>');
            return;
        }

        $('#searchStatus').html('<div class="alert alert-info">Searching...</div>');
        
        $.ajax({
            url: ProcessUrl('Job/GetJobQuoteItems'),
            type: 'GET',
            data: { jobNumber: jobNumber },
            success: function(response) {
                if (response.success) {
                    availableItems = response.items;
                    displayItems(response);
                    $('#import-step-1').hide();
                    $('#import-step-2').show();
                    $('#importSelectedBtn').show();
                } else {
                    $('#searchStatus').html('<div class="alert alert-danger">' + response.message + '</div>');
                }
            },
            error: function() {
                $('#searchStatus').html('<div class="alert alert-danger">Error searching for items</div>');
            }
        });
    });

    function displayItems(response) {
        $('#sourceRecordInfo').text(response.recordType + ' #' + response.recordNumber);
        const tbody = $('#itemsTableBody');
        tbody.empty();

        response.items.forEach(function(item, index) {
            const row = `
                <tr>
                    <td><input type="checkbox" class="item-checkbox" data-item-id="${item.Id}" data-item-type="${item.Type}"></td>
                    <td>${item.Title || ''}</td>
                    <td>${item.Description || ''}</td>
                    <td>${item.Quantity || ''}</td>
                    <td>${item.MaterialName || ''}</td>
                    <td>$${(item.MaterialCost || 0).toFixed(2)}</td>
                    <td><span class="badge bg-primary">${item.Type}</span></td>
                </tr>
            `;
            tbody.append(row);
        });
    }

    $('#selectAllCheckbox').change(function() {
        $('.item-checkbox').prop('checked', this.checked);
    });

    $('#selectAllItemsBtn').click(function() {
        $('.item-checkbox').prop('checked', true);
        $('#selectAllCheckbox').prop('checked', true);
    });

    $('#deselectAllItemsBtn').click(function() {
        $('.item-checkbox').prop('checked', false);
        $('#selectAllCheckbox').prop('checked', false);
    });

    $('#importSelectedBtn').click(function() {
        const selectedItems = [];
        $('.item-checkbox:checked').each(function() {
            selectedItems.push({
                id: parseInt($(this).data('item-id')),
                type: $(this).data('item-type')
            });
        });

        if (selectedItems.length === 0) {
            alert('Please select at least one item to import');
            return;
        }

        // Show loading state
        $('#importSelectedBtn').prop('disabled', true).text('Importing...');

        const itemIds = selectedItems.map(item => item.id);
        const sourceTypes = [...new Set(selectedItems.map(item => item.type))];
        
        // Process each source type separately
        let importPromises = [];
        sourceTypes.forEach(sourceType => {
            const itemsOfType = selectedItems.filter(item => item.type === sourceType).map(item => item.id);
            
            importPromises.push(
                $.ajax({
                    url: ProcessUrl('Job/ImportSelectedItems'),
                    type: 'POST',
                    data: {
                        targetId: targetQuoteId,
                        targetType: 'Quote',
                        selectedItemIds: itemsOfType,
                        sourceType: sourceType,
                        copyTimingRecords: false
                    }
                })
            );
        });

        Promise.all(importPromises).then(function(responses) {
            let totalImported = 0;
            let hasErrors = false;
            
            responses.forEach(response => {
                if (response.success) {
                    const match = response.message.match(/(\d+)/);
                    if (match) totalImported += parseInt(match[1]);
                } else {
                    hasErrors = true;
                    console.error('Import error:', response.message);
                }
            });
            
            if (hasErrors) {
                alert('Some items could not be imported. Check console for details.');
                $('#importSelectedBtn').prop('disabled', false).text('Import Selected Items');
            } else {
                alert(`Successfully imported ${totalImported} item(s).`);
                $('#importItemsModal').modal('hide');
                
                // Reload the items section using the same pattern as reorder items
                reloadQuoteItems();
            }
            
        }).catch(function(xhr, status, error) {
            console.error('Import failed:', error);
            alert('Error importing items: ' + error);
            $('#importSelectedBtn').prop('disabled', false).text('Import Selected Items');
        });
    });

    function reloadQuoteItems() {
        $('#job_items').fadeOut('fast', function () {
            $.ajax({
                type: 'GET',
                url: ProcessUrl('Job/RefreshQuoteItems'),
                data: { quoteId: targetQuoteId },
                success: function (response) {
                    $('#job_items').html(response.Data || response);
                    $('#job_items').fadeIn('fast');
                },
                error: function (err) {
                    console.error('Failed to reload items:', err);
                    $('#job_items').html('<div class="alert alert-danger">Failed to reload items. Please refresh the page.</div>');
                    $('#job_items').fadeIn('fast');
                }
            });
        });
    }

    // Reset modal when closed
    $('#importItemsModal').on('hidden.bs.modal', function() {
        $('#import-step-1').show();
        $('#import-step-2').hide();
        $('#importSelectedBtn').hide().prop('disabled', false).text('Import Selected Items');
        $('#sourceJobNumber').val('');
        $('#searchStatus').empty();
        $('#itemsTableBody').empty();
        $('#selectAllCheckbox').prop('checked', false);
        availableItems = [];
    });
</script>