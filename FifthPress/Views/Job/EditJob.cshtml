<div class="edit-wrapper container-fluid">
    <div class="edit-job-wrapper">
        <div class="d-flex align-items-center mb-2 edit-job-w">
            <h3 class="mb-0">Edit Job #@Html.DisplayFor(model => model.VM_Job.Job.JobNumber)</h3>

            @if (Model.VM_Job.Job.IsReprint && Model.VM_Job.Job.OriginalJobId.HasValue)
            {
                var db = new FifthPress.FifthPressEntities();
                var originalJob = db.Jobs.Find(Model.VM_Job.Job.OriginalJobId.Value);
                var reprintRecord = db.Reprint_Jobs.FirstOrDefault(r => r.ReprintJobId == Model.VM_Job.Job.Id);
                if (originalJob != null)
                {
                    <div class="alert alert-info ms-3 mb-0" style="display: inline-block; padding: 8px 15px; font-size: 18px !important; background-color: #17a2b8; color: #ffffff; border-color: #17a2b8;">
                        <i class="fa fa-info-circle"></i>
                        <span class="fs-18">This is a reprint of Job #@originalJob.JobNumber</span>
                        <a href="@Url.Action("EditJob", "Job", new { jobId = Model.VM_Job.Job.OriginalJobId.Value })" class="btn btn-sm btn-primary ms-2 fs-16">
                            <i class="fa fa-external-link"></i> View Original Job
                        </a>
                        @if (reprintRecord != null)
                        {
                            <span class="ms-3 fs-16">Reason:
                                <span class="reprint-reason-text" data-reprint-id="@reprintRecord.ReprintId">@(string.IsNullOrWhiteSpace(reprintRecord.ReprintReasonText) ? "—" : reprintRecord.ReprintReasonText)</span>
                            </span>
                            <button type="button" class="btn btn-sm btn-light ms-2 fs-16 edit-reprint-reason" data-reprint-id="@reprintRecord.ReprintId" title="Edit reprint reason">
                                <i class="fa fa-pencil"></i> Edit Reason
                            </button>
                        }
                    </div>
                }
            }

            @if (Model.VM_Job.Job.IsReprint)
            {
                <!-- Edit Reprint Reason Modal (Bootstrap 5) -->
                <div class="modal fade" id="editReprintReasonModal" tabindex="-1" aria-hidden="true">
                    <div class="modal-dialog">
                        <div class="modal-content">
                            <div class="modal-header">
                                <h5 class="modal-title"><i class="fa fa-pencil"></i> Edit Reprint Reason</h5>
                                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                            </div>
                            <div class="modal-body">
                                <div class="mb-3">
                                    <label for="editReprintReasonSelect" class="form-label">Reprint Reason</label>
                                    <select id="editReprintReasonSelect" class="form-select">
                                        <option value="">Loading reasons...</option>
                                    </select>
                                </div>
                                <div id="editReprintReasonError" class="text-danger" style="display:none;"></div>
                            </div>
                            <div class="modal-footer">
                                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                                <button type="button" id="saveReprintReasonBtn" class="btn btn-primary">Save Reason</button>
                            </div>
                        </div>
                    </div>
                </div>

                <script>
                    (function () {
                        var modalEl = document.getElementById('editReprintReasonModal');
                        if (!modalEl || typeof bootstrap === 'undefined') { return; }
                        // Move the modal to be a direct child of <body> so Bootstrap's backdrop
                        // doesn't render on top of it (the banner has a stacking context).
                        document.body.appendChild(modalEl);
                        var bsModal = bootstrap.Modal.getOrCreateInstance(modalEl);
                        var $select = $('#editReprintReasonSelect');
                        var $error = $('#editReprintReasonError');
                        var reasonsLoaded = false;
                        var activeReprintId = null;

                        function loadReasons() {
                            if (reasonsLoaded) { return $.Deferred().resolve().promise(); }
                            return $.getJSON('@Url.Action("GetReasons", "Reprint")')
                                .done(function (resp) {
                                    $select.empty();
                                    if (resp && resp.success && resp.categories) {
                                        resp.categories.forEach(function (cat) {
                                            var $group = $('<optgroup>').attr('label', cat.category);
                                            cat.reasons.forEach(function (r) {
                                                $group.append($('<option>').val(r.reasonId).text(r.reasonText));
                                            });
                                            $select.append($group);
                                        });
                                        reasonsLoaded = true;
                                    } else {
                                        $select.html('<option value="">Could not load reasons</option>');
                                    }
                                });
                        }

                        $(document).on('click', '.edit-reprint-reason', function () {
                            activeReprintId = $(this).data('reprint-id');
                            $error.hide().text('');
                            var currentText = $('.reprint-reason-text[data-reprint-id="' + activeReprintId + '"]').text().trim();
                            loadReasons().always(function () {
                                $select.find('option').each(function () {
                                    if ($(this).text().trim() === currentText) { $select.val($(this).val()); }
                                });
                            });
                            bsModal.show();
                        });

                        $('#saveReprintReasonBtn').on('click', function () {
                            var reasonId = $select.val();
                            if (!reasonId) { $error.text('Please select a reason.').show(); return; }

                            var $btn = $(this).prop('disabled', true).text('Saving...');
                            $.post('@Url.Action("UpdateReason", "Reprint")', { reprintId: activeReprintId, reasonId: reasonId })
                                .done(function (resp) {
                                    if (resp && resp.success) {
                                        $('.reprint-reason-text[data-reprint-id="' + activeReprintId + '"]').text(resp.reasonText);
                                        bsModal.hide();
                                    } else {
                                        $error.text((resp && resp.message) || 'Update failed.').show();
                                    }
                                })
                                .fail(function () { $error.text('Server error while updating reason.').show(); })
                                .always(function () { $btn.prop('disabled', false).text('Save Reason'); });
                        });
                    })();
                </script>
            }

            @if (Model.VM_Job.Job.Cancelled.HasValue)
            {
                <span class="job-cancelled-text ms-3">JOB CANCELLED</span>
            }
            else
            {
                <button type="button" class="cancel-job-link ms-3" data-record-id="@Html.DisplayFor(model => model.VM_Job.Job.Id)">Cancel Job</button>
            }
        </div>
        <div class="d-flex align-items-center">
        <button type="button" class="btn btn-lg btn-fc-info convert-to-quote-btn me-4 fw-bold">Convert To Quote</button>
        <button type="button" class="btn btn-lg btn-fc-info gt-time-tracking-btn me-4 fw-bold">Time Tracking</button>
        <button type="button" class="btn btn-lg btn-fc-info view-job-ticket-btn me-4 fw-bold">View Ticket</button>
        <button type="button" class="btn btn-lg btn-fc-info view-delivery-ticket-btn me-4 fw-bold">Delivery Ticket</button>
        <button type="button" class="btn btn-lg btn-fc-info view-cost-sheet-btn me-4 fw-bold">Cost Sheet</button>
        <button type="button" class="btn btn-lg btn-fc-info view-invoice-btn me-4 fw-bold">Invoice</button>
        <button type="button" class="btn btn-lg btn-fc-secondary import-items-btn me-4 fw-bold" data-bs-toggle="modal" data-bs-target="#importItemsModal"><i class="fa-solid fa-download"></i>Import Items</button>
        <button type="button" class="btn btn-lg btn-success save-record">Save <i class="fa-solid fa-check ms-2"></i></button>
            <!-- Put other action buttons for job here -->
        </div>
    </div>
    <div class="container-fluid">
