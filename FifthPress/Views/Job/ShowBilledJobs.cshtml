@model List<Job>

<style>
    .f-target h3 {
        font-family: Poppins;
        font-size: 16px;
        font-weight: bold;
    }

    .f-target table th {
        font-family: Poppins;
        font-size: 12px;
    }

    .f-target table td {
        font-family: 'DM Sans';
        font-size: 12px;
    }

    .os-edit-row > div {
        padding: 5px;
    }
</style>

<input type="hidden" id="currentJobId" />

<div class="container f-target">
    <div class="row">
        <div class="col-12 billed-jobs">
            <h3>Billed Jobs</h3>
            <table class="table table-bordered table-striped" id="billingHistoryTable">
                <thead>
                    <tr>
                        <th>Job Number</th>
                        <th>PO #</th>
                        <th>Description</th>
                        <th>Customer</th>
                        <th>Project Manager</th>
                        <th>Billed Date</th>
                        <th><!-- View invoice btn --></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var job in Model)
                    {
                        <tr data-record-id="@Html.DisplayFor(model => job.Id)">
                            <td>@Html.DisplayFor(model => job.JobNumber)</td>
                            <td>@Html.DisplayFor(model => job.PurchaseOrderNumber)</td>
                            <td>@Html.DisplayFor(model => job.Description)</td>
                            <td>@Html.DisplayFor(model => job.Client1.Title)</td>
                            <td>@Html.DisplayFor(model => job.User.FirstName) @Html.DisplayFor(model => job.User.LastName)</td>
                            <td>@job.Billed.Value.ToLongDateString()</td>
                            <td>
                                <button type="button" class="btn btn-sm btn-warning view-invoice fs-12">
                                    View Invoice
                                </button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@Html.Partial("~/Views/Partials/_EditShippedOrdersModal.cshtml", false)

<script>

    let billedJobsDataTable;
    let currentJobIdContext;

