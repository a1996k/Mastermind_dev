@using FifthPress.Models.ViewModels;
@model VM_DeliveryTicket2

@Styles.Render("~/Content/deliveryticket")

<div class="d-flex edit-job-wrapper justify-content-between align-items-center">
    <div class="back-arrow-group" data-record-id="@Html.DisplayFor(model => model.Job.Id)">
        <i class="fa-solid fa-arrow-left"></i>
        <span class="ps-4 fw-bold">Back</span>
    </div>
    <div class="save-print-links field-binder-row-flex">
        <div class="print-link field-binder-row-flex">
            <i class="fa-solid fa-print"></i>
            <button type="button" class="btn btn-lg btn-fc-info print-delivery-ticket">Print Delivery Ticket</button>
        </div>
    </div>
    <!-- Put other action buttons for job here -->
</div>

<div class="container invoice-wrapper fs-3">

    @if (Model.Job.BlindShipping.HasValue && Model.Job.BlindShipping.Value && Model.Job.BlindShippingPivotTable != null)
    {
        <!-- Blind Shipping Header - Simple -->
        <div class="row border-bottom-target inv-header-row">
            <div class="col-12 pb-3">
                <div class="field-binder-row-flex justify-content-between fs-2">
                    <h3 class="fw-bold">Delivery Ticket #@Html.DisplayFor(model => model.Job.JobNumber)</h3>
                </div>
                <div class="row fs-4 pt-3">
                    <div class="col-4">
                        <div class="field-binder-col-flex">
                            <span class="fw-bold pb-2">Shipping From:</span>
                            <span>@Html.DisplayFor(model => model.Job.BlindShippingPivotTable.FromCompany)</span>
                            <span>@Html.DisplayFor(model => model.Job.BlindShippingPivotTable.FromAddress)</span>
                            <span>@Html.DisplayFor(model => model.Job.BlindShippingPivotTable.FromCity), @Html.DisplayFor(model => model.Job.BlindShippingPivotTable.FromState) @Html.DisplayFor(model => model.Job.BlindShippingPivotTable.FromZip)</span>
                        </div>
                    </div>
                    <div class="col-4 text-center">
                        <div class="field-binder-col-flex">
                            <span class="fw-bold pb-2">Date / P.O. Number:</span>
                            <span>@DateTime.Now.ToString("M/d/yyyy")</span>
                            <span class="mt-2">P.O.: @ViewBag.BlindShippingPO</span>
                        </div>
                    </div>
                    <div class="col-4">
                        <div class="field-binder-col-flex">
                            <span class="fw-bold pb-2">Shipping To:</span>
                            <span>@Html.DisplayFor(model => model.Job.BlindShippingPivotTable.ShipCompany)</span>
                            <span>Attn: @Html.DisplayFor(model => model.Job.BlindShippingPivotTable.ShipAttention)</span>
                            <span>@Html.DisplayFor(model => model.Job.BlindShippingPivotTable.ShipAddress)</span>
                            <span>@Html.DisplayFor(model => model.Job.BlindShippingPivotTable.ShipCity), @Html.DisplayFor(model => model.Job.BlindShippingPivotTable.ShipState) @Html.DisplayFor(model => model.Job.BlindShippingPivotTable.ShipZip)</span>
                            <span>@Html.DisplayFor(model => model.Job.BlindShippingPivotTable.ShipPhoneNumber)</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }
    else
    {
        <!-- Standard Header with Logo and Project Manager -->
        <div class="row border-bottom-target inv-header-row">
            <div class="col-4 fs-4">
                <div class="field-binder-col-flex border-right-target pb-3">
                    <span class="pb-2 fst-italic">
                        <img class="inv-fc-logo" src="~/Content/images/nb-logo.png" />
                    </span><!-- FifthColor Logo here-->
                    <span>@Html.DisplayFor(model => model.SourceInformation.Address)</span>
                    <span>@Html.DisplayFor(model => model.SourceInformation.City), @Html.DisplayFor(model => model.SourceInformation.State) @Html.DisplayFor(model => model.SourceInformation.ZipCode)</span>
                    <span>@Html.DisplayFor(model => model.SourceInformation.Phone)</span>

                    <span class="py-2 fw-bold">@DateTime.Now.ToLongDateString()</span>

                    <span class="pt-2 fw-bold">Project Manager: </span>
                    <span>@Html.DisplayFor(model => model.Job.User.FirstName) @Html.DisplayFor(model => model.Job.User.LastName)</span>
                </div>
            </div>
            <div class="col-8 ps-5 pb-3">
                <div class="field-binder-row-flex justify-content-between fs-2">
                    <h3 class="fw-bold">Delivery Ticket #@Html.DisplayFor(model => model.Job.JobNumber)</h3>
                </div>
                <div class="row fs-4">
                    <div class="col-6">
                        <div class="field-binder-col-flex">
                            <span class="fw-bold">Customer:</span>
                            <span>@Html.DisplayFor(model => model.ClientInformation.ClientName)</span>
                        </div>
                        <div class="field-binder-col-flex">
                            <span class="fw-bold">P.O.:</span>
                            <span>@Html.DisplayFor(model => model.Job.PurchaseOrderNumber)</span>
                        </div>
                    </div>
                    <div class="col-6">
                        <div class="field-binder-col-flex">
                            <span class="fw-bold">Ordered By:</span>
                            <span>@Html.DisplayFor(model => model.ClientInformation.ContactName)</span>
                            <span>@Html.DisplayFor(model => model.ClientInformation.Email)</span>
                            <span>@Html.DisplayFor(model => model.ClientInformation.Phone)</span>
                        </div>
                    </div>
                    <div class="col-12">
                        <div class="field-binder-col-flex">
                            @if (!(Model.Job.IsPickup ?? false))
                            {
                                if (Model.Job.ShippingAddress.HasValue)
                                {

                                    <span class="fw-bold">Ship To:</span>
                                    if (!String.IsNullOrEmpty(Model.ShippingInformation.Attention))
                                    {
                                        <span class="py-1 mb-0">@Html.DisplayFor(model => model.ShippingInformation.Attention)</span>
                                    }
                                    <span class="py-1 mb-0">@Html.DisplayFor(model => model.ShippingInformation.CompanyName)</span>
                                    <span class="py-1 mb-0">@Html.DisplayFor(model => model.ShippingInformation.Address)</span>
                                    if (!String.IsNullOrEmpty(Model.ShippingInformation.Address2))
                                    {
                                        <span class="py-1 mb-0">@Html.DisplayFor(model => model.ShippingInformation.Address2)</span>
                                    }
                                    <span class="py-1 mb-0">@Html.DisplayFor(model => model.ShippingInformation.City), @Html.DisplayFor(model => model.ShippingInformation.State) @Html.DisplayFor(model => model.ShippingInformation.ZipCode)</span>
                                }
                                else
                                {
                                    <span class="fw-bold">Ship To:</span>
                                    <span class="py-1 mb-0 fst-italic" style="font-family:Georgia">No Address Selected</span>
                                }
                            }
                            else
                            {
                                <span class="fw-bold">Pickup At:</span>
                                <span class="mb-0">@Html.DisplayFor(model => model.SourceInformation.Address)</span>
                                <span class="mb-0">@Html.DisplayFor(model => model.SourceInformation.City), @Html.DisplayFor(model => model.SourceInformation.State) @Html.DisplayFor(model => model.SourceInformation.ZipCode)</span>
                            }
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }

    <div class="item-row-wrapper mt-5">
        <div class="row col-header-row">
            <div class="col col-10 fw-bold item-header-row gx-5 p-3">
                Items
            </div>
            <div class="col col-2 fw-bold gx-3 p-3">
                Qty
            </div>
        </div>

        @foreach (FifthPress.Models.ViewModels.VM_InvoiceRow2 r in Model.Items.OrderBy(x => x.Ordinal))
        {
            <div class="row invoice-row pt-3">
                @*NOTE: DisplayFor helpers need to stay in this position (directly following the preserve-formatting div) to ensure that no extra whitespace is outputted before the content*@
                <div class="col-10 item preserve-formatting">
                    @Html.DisplayFor(model => r.Description)
                    @if (!String.IsNullOrEmpty(r.Notes))
                    {
                        <div class="row">
                            <div class="col-12 item-notes ff-dm-sans fs-12 fw-normal preserve-formatting">@Html.DisplayFor(model => r.Notes)</div>
                        </div>
                    }
                </div>
                <div class="col-2 quantity p-3">
                    @Html.DisplayFor(model => r.Quantity)
                </div>
            </div>
        }
    </div>

    <div class="row mt-3">
        <span class="ty-msg">Thank you for the order!</span>
    </div>

    <div class="row mt-5 pt-5 sig-row">
        <div class="sig-portion field-binder-row-flex">
            <label class="fw-bold pe-2">Received By</label>
            <div class="signature-line"></div>
        </div>
        <div class="date-portion field-binder-row-flex">
            <label class="fw-bold pe-2">Date</label>
            <div class="date-line"></div>
        </div>
    </div>
</div>

<script>
    function invBackToJob() {
        let id = $(this).attr('data-record-id');
        window.location = ProcessUrl('Job/Edit') + '/' + id;
    };

    function printDeliveryTicket() {
        window.print();
    };

    $('title').html('@Model.Job.JobNumber Delivery Ticket');

    $(function () {

        setHeaderWidth();
        $(window).on('resize', setHeaderWidth);
    })
        .on('click', '.back-arrow-group', invBackToJob)
        .on('click', '.print-delivery-ticket', printDeliveryTicket);
</script>