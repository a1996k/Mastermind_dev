<div class="metric-menu-wrapper mt-5">
    <i class="fa-solid fa-arrows-rotate fa-3x refresh-dashboard ps-3"></i>
    <div class="metric-wrapper d-flex flex-row flex-wrap justify-content-between">
        @foreach (DashboardCard dc in Model.Cards)
        {
            <div class="@Html.DisplayFor(model => dc.slug) p-3 m-3 ajaxable" data-ajax-id="@Html.DisplayFor(model => dc.AjaxId)">
                <div class="loader" style="display:none"></div>
                <h3 class="text-center">@Html.DisplayFor(model => dc.CardTitle)</h3>

                <div class="card-data-wrapper p-5">
                </div>
            </div>
        }
    </div>
</div>